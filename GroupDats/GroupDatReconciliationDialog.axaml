<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Arkadia.GroupDatReconciliationDialog"
        Title="Preview Group DAT — Manual Reconciliation"
        Width="1040" Height="760" MinWidth="880" MinHeight="600"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        Background="#0F0F14"
        FontFamily="Inter,Segoe UI,sans-serif">

    <Window.Styles>
        <Style Selector="TextBlock.h">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="LetterSpacing" Value="1"/>
            <Setter Property="Foreground" Value="#666677"/>
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="#1A1A24"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto" Margin="20,16,20,14">

        <!-- Row 0: title + non-mutating note -->
        <StackPanel Grid.Row="0" Spacing="2" Margin="0,0,0,10">
            <TextBlock Text="Preview Group DAT" FontSize="15" FontWeight="SemiBold" Foreground="#F0F0F0"/>
            <TextBlock Text="Read-only preview — nothing is imported or modified until execution is enabled in a later phase."
                       FontSize="11" Foreground="#888899"/>
        </StackPanel>

        <!-- Row 1: source + target -->
        <Border Grid.Row="1" Classes="card" Margin="0,0,0,10">
            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button x:Name="PickSourceButton" Content="Select source folder…" Click="OnPickSource"
                            Background="#7B68EE" Foreground="#FFFFFF" Padding="14,6" CornerRadius="6" BorderThickness="0"/>
                    <TextBlock x:Name="SourcePathText" Text="No source selected" VerticalAlignment="Center" Foreground="#AAAACC"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="Target:" VerticalAlignment="Center" Foreground="#AAAACC"/>
                    <ComboBox x:Name="ModeCombo" MinWidth="240" SelectionChanged="OnModeChanged"/>
                </StackPanel>
                <StackPanel x:Name="NewGroupPanel" Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="NewGroupIdField"      Watermark="group id"     Width="150" TextChanged="OnAnyChanged"/>
                    <TextBox x:Name="NewGroupDisplayField" Watermark="display name" Width="180" TextChanged="OnAnyChanged"/>
                    <ComboBox x:Name="NewGroupFamilyCombo" MinWidth="150" SelectionChanged="OnAnyChangedSel"/>
                    <ComboBox x:Name="NewGroupAuthorityCombo" MinWidth="130" SelectionChanged="OnAnyChangedSel"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Row 2: dual pane -->
        <Grid Grid.Row="2" ColumnDefinitions="*,*" >
            <!-- Left: discovered DATs + new-leaf editor -->
            <Border Grid.Column="0" Classes="card" Margin="0,0,6,0">
                <Grid RowDefinitions="Auto,*,Auto">
                    <TextBlock Grid.Row="0" Classes="h" Text="DISCOVERED DATS (AVAILABLE)"/>
                    <ListBox Grid.Row="1" x:Name="DatsList" Margin="0,6,0,6" SelectionChanged="OnDatSelected"/>
                    <StackPanel Grid.Row="2" Spacing="6">
                        <TextBlock Classes="h" Text="NEW-LEAF EDITOR"/>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBox x:Name="DatTokenField" Watermark="DAT token" Width="150" TextChanged="OnDatTokenChanged"/>
                            <ComboBox x:Name="MediaTypeCombo" MinWidth="120"/>
                        </StackPanel>
                        <TextBox x:Name="FinalIdField" Watermark="final leaf id" TextChanged="OnFinalIdChanged"/>
                        <TextBlock x:Name="IdStatusText" FontSize="11" Foreground="#888899"/>
                    </StackPanel>
                </Grid>
            </Border>
            <!-- Right: existing leaves -->
            <Border Grid.Column="1" Classes="card" Margin="6,0,0,0">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Grid.Row="0" Classes="h" Text="EXISTING LEAVES (AVAILABLE)"/>
                    <ListBox Grid.Row="1" x:Name="LeavesList" Margin="0,6,0,0" SelectionChanged="OnLeafSelected"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Row 3: comparison + actions -->
        <Border Grid.Row="3" Classes="card" Margin="0,10,0,10">
            <StackPanel Spacing="8">
                <TextBlock x:Name="ComparisonText" FontFamily="Consolas,monospace" FontSize="11" Foreground="#CCCCDD"
                           Text="Select a DAT (left) and a leaf (right) to compare."/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="AssociateButton" Content="Associate as update" Click="OnAssociate"/>
                    <Button x:Name="NewLeafButton"   Content="Create new leaf"    Click="OnCreateNewLeaf"/>
                    <Button x:Name="AbsentButton"    Content="Mark leaf absent"   Click="OnMarkAbsent"/>
                    <Button x:Name="UndoButton"      Content="Undo decision"      Click="OnUndo"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Row 4: decisions + summary -->
        <Grid Grid.Row="4" ColumnDefinitions="*,*" Height="150" Margin="0,0,0,10">
            <Border Grid.Column="0" Classes="card" Margin="0,0,6,0">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Grid.Row="0" Classes="h" Text="DECISIONS"/>
                    <ListBox Grid.Row="1" x:Name="DecisionsList" Margin="0,6,0,0"/>
                </Grid>
            </Border>
            <Border Grid.Column="1" Classes="card" Margin="6,0,0,0">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Grid.Row="0" Classes="h" Text="VALIDATION"/>
                    <ScrollViewer Grid.Row="1" Margin="0,6,0,0">
                        <TextBlock x:Name="SummaryText" FontSize="11" Foreground="#FFA726" TextWrapping="Wrap"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Row 5: footer -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button x:Name="AbortButton" Content="Abort" Click="OnAbort" Padding="20,8"/>
            <Button x:Name="ContinueButton" Content="Continue" Click="OnContinue" IsEnabled="False"
                    Background="#7B68EE" Foreground="#FFFFFF" Padding="24,8" CornerRadius="6" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
