<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Arkadia"
             x:Class="Arkadia.App"
             RequestedThemeVariant="Dark">

    <Application.Styles>
        <StyleInclude Source="avares://Semi.Avalonia/SemiTheme.axaml"/>
        <Style Selector="TextBox">
            <Setter Property="ContextMenu">
                <Setter.Value>
                    <ContextMenu>
                        <MenuItem Header="Cut"   Command="{x:Static local:TextBoxCommands.Cut}"/>
                        <MenuItem Header="Copy"  Command="{x:Static local:TextBoxCommands.Copy}"/>
                        <MenuItem Header="Paste" Command="{x:Static local:TextBoxCommands.Paste}"/>
                    </ContextMenu>
                </Setter.Value>
            </Setter>
        </Style>

        <Style Selector="Window">
            <Setter Property="Icon">
                <Setter.Value>
                    <WindowIcon>avares://Arkadia/Assets/arkadia.ico</WindowIcon>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Styles>

    <!-- Fallback palette resources — overridden at runtime by active visual theme palette -->
    <Application.Resources>
        <SolidColorBrush x:Key="ArkBackground"    Color="#0F0F14"/>
        <SolidColorBrush x:Key="ArkSurface"       Color="#1A1A24"/>
        <SolidColorBrush x:Key="ArkSurfaceAlt"    Color="#242433"/>
        <SolidColorBrush x:Key="ArkAccent"        Color="#E07040"/>
        <SolidColorBrush x:Key="ArkTextPrimary"   Color="#F0F0F0"/>
        <SolidColorBrush x:Key="ArkTextSecondary" Color="#888899"/>
    </Application.Resources>
</Application>
