<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:data="clr-namespace:Arkadia.Data"
        x:Class="Arkadia.CacheReviewDialog"
        Title="ScreenScraper Cache"
        Width="720"
        Height="480"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#0F0F14"
        FontFamily="Inter,Segoe UI,sans-serif">

    <Window.Styles>
        <Style Selector="Button.primary">
            <Setter Property="Background"   Value="#7B68EE"/>
            <Setter Property="Foreground"   Value="#FFFFFF"/>
            <Setter Property="Padding"      Value="20,8"/>
            <Setter Property="FontSize"     Value="13"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Cursor"       Value="Hand"/>
        </Style>
        <Style Selector="Button.secondary">
            <Setter Property="Background"   Value="#1E1E2C"/>
            <Setter Property="Foreground"   Value="#AAAACC"/>
            <Setter Property="Padding"      Value="20,8"/>
            <Setter Property="FontSize"     Value="13"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Cursor"       Value="Hand"/>
        </Style>
        <Style Selector="Button.search">
            <Setter Property="Background"   Value="#1E1E2C"/>
            <Setter Property="Foreground"   Value="#AAAACC"/>
            <Setter Property="Padding"      Value="12,6"/>
            <Setter Property="FontSize"     Value="12"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Cursor"       Value="Hand"/>
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding"    Value="10,7"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="#1C1C36"/>
        </Style>
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#181826"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ── Header ────────────────────────────────────────────────────────── -->
        <Border Grid.Row="0" Padding="20,16,20,14"
                BorderBrush="#181826" BorderThickness="0,0,0,1">
            <StackPanel Spacing="2">
                <TextBlock Text="SCREENSCRAPER CACHE"
                           FontSize="10" FontWeight="SemiBold" LetterSpacing="1.4"
                           Foreground="#7B68EE"/>
                <TextBlock Text="Offline cache provider — no network required"
                           FontSize="12" Foreground="#666677"/>
            </StackPanel>
        </Border>

        <!-- ── Body ──────────────────────────────────────────────────────────── -->
        <Grid Grid.Row="1" ColumnDefinitions="280,*">

            <!-- Left: search + candidate list -->
            <Border Grid.Column="0"
                    BorderBrush="#181826" BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,*">

                    <!-- Search bar -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,8,Auto" Margin="12,12,12,8">
                        <TextBox x:Name="SearchBox" Grid.Column="0"
                                 Watermark="Search title…"
                                 FontSize="12"
                                 KeyDown="OnSearchKeyDown"/>
                        <Button Grid.Column="2" Classes="search" Content="Search"
                                Click="OnSearch"/>
                    </Grid>

                    <!-- Candidate list -->
                    <Grid Grid.Row="1">
                        <ListBox x:Name="CandidateList"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 SelectionChanged="OnCandidateSelected">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="data:ScreenScraperCacheCandidate">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="#D0D0E8"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding SystemName}"
                                                       FontSize="10" Foreground="#666677"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxWidth="140"/>
                                            <TextBlock FontSize="10" Foreground="#4CAF50"
                                                       IsVisible="{Binding HasMedia}"
                                                       Text="media"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- No-results notice -->
                        <TextBlock x:Name="NoResultsText"
                                   Text="No matching entries in cache."
                                   FontSize="12" Foreground="#444455"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsVisible="False"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Right: preview panel -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <StackPanel x:Name="PreviewPanel" Margin="20,16,20,16" Spacing="0"
                                IsVisible="False">

                        <TextBlock Text="DETAILS"
                                   FontSize="9" FontWeight="SemiBold" LetterSpacing="1.4"
                                   Foreground="#444455" Margin="0,0,0,10"/>

                        <TextBlock Text="Title" FontSize="10" Foreground="#555566"/>
                        <TextBlock x:Name="PreviewTitle"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="#E8E8F0" TextWrapping="Wrap"
                                   Margin="0,2,0,12"/>

                        <TextBlock Text="System" FontSize="10" Foreground="#555566"/>
                        <TextBlock x:Name="PreviewSystem"
                                   FontSize="12" Foreground="#AAAACC"
                                   Margin="0,2,0,12"/>

                        <TextBlock Text="Game ID" FontSize="10" Foreground="#555566"/>
                        <TextBlock x:Name="PreviewGameId"
                                   FontSize="12" Foreground="#AAAACC"
                                   Margin="0,2,0,12"/>

                        <TextBlock Text="Package" FontSize="10" Foreground="#555566"/>
                        <TextBlock x:Name="PreviewPackage"
                                   FontSize="11" Foreground="#888899"
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,12"/>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Background="#1E1E2C" CornerRadius="3" Padding="8,3">
                                <TextBlock FontSize="10" Foreground="#4CAF50" Text="payload"/>
                            </Border>
                            <Border x:Name="PreviewMediaBadge"
                                    Background="#1E1E2C" CornerRadius="3" Padding="8,3"
                                    IsVisible="False">
                                <TextBlock FontSize="10" Foreground="#7B68EE" Text="media"/>
                            </Border>
                        </StackPanel>

                    </StackPanel>

                    <TextBlock x:Name="PreviewPlaceholder"
                               Text="Select a result to preview"
                               FontSize="12" Foreground="#333344"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               Margin="0,80,0,0"/>
                </Grid>
            </ScrollViewer>

        </Grid>

        <!-- ── Button bar ─────────────────────────────────────────────────────── -->
        <Border Grid.Row="2" Padding="20,10,20,16"
                BorderBrush="#181826" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto">

                <TextBlock x:Name="StatusText" Grid.Column="0"
                           FontSize="11" Foreground="#888899"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Classes="secondary" Content="Cancel" Click="OnCancel"/>
                    <Button x:Name="AcceptBtn"
                            Classes="primary" Content="Accept"
                            IsEnabled="False"
                            Click="OnAccept"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>
