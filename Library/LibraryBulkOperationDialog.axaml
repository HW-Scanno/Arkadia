<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lib="clr-namespace:Arkadia.Library"
        x:Class="Arkadia.Library.LibraryBulkOperationDialog"
        Title="Arkadia — Library Bulk Operations"
        Width="640"
        SizeToContent="Height"
        MaxHeight="780"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#0F0F14"
        FontFamily="Inter,Segoe UI,sans-serif">

    <Window.Resources>
        <lib:StatusBrushConverter x:Key="StatusColor"/>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="Button.action">
            <Setter Property="Background"      Value="#7B68EE"/>
            <Setter Property="Foreground"      Value="#FFFFFF"/>
            <Setter Property="Padding"         Value="16,7"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="CornerRadius"    Value="5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
        </Style>
        <Style Selector="Button.danger">
            <Setter Property="Background"      Value="#C05020"/>
            <Setter Property="Foreground"      Value="#FFFFFF"/>
            <Setter Property="Padding"         Value="16,7"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="CornerRadius"    Value="5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
        </Style>
        <Style Selector="Button.secondary">
            <Setter Property="Background"      Value="#1A1A2C"/>
            <Setter Property="Foreground"      Value="#AAAACC"/>
            <Setter Property="Padding"         Value="16,7"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="CornerRadius"    Value="5"/>
            <Setter Property="BorderBrush"     Value="#2A2A3C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor"          Value="Hand"/>
        </Style>
        <Style Selector="RadioButton">
            <Setter Property="Foreground" Value="#CCCCDD"/>
            <Setter Property="FontSize"   Value="12"/>
        </Style>
        <Style Selector="TextBlock.section-label">
            <Setter Property="FontSize"      Value="9"/>
            <Setter Property="FontWeight"    Value="SemiBold"/>
            <Setter Property="Foreground"    Value="#444455"/>
            <Setter Property="LetterSpacing" Value="1.8"/>
        </Style>
        <Style Selector="TextBlock.stat-label">
            <Setter Property="FontSize"      Value="9"/>
            <Setter Property="FontWeight"    Value="SemiBold"/>
            <Setter Property="Foreground"    Value="#444455"/>
            <Setter Property="LetterSpacing" Value="1.4"/>
        </Style>
        <Style Selector="TextBlock.stat-val">
            <Setter Property="FontSize"   Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#CCCCDD"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ── Header ─────────────────────────────────────────────────────── -->
        <StackPanel Grid.Row="0" Margin="20,18,20,10" Spacing="3">
            <TextBlock Text="Library Bulk Operations"
                       FontSize="14" FontWeight="SemiBold" Foreground="#EEEEFF"/>
            <TextBlock x:Name="HeaderSubtitle"
                       FontSize="11" Foreground="#555577"/>
        </StackPanel>

        <!-- ── Body ───────────────────────────────────────────────────────── -->
        <ScrollViewer Grid.Row="1" MaxHeight="600"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,0,20,0" Spacing="0">

                <!-- ── STEP 1: Input panel ──────────────────────────────── -->
                <StackPanel x:Name="InputPanel" Spacing="20" Margin="0,0,0,14">

                    <!-- Search term -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="MATCH TEXT" Classes="section-label"/>
                        <TextBox x:Name="MatchTextBox"
                                 Watermark="Type a substring to match release names…"
                                 FontSize="13"
                                 TextChanged="OnMatchTextChanged"/>
                        <TextBlock x:Name="MatchHint"
                                   FontSize="11" Foreground="#555577"
                                   Text="Case-insensitive substring match against release name."/>
                    </StackPanel>

                    <!-- Operation -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="OPERATION" Classes="section-label"/>
                        <RadioButton x:Name="OpHide"
                                     Content="Hide from Catalog — marks ShowInCatalog=false"
                                     GroupName="Operation"
                                     IsChecked="True"/>
                        <RadioButton x:Name="OpShow"
                                     Content="Show in Catalog — marks ShowInCatalog=true"
                                     GroupName="Operation"/>
                        <RadioButton x:Name="OpPurge"
                                     Content="Purge and Mark Unwanted — deletes archive/volume files and marks status=unwanted"
                                     GroupName="Operation"/>
                        <RadioButton x:Name="OpRestore"
                                     Content="Restore Wanted — exits unwanted status (sets status=missing)"
                                     GroupName="Operation"/>
                    </StackPanel>

                </StackPanel>

                <!-- ── STEP 2: Preview panel ────────────────────────────── -->
                <StackPanel x:Name="PreviewPanel" IsVisible="False" Spacing="14" Margin="0,0,0,14">

                    <!-- Stats bar -->
                    <Grid ColumnDefinitions="*,*,*,*,*" Margin="0,0,0,0">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="MATCHED"   Classes="stat-label"/>
                            <TextBlock x:Name="StatMatched"    Classes="stat-val"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="ACTIONABLE" Classes="stat-label"/>
                            <TextBlock x:Name="StatActionable"  Classes="stat-val" Foreground="#7B68EE"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="2">
                            <TextBlock Text="NO-OP"     Classes="stat-label"/>
                            <TextBlock x:Name="StatNoOp"      Classes="stat-val" Foreground="#555577"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3" Spacing="2">
                            <TextBlock Text="ARCHIVE FILES" Classes="stat-label"/>
                            <TextBlock x:Name="StatFiles"     Classes="stat-val" Foreground="#AAAACC"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4" Spacing="2">
                            <TextBlock Text="ARCHIVE SIZE" Classes="stat-label"/>
                            <TextBlock x:Name="StatBytes"     Classes="stat-val" Foreground="#AAAACC"/>
                        </StackPanel>
                    </Grid>

                    <!-- Match list -->
                    <Border Background="#0A0A12"
                            BorderBrush="#1E1E2C"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="0">
                        <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="MatchList" Margin="0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="lib:BulkOperationReleaseRow">
                                        <Border Padding="10,6"
                                                BorderBrush="#141420"
                                                BorderThickness="0,0,0,1">
                                            <Grid ColumnDefinitions="64,*,Auto">
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding StatusDisplay}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{Binding Status, Converter={StaticResource StatusColor}}"
                                                           VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1"
                                                            Spacing="1"
                                                            VerticalAlignment="Center"
                                                            Margin="6,0,0,0">
                                                    <TextBlock Text="{Binding ReleaseName}"
                                                               FontSize="12"
                                                               Foreground="#CCCCDD"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Note}"
                                                               FontSize="10"
                                                               Foreground="#555577"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2"
                                                           FontSize="10"
                                                           Foreground="#555577"
                                                           VerticalAlignment="Center"
                                                           Margin="6,0,0,0"
                                                           IsVisible="{Binding HasWarning}"
                                                           Text="⚠"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <!-- Large-batch warning (>50, ≤200) -->
                    <Border x:Name="LargeBatchWarning"
                            IsVisible="False"
                            Background="#2A1800"
                            BorderBrush="#7A4400"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="12,8">
                        <TextBlock x:Name="LargeBatchWarningText"
                                   FontSize="12" Foreground="#FFB74D"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <!-- Very-large-batch typed confirmation (>200) -->
                    <StackPanel x:Name="TypedConfirmPanel" IsVisible="False" Spacing="6">
                        <TextBlock x:Name="TypedConfirmLabel"
                                   FontSize="12" Foreground="#EF9A9A"
                                   TextWrapping="Wrap"/>
                        <TextBox x:Name="TypedConfirmBox"
                                 FontSize="13"
                                 FontFamily="Consolas,Courier New,monospace"
                                 TextChanged="OnTypedConfirmChanged"/>
                    </StackPanel>

                </StackPanel>

                <!-- ── STEP 3: Progress panel ────────────────────────────── -->
                <StackPanel x:Name="ProgressPanel" IsVisible="False" Spacing="14" Margin="0,0,0,14">

                    <TextBlock x:Name="ProgressLabel"
                               Text="Running…"
                               FontSize="12" Foreground="#CCCCDD"
                               TextTrimming="CharacterEllipsis"/>

                    <ProgressBar x:Name="ProgressBar"
                                 Height="6"
                                 Minimum="0" Maximum="100" Value="0"
                                 Background="#1A1A2C"
                                 Foreground="#7B68EE"
                                 CornerRadius="3"/>

                    <Grid ColumnDefinitions="*,*,*" Margin="0,2,0,0">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="DONE"      Classes="stat-label"/>
                            <TextBlock x:Name="StatDone" Classes="stat-val" Text="0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="SUCCEEDED" Classes="stat-label"/>
                            <TextBlock x:Name="StatSucceeded" Classes="stat-val"
                                       Foreground="#4CAF50" Text="0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="2">
                            <TextBlock Text="FAILED"    Classes="stat-label"/>
                            <TextBlock x:Name="StatFailed" Classes="stat-val"
                                       Foreground="#EF5350" Text="0"/>
                        </StackPanel>
                    </Grid>

                </StackPanel>

                <!-- ── STEP 4: Result panel ──────────────────────────────── -->
                <StackPanel x:Name="ResultPanel" IsVisible="False" Spacing="12" Margin="0,0,0,14">

                    <TextBlock x:Name="ResultSummary"
                               FontSize="13" Foreground="#CCCCDD"
                               TextWrapping="Wrap"/>

                    <Border x:Name="ErrorBox"
                            IsVisible="False"
                            Background="#1A0A0A"
                            BorderBrush="#3A1010"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="10,8">
                        <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="ErrorList" Spacing="4"/>
                        </ScrollViewer>
                    </Border>

                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- ── Bottom bar ─────────────────────────────────────────────────── -->
        <Border Grid.Row="2" Padding="20,10,20,16"
                BorderBrush="#181826" BorderThickness="0,1,0,0"
                Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8">
                <Button x:Name="BackBtn"
                        Content="← Back"
                        IsVisible="False"
                        Classes="secondary"
                        Click="OnBack"/>
                <Button x:Name="PreviewBtn"
                        Content="Preview…"
                        Classes="action"
                        Click="OnPreview"/>
                <Button x:Name="ExecuteBtn"
                        Content="Execute"
                        IsVisible="False"
                        IsEnabled="False"
                        Classes="danger"
                        Click="OnExecute"/>
                <Button x:Name="CloseBtn"
                        Content="Close"
                        Classes="secondary"
                        Click="OnClose"/>
            </StackPanel>
        </Border>

    </Grid>
</Window>
