<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Arkadia"
        x:Class="Arkadia.PickDriveDialog"
        Title="Select Drive"
        Width="760" Height="400"
        MinWidth="600" MinHeight="300"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        Background="#0F0F14"
        FontFamily="Inter,Segoe UI,sans-serif">

    <Window.Styles>
        <Style Selector="TextBlock.col-header">
            <Setter Property="FontSize"     Value="10"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="Foreground"   Value="#666677"/>
            <Setter Property="Margin"       Value="0,0,12,0"/>
        </Style>
        <Style Selector="TextBlock.cell">
            <Setter Property="FontSize"     Value="12"/>
            <Setter Property="Foreground"   Value="#CCCCDD"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background"   Value="#C05020"/>
            <Setter Property="Foreground"   Value="#FFFFFF"/>
            <Setter Property="Padding"      Value="16,8"/>
            <Setter Property="FontSize"     Value="13"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Cursor"       Value="Hand"/>
        </Style>
        <Style Selector="Button.secondary">
            <Setter Property="Background"   Value="#1E1E2C"/>
            <Setter Property="Foreground"   Value="#AAAACC"/>
            <Setter Property="Padding"      Value="16,8"/>
            <Setter Property="FontSize"     Value="13"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Cursor"       Value="Hand"/>
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="#1E2840"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- Header -->
        <Border Grid.Row="0" Padding="20,14,20,10"
                BorderBrush="#181826" BorderThickness="0,0,0,1">
            <TextBlock Text="Select a mounted drive"
                       FontSize="13" FontWeight="SemiBold"
                       Foreground="#E8E8F0"/>
        </Border>

        <!-- Column headers -->
        <Border Grid.Row="1" Padding="20,7,20,5"
                Background="#0D0D13"
                BorderBrush="#181826" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="130,*,100,100,90,150">
                <TextBlock Grid.Column="0" Classes="col-header" Text="MOUNTPOINT"/>
                <TextBlock Grid.Column="1" Classes="col-header" Text="VOLUME LABEL"/>
                <TextBlock Grid.Column="2" Classes="col-header" Text="FILESYSTEM"/>
                <TextBlock Grid.Column="3" Classes="col-header" Text="TOTAL"/>
                <TextBlock Grid.Column="4" Classes="col-header" Text="FREE"/>
                <TextBlock Grid.Column="5" Classes="col-header" Text="MARKER"/>
            </Grid>
        </Border>

        <!-- Drive list -->
        <ListBox Grid.Row="2"
                 x:Name="DriveList"
                 Background="Transparent"
                 BorderThickness="0"
                 SelectionMode="Single"
                 SelectionChanged="OnDriveSelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="local:DiscoveredDiskRow">
                    <Border Padding="20,6,20,6"
                            BorderBrush="#181826" BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="130,*,100,100,90,150">
                            <TextBlock Grid.Column="0" Classes="cell" Text="{Binding Mountpoint}"/>
                            <TextBlock Grid.Column="1" Classes="cell" Text="{Binding Label}"/>
                            <TextBlock Grid.Column="2" Classes="cell" Text="{Binding DriveFormat}"/>
                            <TextBlock Grid.Column="3" Classes="cell" Text="{Binding TotalLabel}"/>
                            <TextBlock Grid.Column="4" Classes="cell" Text="{Binding FreeLabel}"/>
                            <TextBlock Grid.Column="5" Classes="cell" Text="{Binding MarkerStatus}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Footer -->
        <Border Grid.Row="3" Padding="20,10,20,14"
                BorderBrush="#181826" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Classes="secondary" Content="Cancel" Click="OnCancel"/>
                <Button x:Name="SelectButton" Classes="primary"
                        Content="Select"
                        IsEnabled="False"
                        Click="OnSelect"/>
            </StackPanel>
        </Border>

    </Grid>
</Window>
