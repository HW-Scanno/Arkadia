<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vols="clr-namespace:Arkadia.Volumes"
        x:Class="Arkadia.MoveVolumeDialog"
        Title="Move Volume — Select Destination"
        Width="820" Height="460"
        MinWidth="640" MinHeight="340"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        Background="#0F0F14"
        FontFamily="Inter,Segoe UI,sans-serif">

    <Window.Resources>
        <vols:DestinationStateColorConverter x:Key="StateColor"/>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="TextBlock.col-header">
            <Setter Property="FontSize"      Value="10"/>
            <Setter Property="FontWeight"    Value="SemiBold"/>
            <Setter Property="Foreground"    Value="#666677"/>
            <Setter Property="LetterSpacing" Value="0.8"/>
        </Style>
        <Style Selector="TextBlock.cell">
            <Setter Property="FontSize"          Value="12"/>
            <Setter Property="Foreground"        Value="#CCCCDD"/>
            <Setter Property="TextTrimming"      Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background"   Value="#C05020"/>
            <Setter Property="Foreground"   Value="#FFFFFF"/>
            <Setter Property="Padding"      Value="16,8"/>
            <Setter Property="FontSize"     Value="13"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Cursor"       Value="Hand"/>
        </Style>
        <Style Selector="Button.secondary">
            <Setter Property="Background"   Value="#1E1E2C"/>
            <Setter Property="Foreground"   Value="#AAAACC"/>
            <Setter Property="Padding"      Value="16,8"/>
            <Setter Property="FontSize"     Value="13"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Cursor"       Value="Hand"/>
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding"    Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="#1E2840"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- Header -->
        <Border Grid.Row="0" Padding="20,14,20,10"
                BorderBrush="#181826" BorderThickness="0,0,0,1">
            <StackPanel Spacing="2">
                <TextBlock x:Name="DialogTitle"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="#E8E8F0"/>
                <TextBlock x:Name="SubtitleText"
                           FontSize="11" Foreground="#555566"/>
            </StackPanel>
        </Border>

        <!-- Column headers -->
        <Border Grid.Row="1" Padding="20,7,20,5"
                Background="#0D0D13"
                BorderBrush="#181826" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,100,100,100,160">
                <TextBlock Grid.Column="0" Classes="col-header" Text="DESTINATION"/>
                <TextBlock Grid.Column="1" Classes="col-header" Text="TOTAL"    HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="2" Classes="col-header" Text="FREE"     HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="3" Classes="col-header" Text="REQUIRED" HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="4" Classes="col-header" Text="STATUS"   Margin="16,0,0,0"/>
            </Grid>
        </Border>

        <!-- Destination list -->
        <ListBox Grid.Row="2"
                 x:Name="DestList"
                 Background="Transparent"
                 BorderThickness="0"
                 SelectionMode="Single"
                 SelectionChanged="OnSelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vols:VolumeDestination">
                    <Border Padding="20,7,20,7"
                            BorderBrush="#181826" BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="*,100,100,100,160">
                            <TextBlock Grid.Column="0" Classes="cell"
                                       Text="{Binding DisplayName}"
                                       FontWeight="Medium"/>
                            <TextBlock Grid.Column="1" Classes="cell"
                                       Text="{Binding TotalLabel}"
                                       HorizontalAlignment="Right"
                                       Foreground="#888899"/>
                            <TextBlock Grid.Column="2" Classes="cell"
                                       Text="{Binding FreeLabel}"
                                       HorizontalAlignment="Right"
                                       Foreground="#888899"/>
                            <TextBlock Grid.Column="3" Classes="cell"
                                       Text="{Binding RequiredLabel}"
                                       HorizontalAlignment="Right"
                                       Foreground="#888899"/>
                            <TextBlock Grid.Column="4" Classes="cell"
                                       Text="{Binding StatusText}"
                                       Foreground="{Binding State, Converter={StaticResource StateColor}}"
                                       FontWeight="SemiBold"
                                       FontSize="10"
                                       LetterSpacing="0.6"
                                       Margin="16,0,0,0"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Footer -->
        <Border Grid.Row="3" Padding="20,10,20,14"
                BorderBrush="#181826" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Classes="secondary" Content="Cancel" Click="OnCancel"/>
                <Button x:Name="ConfirmButton" Classes="primary"
                        Content="Select Destination"
                        IsEnabled="False"
                        Click="OnConfirm"/>
            </StackPanel>
        </Border>

    </Grid>
</Window>
