<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Arkadia.InfoDialog"
        Width="380"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#0F0F14"
        FontFamily="Inter,Segoe UI,sans-serif">

    <Window.Styles>
        <Style Selector="Button.ok">
            <Setter Property="Background"   Value="#1E1E2C"/>
            <Setter Property="Foreground"   Value="#AAAACC"/>
            <Setter Property="Padding"      Value="20,8"/>
            <Setter Property="FontSize"     Value="13"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Cursor"       Value="Hand"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,Auto">
        <StackPanel Grid.Row="0" Margin="24,20,24,16" Spacing="8">
            <TextBlock x:Name="TitleLabel"
                       FontSize="14" FontWeight="SemiBold"
                       Foreground="#E8E8F0" TextWrapping="Wrap"/>
            <TextBlock x:Name="MessageLabel"
                       FontSize="12"
                       Foreground="#AAAACC" TextWrapping="Wrap"/>
        </StackPanel>
        <Border Grid.Row="1" Padding="24,10,24,18"
                BorderBrush="#181826" BorderThickness="0,1,0,0">
            <Button Classes="ok" Content="OK"
                    HorizontalAlignment="Right"
                    Click="OnOk"/>
        </Border>
    </Grid>
</Window>
