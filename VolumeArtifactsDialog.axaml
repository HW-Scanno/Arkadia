<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Arkadia.VolumeArtifactsDialog"
        Title="Arkadia - Volume Artifacts"
        Width="560"
        Height="560"
        MinHeight="300"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        Background="#0F0F14"
        FontFamily="Inter,Segoe UI,sans-serif">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- Header -->
        <Border Grid.Row="0" Padding="20,16,20,14"
                BorderBrush="#181826" BorderThickness="0,0,0,1">
            <StackPanel Spacing="3">
                <TextBlock x:Name="HeaderVolume"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="#E8E8F0"/>
                <TextBlock x:Name="HeaderCount"
                           FontSize="11" Foreground="#555566"/>
            </StackPanel>
        </Border>

        <!-- Toolbar -->
        <Border Grid.Row="1" Padding="16,8,16,8"
                Background="#0D0D13"
                BorderBrush="#181826" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBox Grid.Column="0"
                         x:Name="SearchBox"
                         Watermark="Filter releases and files…"
                         Background="#1A1A24" Foreground="#CCCCDD"
                         BorderBrush="#242433" BorderThickness="1"
                         Padding="8,5" FontSize="12" CornerRadius="4"
                         TextChanged="OnSearchChanged"/>
                <Button Grid.Column="1"
                        Content="Expand All"
                        Margin="8,0,0,0" Padding="10,5"
                        Background="#1E1E2C" Foreground="#AAAACC"
                        FontSize="12" CornerRadius="4" BorderThickness="0"
                        Click="OnExpandAll"/>
                <Button Grid.Column="2"
                        Content="Collapse All"
                        Margin="6,0,0,0" Padding="10,5"
                        Background="#1E1E2C" Foreground="#AAAACC"
                        FontSize="12" CornerRadius="4" BorderThickness="0"
                        Click="OnCollapseAll"/>
            </Grid>
        </Border>

        <!-- Grouped artifact list -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ArtifactGroupsPanel" Spacing="0"/>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="3" Padding="20,10,20,14"
                BorderBrush="#181826" BorderThickness="0,1,0,0">
            <Button Content="OK"
                    HorizontalAlignment="Right"
                    Background="#7B68EE" Foreground="#FFFFFF"
                    Padding="24,8" CornerRadius="6" BorderThickness="0"
                    Click="OnOk"/>
        </Border>

    </Grid>
</Window>
