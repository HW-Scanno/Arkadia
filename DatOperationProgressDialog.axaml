<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Arkadia.DatOperationProgressDialog"
        Title="Arkadia - DAT Operation"
        Width="440"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#0F0F14"
        FontFamily="Inter,Segoe UI,sans-serif">

    <StackPanel Margin="28,24,28,24" Spacing="0">

        <!-- Title -->
        <TextBlock x:Name="OpTitle"
                   FontSize="13" FontWeight="SemiBold"
                   Foreground="#F0F0F0"
                   Margin="0,0,0,16"/>

        <!-- Running panel -->
        <Border x:Name="RunningPanel"
                Background="#1A1A24" CornerRadius="6" Padding="16,14"
                Margin="0,0,0,16">
            <StackPanel Spacing="10">
                <TextBlock x:Name="PhaseText"
                           FontSize="12" Foreground="#888899"/>

                <ProgressBar x:Name="OpProgress"
                             IsIndeterminate="True"
                             Height="10"
                             Foreground="#7B68EE"
                             Background="#242433"
                             CornerRadius="4"
                             Minimum="0" Maximum="100" Value="0"
                             Margin="0,2,0,0"/>

                <!-- Live current-item line -->
                <TextBlock x:Name="CurrentItemText"
                           FontSize="11"
                           FontFamily="Consolas,Courier New,monospace"
                           Foreground="#555566"
                           TextTrimming="CharacterEllipsis"/>

                <!-- Counters -->
                <Grid ColumnDefinitions="*,*,*,*" Margin="0,4,0,0">
                    <StackPanel Grid.Column="0" Spacing="2" HorizontalAlignment="Center">
                        <TextBlock Text="PROCESSED" FontSize="9" LetterSpacing="1.2"
                                   Foreground="#555566" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="CountProcessed" Text="0"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="#888899" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="2" HorizontalAlignment="Center">
                        <TextBlock Text="ACCEPTED" FontSize="9" LetterSpacing="1.2"
                                   Foreground="#555566" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="CountAccepted" Text="0"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="#4CAF50" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="2" HorizontalAlignment="Center">
                        <TextBlock Text="REJECTED" FontSize="9" LetterSpacing="1.2"
                                   Foreground="#555566" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="CountRejected" Text="0"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="#EF5350" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Spacing="2" HorizontalAlignment="Center">
                        <TextBlock Text="ELAPSED" FontSize="9" LetterSpacing="1.2"
                                   Foreground="#555566" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="CountElapsed" Text="0:00"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="#888899" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Import summary panel (shown on import completion) -->
        <StackPanel x:Name="ImportSummaryPanel" IsVisible="False" Spacing="0">
            <TextBlock Text="IMPORT COMPLETED"
                       FontSize="10" FontWeight="SemiBold" LetterSpacing="1.8"
                       Foreground="#888899" Margin="0,0,0,12"/>

            <Border Background="#1A1A24" CornerRadius="6" Padding="16,12" Margin="0,0,0,10">
                <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="120,*">
                        <TextBlock Grid.Column="0" Text="Platform"   FontSize="12" Foreground="#888899"/>
                        <TextBlock Grid.Column="1" x:Name="ImportSumPlatform" FontSize="12" Foreground="#F0F0F0"/>
                    </Grid>
                    <Grid ColumnDefinitions="120,*">
                        <TextBlock Grid.Column="0" Text="DAT Line ID" FontSize="12" Foreground="#888899"/>
                        <TextBlock Grid.Column="1" x:Name="ImportSumId"
                                   FontSize="12" Foreground="#E07040"
                                   FontFamily="Consolas,Courier New,monospace"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Background="#1A1A24" CornerRadius="6" Padding="16,12" Margin="0,0,0,16">
                <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="Total"    FontSize="12" Foreground="#888899"/>
                        <TextBlock Grid.Column="1" x:Name="ImportSumTotal"
                                   FontSize="12" FontWeight="Medium" Foreground="#F0F0F0"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="Imported" FontSize="12" Foreground="#888899"/>
                        <TextBlock Grid.Column="1" x:Name="ImportSumCount"
                                   FontSize="12" FontWeight="Medium" Foreground="#4CAF50"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="Rejected" FontSize="12" Foreground="#888899"/>
                        <TextBlock Grid.Column="1" x:Name="ImportSumRejected"
                                   FontSize="12" FontWeight="Medium" Foreground="#EF5350"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="Elapsed"  FontSize="12" Foreground="#888899"/>
                        <TextBlock Grid.Column="1" x:Name="ImportSumElapsed"
                                   FontSize="12" FontWeight="Medium" Foreground="#888899"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Update summary panel (shown on update completion) -->
        <StackPanel x:Name="UpdateSummaryPanel" IsVisible="False" Spacing="0">
            <TextBlock Text="UPDATE COMPLETED"
                       FontSize="10" FontWeight="SemiBold" LetterSpacing="1.8"
                       Foreground="#888899" Margin="0,0,0,12"/>

            <Border Background="#1A1A24" CornerRadius="6" Padding="16,12" Margin="0,0,0,10">
                <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="120,*">
                        <TextBlock Grid.Column="0" Text="Platform"    FontSize="12" Foreground="#888899"/>
                        <TextBlock Grid.Column="1" x:Name="UpdateSumPlatform" FontSize="12" Foreground="#F0F0F0"/>
                    </Grid>
                    <Grid ColumnDefinitions="120,*">
                        <TextBlock Grid.Column="0" Text="DAT Line ID" FontSize="12" Foreground="#888899"/>
                        <TextBlock Grid.Column="1" x:Name="UpdateSumId"
                                   FontSize="12" Foreground="#E07040"
                                   FontFamily="Consolas,Courier New,monospace"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Background="#1A1A24" CornerRadius="6" Padding="16,12" Margin="0,0,0,16">
                <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="Kept"     FontSize="12" Foreground="#888899"/>
                        <TextBlock Grid.Column="1" x:Name="UpdateSumKept"
                                   FontSize="12" FontWeight="Medium" Foreground="#4CAF50"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="Outdated" FontSize="12" Foreground="#888899"/>
                        <TextBlock Grid.Column="1" x:Name="UpdateSumOutdated"
                                   FontSize="12" FontWeight="Medium" Foreground="#888899"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="Pending"  FontSize="12" Foreground="#888899"/>
                        <TextBlock Grid.Column="1" x:Name="UpdateSumPending"
                                   FontSize="12" FontWeight="Medium" Foreground="#FFD54F"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="Missing"  FontSize="12" Foreground="#888899"/>
                        <TextBlock Grid.Column="1" x:Name="UpdateSumMissing"
                                   FontSize="12" FontWeight="Medium" Foreground="#FFA726"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Failed panel -->
        <StackPanel x:Name="FailedPanel" IsVisible="False" Spacing="0">
            <TextBlock Text="OPERATION FAILED"
                       FontSize="10" FontWeight="SemiBold" LetterSpacing="1.8"
                       Foreground="#EF5350" Margin="0,0,0,12"/>

            <Border Background="#1A1A24" CornerRadius="6" Padding="16,12" Margin="0,0,0,16">
                <TextBlock x:Name="FailedMessage"
                           FontSize="12" Foreground="#EF5350"
                           TextWrapping="Wrap"/>
            </Border>
        </StackPanel>

        <!-- OK button -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="OkButton"
                    Content="OK"
                    IsEnabled="False"
                    Background="#7B68EE" Foreground="#FFFFFF"
                    Padding="24,8" CornerRadius="6" BorderThickness="0"
                    Click="OnOk"/>
        </StackPanel>

    </StackPanel>
</Window>
