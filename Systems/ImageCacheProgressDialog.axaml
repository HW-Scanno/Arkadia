<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Arkadia"
        xmlns:ing="using:Arkadia.Ingestion"
        x:Class="Arkadia.ImageCacheProgressDialog"
        Title="Regenerate Image Cache"
        Width="900" Height="600"
        MinWidth="700" MinHeight="440"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        Background="#0F0F14"
        FontFamily="Inter,Segoe UI,sans-serif">

    <Window.Resources>
        <local:ActionColorConverter x:Key="ActionColor"/>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="TextBlock.col-header">
            <Setter Property="FontSize"      Value="10"/>
            <Setter Property="FontWeight"    Value="SemiBold"/>
            <Setter Property="Foreground"    Value="#555566"/>
            <Setter Property="LetterSpacing" Value="1"/>
        </Style>
    </Window.Styles>

    <!--
        Rows:
          0 Auto  — title
          1 Auto  — progress area
          2 Auto  — column headers
          3 *     — scrollable ops list
          4 Auto  — summary / failed
          5 Auto  — OK button
    -->
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" Margin="28,24,28,20">

        <!-- Row 0: Title -->
        <TextBlock Grid.Row="0"
                   x:Name="OpTitle"
                   FontSize="13" FontWeight="SemiBold"
                   Foreground="#F0F0F0"
                   TextWrapping="Wrap"
                   Margin="0,0,0,14"/>

        <!-- Row 1: Progress area -->
        <Border Grid.Row="1"
                Background="#1A1A24" CornerRadius="6" Padding="16,14"
                Margin="0,0,0,2">
            <StackPanel Spacing="10">
                <TextBlock x:Name="PhaseText"
                           FontSize="12" Foreground="#888899"/>

                <ProgressBar x:Name="OpProgress"
                             IsIndeterminate="True"
                             Height="4"
                             Foreground="#7B68EE"
                             Background="#242433"
                             CornerRadius="2"
                             Minimum="0" Maximum="100" Value="0"/>

                <Grid ColumnDefinitions="*,*" Margin="0,4,0,0">
                    <StackPanel Grid.Column="0" Spacing="2" HorizontalAlignment="Center">
                        <TextBlock Text="SOURCES" FontSize="9" LetterSpacing="1.2"
                                   Foreground="#555566" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="CountSources" Text="0"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="#888899" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="2" HorizontalAlignment="Center">
                        <TextBlock Text="GENERATED" FontSize="9" LetterSpacing="1.2"
                                   Foreground="#555566" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="CountGenerated" Text="0"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="#4CAF50" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Row 2: Column headers -->
        <Border Grid.Row="2"
                Padding="12,6,12,6"
                Background="#141420"
                BorderBrush="#242433" BorderThickness="0,1,0,1">
            <Grid ColumnDefinitions="2*,90,3*">
                <TextBlock Grid.Column="0" Classes="col-header" Text="FILE"/>
                <TextBlock Grid.Column="1" Classes="col-header" Text="ACTION"/>
                <TextBlock Grid.Column="2" Classes="col-header" Text="OUTPUT"/>
            </Grid>
        </Border>

        <!-- Row 3: Scrollable operations list -->
        <Border Grid.Row="3"
                Background="#1A1A24"
                Margin="0,0,0,10">
            <ScrollViewer x:Name="OpsScrollViewer"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="OpsList" Padding="0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="ing:IngestionOperation">
                            <Border Padding="12,3,12,3"
                                    BorderBrush="#0D0D13" BorderThickness="0,0,0,1">
                                <Grid ColumnDefinitions="2*,90,3*">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Object}"
                                               FontSize="11"
                                               Foreground="#CCCCDD"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Action}"
                                               FontSize="11" FontWeight="Bold"
                                               Foreground="{Binding Action, Converter={StaticResource ActionColor}}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Destination}"
                                               FontSize="10"
                                               FontFamily="Consolas,Courier New,monospace"
                                               Foreground="#888899"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Row 4: Summary / Failed panels -->
        <StackPanel Grid.Row="4" Spacing="0">

            <StackPanel x:Name="SummaryPanel" IsVisible="False" Spacing="0">
                <TextBlock Text="CACHE REGENERATION COMPLETED"
                           FontSize="10" FontWeight="SemiBold" LetterSpacing="1.8"
                           Foreground="#888899" Margin="0,0,0,10"/>

                <Border Background="#1A1A24" CornerRadius="6" Padding="16,12" Margin="0,0,0,10">
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="Sources processed" FontSize="12" Foreground="#888899"/>
                            <TextBlock Grid.Column="1" x:Name="SumSources"      FontSize="12" FontWeight="Medium" Foreground="#F0F0F0"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="Cache files generated" FontSize="12" Foreground="#888899"/>
                            <TextBlock Grid.Column="1" x:Name="SumGenerated"        FontSize="12" FontWeight="SemiBold" Foreground="#4CAF50"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel x:Name="FailedPanel" IsVisible="False" Spacing="0">
                <TextBlock Text="OPERATION FAILED"
                           FontSize="10" FontWeight="SemiBold" LetterSpacing="1.8"
                           Foreground="#EF5350" Margin="0,0,0,10"/>

                <Border Background="#1A1A24" CornerRadius="6" Padding="16,12" Margin="0,0,0,10">
                    <TextBlock x:Name="FailedMessage"
                               FontSize="12" Foreground="#EF5350"
                               TextWrapping="Wrap"/>
                </Border>
            </StackPanel>

        </StackPanel>

        <!-- Row 5: OK button -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,4,0,0">
            <Button x:Name="OkButton"
                    Content="OK"
                    IsEnabled="False"
                    Background="#7B68EE" Foreground="#FFFFFF"
                    Padding="24,8" CornerRadius="6" BorderThickness="0"
                    Click="OnOk"/>
        </StackPanel>

    </Grid>
</Window>
