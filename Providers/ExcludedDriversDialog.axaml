<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Arkadia.ExcludedDriversDialog"
        Title="Excluded Drivers"
        Width="420" Height="420"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        Background="#0F0F14"
        FontFamily="Inter,Segoe UI,sans-serif">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <Border Grid.Row="0"
                Padding="16,10"
                BorderBrush="#181826" BorderThickness="0,0,0,1"
                Background="#0D0D13">
            <StackPanel Spacing="3">
                <TextBlock Text="EXCLUDED DRIVERS"
                           FontSize="10" FontWeight="SemiBold"
                           LetterSpacing="1.5" Foreground="#666677"/>
                <TextBlock x:Name="CountLabel"
                           FontSize="10" Foreground="#555566"/>
            </StackPanel>
        </Border>

        <!-- Driver list (built in code) -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="ExcludedPanel" Spacing="0"/>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2"
                Padding="16,10,16,14"
                BorderBrush="#181826" BorderThickness="0,1,0,0"
                Background="#0F0F14">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Column="0"
                        x:Name="RestoreAllButton"
                        Content="Restore All"
                        Background="#242433" Foreground="#4CAF50"
                        BorderBrush="#2A2A3C" BorderThickness="1"
                        CornerRadius="4" Padding="14,6" FontSize="11"
                        IsEnabled="False"
                        Click="OnRestoreAll"/>
                <Button Grid.Column="2"
                        Content="Close"
                        Background="#242433" Foreground="#F0F0F0"
                        BorderThickness="0"
                        CornerRadius="4" Padding="14,6" FontSize="11"
                        Click="OnClose"/>
            </Grid>
        </Border>

    </Grid>
</Window>
