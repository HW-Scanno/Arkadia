<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Arkadia.MameProviderWindow"
        Title="Arkadia - MAME Provider"
        Width="1060" Height="840"
        MinWidth="820" MinHeight="640"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        Background="#0F0F14"
        FontFamily="Inter,Segoe UI,sans-serif">

    <Window.Styles>
        <Style Selector="Button.action">
            <Setter Property="Background"      Value="#1E1E2E"/>
            <Setter Property="Foreground"      Value="#AAAACC"/>
            <Setter Property="BorderBrush"     Value="#2A2A3C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="4"/>
            <Setter Property="Padding"         Value="10,4"/>
            <Setter Property="FontSize"        Value="11"/>
        </Style>
        <Style Selector="Button.action:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#252540"/>
        </Style>
        <Style Selector="Button.action:disabled">
            <Setter Property="Opacity" Value="0.38"/>
        </Style>
    </Window.Styles>

    <!--
        Row 0 Auto  — header
        Row 1 *     — body (release list | divider | right panel)
        Row 2 Auto  — footer
    -->
    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ══ Row 0: Header ════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Padding="24,18,24,16"
                BorderBrush="#181826" BorderThickness="0,0,0,1"
                Background="#0F0F14">
            <StackPanel Spacing="4">
                <TextBlock Text="MAME"
                           FontSize="16" FontWeight="SemiBold" Foreground="#F0F0F0"/>
                <TextBlock Text="Official releases — versioned listxml cache from the authoritative source"
                           FontSize="12" Foreground="#888899"/>
            </StackPanel>
        </Border>

        <!-- ══ Row 1: Body ══════════════════════════════════════════════════ -->
        <Grid Grid.Row="1" ColumnDefinitions="300,1,*">

            <!-- Left: single-select release list -->
            <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*" Background="#0D0D13">

                <Border Grid.Row="0"
                        Padding="10,8"
                        BorderBrush="#181826" BorderThickness="0,0,0,1">
                    <TextBox x:Name="MameSearch"
                             Watermark="Search releases…"
                             FontSize="12"
                             Background="#1A1A24" Foreground="#E8E8F0"
                             BorderBrush="#2A2A3C" BorderThickness="1"
                             Padding="8,6" CornerRadius="4"
                             TextChanged="OnMameSearchChanged"/>
                </Border>

                <Border Grid.Row="1"
                        Padding="10,8"
                        BorderBrush="#181826" BorderThickness="0,0,0,1"
                        Background="#0F0F14">
                    <TextBlock x:Name="MameCountLabel"
                               FontSize="10" Foreground="#666677"
                               VerticalAlignment="Center"/>
                </Border>

                <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="MameReleasesPanel" Spacing="0"/>
                </ScrollViewer>

            </Grid>

            <!-- Divider -->
            <Border Grid.Column="1" Background="#181826"/>

            <!-- Right: provider info + progress + log -->
            <Grid Grid.Column="2" RowDefinitions="Auto,Auto,*">

                <Border Grid.Row="0"
                        Background="#1A1A24"
                        BorderBrush="#1E1E2C" BorderThickness="0,0,0,1"
                        Padding="20,12">
                    <StackPanel Spacing="3">
                        <TextBlock Text="MAME — github.com/mamedev/mame"
                                   FontSize="10" FontWeight="SemiBold"
                                   LetterSpacing="1.8" Foreground="#7B68EE"/>
                        <TextBlock Text="Official releases — generates versioned listxml cache from the authoritative source."
                                   FontSize="11" Foreground="#AAAABC"/>
                        <TextBlock x:Name="MameStatusText"
                                   Text="Release list not loaded.  Click  &#x201C;Load Releases&#x201D;  to begin."
                                   FontSize="11" Foreground="#8888AA"/>
                        <TextBlock x:Name="MameSelectedInfo"
                                   Text=""
                                   FontSize="11" Foreground="#666677"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1"
                        Background="#141420"
                        BorderBrush="#1E1E2C" BorderThickness="0,0,0,1"
                        Padding="20,8">
                    <StackPanel Spacing="5">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock x:Name="MameProgressLabel"
                                       Grid.Column="0"
                                       FontSize="11"
                                       FontFamily="Consolas,Courier New,monospace"
                                       Foreground="#666677"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="MameProgressDetail"
                                       Grid.Column="1"
                                       FontSize="10"
                                       FontFamily="Consolas,Courier New,monospace"
                                       Foreground="#666677"/>
                        </Grid>
                        <ProgressBar x:Name="MameDownloadProgress"
                                     Height="4"
                                     IsIndeterminate="False"
                                     Value="0" Minimum="0" Maximum="100"
                                     Foreground="#7B68EE"
                                     Background="#242433"
                                     CornerRadius="2"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Background="#0D0D13">
                    <ScrollViewer x:Name="MameLogScrollViewer"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="MameLogPanel" Margin="16,10,16,10" Spacing="1"/>
                    </ScrollViewer>
                </Border>

            </Grid>
        </Grid>

        <!-- ══ Row 2: Footer ════════════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Padding="20,11,20,13"
                BorderBrush="#181826" BorderThickness="0,1,0,0"
                Background="#0F0F14">
            <Grid ColumnDefinitions="*,Auto">

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="RefreshButton"
                            Content="Load Releases"
                            Background="#242433" Foreground="#CCCCDD"
                            BorderBrush="#2A2A3C" BorderThickness="1"
                            CornerRadius="5" Padding="14,7" FontSize="12"
                            Click="OnRefreshList"/>
                    <Button x:Name="CancelButton"
                            Content="Cancel"
                            Background="#2A1218" Foreground="#EF5350"
                            BorderBrush="#3A1C22" BorderThickness="1"
                            CornerRadius="5" Padding="14,7" FontSize="12"
                            IsVisible="False"
                            Click="OnCancel"/>
                    <Button x:Name="DownloadButton"
                            Content="Download &amp; Cache"
                            Background="#7B68EE" Foreground="#FFFFFF"
                            BorderThickness="0"
                            CornerRadius="5" Padding="14,7" FontSize="12"
                            IsEnabled="False"
                            Click="OnDownloadAndCache"/>
                    <Button x:Name="PlaylistButton"
                            Content="Playlist Generator"
                            Background="#1A2030" Foreground="#8888CC"
                            BorderBrush="#2A2A4A" BorderThickness="1"
                            CornerRadius="5" Padding="14,7" FontSize="12"
                            Click="OnOpenPlaylistGenerator"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="Close"
                        Background="#242433" Foreground="#F0F0F0"
                        BorderThickness="0"
                        CornerRadius="5" Padding="14,7" FontSize="12"
                        Click="OnClose"/>

            </Grid>
        </Border>

    </Grid>
</Window>
