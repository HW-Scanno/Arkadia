<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Arkadia.ScraperProviderDialog"
        Title="Choose Scraper Provider"
        Width="440"
        Height="280"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#0D0D12"
        FontFamily="Inter,Segoe UI,sans-serif">

    <Window.Styles>
        <Style Selector="Button.primary">
            <Setter Property="Background"      Value="#7B68EE"/>
            <Setter Property="Foreground"      Value="#FFFFFF"/>
            <Setter Property="Padding"         Value="22,8"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="CornerRadius"    Value="4"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.secondary">
            <Setter Property="Background"      Value="#1E1E2C"/>
            <Setter Property="Foreground"      Value="#AAAACC"/>
            <Setter Property="Padding"         Value="22,8"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="CornerRadius"    Value="4"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="24,20,24,16" Spacing="4">
            <TextBlock Text="CHOOSE SCRAPER PROVIDER"
                       FontSize="11" FontWeight="SemiBold" LetterSpacing="1.8"
                       Foreground="#9FA4FF"/>
            <TextBlock Text="Select a configured provider to scrape metadata for this release."
                       FontSize="12" Foreground="#666677"/>
        </StackPanel>

        <!-- Provider rows (populated in code-behind) -->
        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ProviderPanel" Margin="24,0,24,4" Spacing="6"/>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Padding="24,12,24,18"
                BorderBrush="#181826" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Classes="secondary" Content="Cancel"   Click="OnCancel"/>
                <Button x:Name="ContinueBtn"
                        Classes="primary"
                        Content="Continue"
                        IsEnabled="False"
                        Click="OnContinue"/>
            </StackPanel>
        </Border>

    </Grid>
</Window>
