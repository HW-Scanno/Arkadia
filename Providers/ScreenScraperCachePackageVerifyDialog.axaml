<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Arkadia.ScreenScraperCachePackageVerifyDialog"
        Title="Verify ScreenScraper Cache Package"
        Width="680"
        SizeToContent="Height"
        MaxHeight="680"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#0F0F14"
        FontFamily="Inter,Segoe UI,sans-serif">

    <Window.Styles>
        <Style Selector="Button.secondary">
            <Setter Property="Background"      Value="#1A1A2C"/>
            <Setter Property="Foreground"      Value="#AAAACC"/>
            <Setter Property="Padding"         Value="14,7"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="CornerRadius"    Value="5"/>
            <Setter Property="BorderBrush"     Value="#2A2A3C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor"          Value="Hand"/>
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding"         Value="12,7"/>
            <Setter Property="BorderBrush"     Value="#1A1A28"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style Selector="TextBlock.key">
            <Setter Property="FontSize"    Value="11"/>
            <Setter Property="Foreground"  Value="#666680"/>
        </Style>
        <Style Selector="TextBlock.val">
            <Setter Property="FontSize"    Value="11"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Foreground"  Value="#CCCCDD"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto">

        <!-- ── Header ───────────────────────────────────────────────────────── -->
        <StackPanel Grid.Row="0" Margin="20,18,20,0" Spacing="6">
            <TextBlock x:Name="HeaderFilename"
                       FontSize="14" FontWeight="SemiBold" Foreground="#EEEEFF"
                       TextTrimming="CharacterEllipsis"/>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Border x:Name="StatusBadge"
                        CornerRadius="4" Padding="10,3">
                    <TextBlock x:Name="StatusText"
                               FontSize="11" FontWeight="SemiBold" LetterSpacing="0.5"/>
                </Border>
                <TextBlock x:Name="IssueCountText"
                           FontSize="11" Foreground="#555577"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>

        <!-- ── Summary ──────────────────────────────────────────────────────── -->
        <Border Grid.Row="1" Margin="20,14,20,0"
                Background="#0A0A12" BorderBrush="#1E1E2C"
                BorderThickness="1" CornerRadius="6" Padding="16,12">
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">

                <TextBlock Grid.Row="0" Grid.Column="0" Classes="key" Text="Games indexed"/>
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="SumIndexedGames" Classes="val"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Classes="key" Margin="0,4,0,0" Text="Payloads expected / found / valid"/>
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="SumPayloads"       Classes="val" Margin="0,4,0,0"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Classes="key" Margin="0,4,0,0" Text="Payloads missing"/>
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="SumPayloadsMissing" Classes="val" Margin="0,4,0,0"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Classes="key" Margin="0,4,0,0" Text="Media indexed / found / missing"/>
                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="SumMedia"            Classes="val" Margin="0,4,0,0"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Classes="key" Margin="0,4,0,0" Text="Zero-byte media"/>
                <TextBlock Grid.Row="4" Grid.Column="1" x:Name="SumZeroByte"         Classes="val" Margin="0,4,0,0"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Classes="key" Margin="0,4,0,0" Text="Sanitization errors / warnings"/>
                <TextBlock Grid.Row="5" Grid.Column="1" x:Name="SumSanitization"     Classes="val" Margin="0,4,0,0"/>

            </Grid>
        </Border>

        <!-- ── Issues list ──────────────────────────────────────────────────── -->
        <Border Grid.Row="2" Margin="20,10,20,0"
                Background="#0A0A12" BorderBrush="#1E1E2C"
                BorderThickness="1" CornerRadius="6">
            <StackPanel>
                <ListBox x:Name="IssuesList"
                         Background="Transparent"
                         MinHeight="36"
                         MaxHeight="260"
                         Padding="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:CompileBindings="False">
                            <Grid ColumnDefinitions="Auto,Auto,*">
                                <Border Grid.Column="0"
                                        x:Name="SevBadge"
                                        CornerRadius="3" Padding="5,2"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        Background="{Binding SeverityBackground}"
                                        IsVisible="{Binding HasSeverityBadge}">
                                    <TextBlock Text="{Binding SeverityLabel}"
                                               FontSize="9" FontWeight="SemiBold"
                                               Foreground="{Binding SeverityForeground}"
                                               LetterSpacing="0.5"/>
                                </Border>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Area}"
                                           FontSize="10" Foreground="#555577"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding Message}"
                                           FontSize="11" Foreground="#AAAACC"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="NoIssuesMsg"
                           IsVisible="False"
                           Text="No issues found — package looks good."
                           FontSize="11" Foreground="#444455"
                           HorizontalAlignment="Center"
                           Margin="20,14,20,14"/>
            </StackPanel>
        </Border>

        <!-- ── Validation message ────────────────────────────────────────────── -->
        <TextBlock x:Name="ValidationMsg"
                   Grid.Row="3"
                   IsVisible="False"
                   FontSize="11" Foreground="#EF5350"
                   Margin="20,8,20,0"
                   TextWrapping="Wrap"/>

        <!-- ── Bottom bar ────────────────────────────────────────────────────── -->
        <Border Grid.Row="4" Padding="20,12,20,16"
                BorderBrush="#181826" BorderThickness="0,1,0,0"
                Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8">
                <Button Classes="secondary"
                        Content="Copy Report"
                        Click="OnCopyReport"/>
                <Button Classes="secondary"
                        Content="Close"
                        Click="OnClose"/>
            </StackPanel>
        </Border>

    </Grid>
</Window>
