<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Arkadia.CategoryIniPromptDialog"
        Title="Download category.ini"
        Width="420" Height="220"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#0F0F14"
        FontFamily="Inter,Segoe UI,sans-serif">

    <Grid RowDefinitions="*,Auto">

        <StackPanel Grid.Row="0" Margin="24,20,24,8" Spacing="10">
            <TextBlock Text="MAME cache was created successfully."
                       FontSize="12" FontWeight="SemiBold" Foreground="#E0E0F0"/>
            <TextBlock FontSize="11" Foreground="#888899" TextWrapping="Wrap">
                category.ini is recommended for arcade filtering, driver&#x0A;categorization, and future gambling / non-arcade grouping.&#x0A;&#x0A;Would you like to download it now?
            </TextBlock>
        </StackPanel>

        <Border Grid.Row="1"
                Padding="20,10,20,16"
                BorderBrush="#181826" BorderThickness="0,1,0,0"
                Background="#0F0F14">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8">
                <Button Content="Skip"
                        Background="#242433" Foreground="#AAAACC"
                        BorderBrush="#2A2A3C" BorderThickness="1"
                        CornerRadius="4" Padding="16,6" FontSize="11"
                        Click="OnSkip"/>
                <Button Content="Download"
                        Background="#7B68EE" Foreground="#FFFFFF"
                        BorderThickness="0"
                        CornerRadius="4" Padding="16,6" FontSize="11"
                        Click="OnDownload"/>
            </StackPanel>
        </Border>

    </Grid>
</Window>
