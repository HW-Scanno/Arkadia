<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Arkadia.FamilyRuleDialog"
        Title="Family Rule"
        Width="460" Height="480"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#0F0F14"
        FontFamily="Inter,Segoe UI,sans-serif">

    <Grid RowDefinitions="*,Auto">

        <Grid Grid.Row="0"
              RowDefinitions="Auto,Auto,Auto,*,Auto"
              Margin="20,18,20,8">

            <!-- Family Name -->
            <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,12">
                <TextBlock Text="Family Name"
                           FontSize="11" Foreground="#888899"/>
                <TextBox x:Name="NameBox"
                         Watermark="e.g. Capcom CPS1"
                         Background="#1A1A24" Foreground="#E8E8F0"
                         BorderBrush="#2A2A3C" BorderThickness="1"
                         CornerRadius="4" FontSize="12" Padding="8,6"
                         TextChanged="OnNameChanged"/>
            </StackPanel>

            <!-- Rule Type (static) -->
            <StackPanel Grid.Row="1" Spacing="3" Margin="0,0,0,12">
                <TextBlock Text="Rule Type"
                           FontSize="11" Foreground="#888899"/>
                <TextBlock Text="sourcefile in"
                           FontSize="11" Foreground="#7B68EE"
                           FontFamily="Consolas,Courier New,monospace"/>
            </StackPanel>

            <!-- Source Files: header + search -->
            <StackPanel Grid.Row="2" Spacing="4" Margin="0,0,0,4">
                <TextBlock Text="Source Files (multi-select)"
                           FontSize="11" Foreground="#888899"/>
                <TextBox x:Name="SearchBox"
                         Watermark="Filter sourcefiles…"
                         Background="#1A1A24" Foreground="#E8E8F0"
                         BorderBrush="#2A2A3C" BorderThickness="1"
                         CornerRadius="4" FontSize="12" Padding="8,5"
                         TextChanged="OnSearchChanged"/>
            </StackPanel>

            <!-- Sourcefile list (takes remaining space) -->
            <ListBox Grid.Row="3"
                     x:Name="SourcefileList"
                     SelectionMode="Multiple"
                     Background="#1A1A24"
                     BorderBrush="#2A2A3C" BorderThickness="1"
                     CornerRadius="4"
                     FontSize="12"
                     FontFamily="Consolas,Courier New,monospace"
                     Foreground="#CCCCDD"
                     Padding="4,2"
                     SelectionChanged="OnSourcefileSelected"/>

            <!-- Selected count indicator -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                <TextBlock Text="Selected:"
                           FontSize="10" Foreground="#555566"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="SelectedValueLabel"
                           FontSize="10" Foreground="#7B68EE"
                           FontFamily="Consolas,Courier New,monospace"
                           Text="(none)"
                           VerticalAlignment="Center"/>
            </StackPanel>

        </Grid>

        <!-- Footer -->
        <Border Grid.Row="1"
                Padding="20,10,20,14"
                BorderBrush="#181826" BorderThickness="0,1,0,0"
                Background="#0F0F14">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8">
                <Button Content="Cancel"
                        Background="#242433" Foreground="#AAAACC"
                        BorderBrush="#2A2A3C" BorderThickness="1"
                        CornerRadius="4" Padding="16,6" FontSize="11"
                        Click="OnCancel"/>
                <Button x:Name="OkButton"
                        Content="OK"
                        Background="#7B68EE" Foreground="#FFFFFF"
                        BorderThickness="0"
                        CornerRadius="4" Padding="16,6" FontSize="11"
                        IsEnabled="False"
                        Click="OnOk"/>
            </StackPanel>
        </Border>

    </Grid>
</Window>
