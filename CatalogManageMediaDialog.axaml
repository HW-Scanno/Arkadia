<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Arkadia.CatalogManageMediaDialog"
        Title="Manage Media"
        Width="900"
        SizeToContent="Height"
        MaxHeight="760"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#0F0F14"
        FontFamily="Inter,Segoe UI,sans-serif">

    <Window.Styles>
        <Style Selector="Button.action">
            <Setter Property="Background"      Value="{DynamicResource ArkAccent}"/>
            <Setter Property="Foreground"      Value="#FFFFFF"/>
            <Setter Property="Padding"         Value="12,6"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="CornerRadius"    Value="5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
        </Style>
        <Style Selector="Button.secondary">
            <Setter Property="Background"      Value="#1A1A2C"/>
            <Setter Property="Foreground"      Value="#AAAACC"/>
            <Setter Property="Padding"         Value="12,6"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="CornerRadius"    Value="5"/>
            <Setter Property="BorderBrush"     Value="#2A2A3C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor"          Value="Hand"/>
        </Style>
        <Style Selector="Button.danger">
            <Setter Property="Background"      Value="#2A1215"/>
            <Setter Property="Foreground"      Value="#EF7070"/>
            <Setter Property="Padding"         Value="12,6"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="CornerRadius"    Value="5"/>
            <Setter Property="BorderBrush"     Value="#3A2025"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor"          Value="Hand"/>
        </Style>
        <Style Selector="TextBlock.key">
            <Setter Property="FontSize"   Value="10"/>
            <Setter Property="Foreground" Value="#555577"/>
        </Style>
        <Style Selector="TextBlock.val">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Foreground" Value="#CCCCDD"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding"         Value="10,7"/>
            <Setter Property="BorderBrush"     Value="#1A1A28"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto,Auto">

        <!-- ── Header ───────────────────────────────────────────────────── -->
        <StackPanel Grid.Row="0" Margin="20,18,20,10" Spacing="3">
            <TextBlock x:Name="HeaderTitle"
                       FontSize="15" FontWeight="SemiBold" Foreground="#EEEEFF"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="Curate media assets for this release. Provider provenance is not shown."
                       FontSize="11" Foreground="#555577"/>
        </StackPanel>

        <!-- ── Body: asset list | detail panel ──────────────────────────── -->
        <Grid Grid.Row="1" ColumnDefinitions="360,1,*" Margin="20,0,20,0">

            <!-- Left: asset list -->
            <Border Grid.Column="0"
                    Background="#0A0A12" BorderBrush="#1E1E2C"
                    BorderThickness="1" CornerRadius="6">
                <StackPanel>
                    <ListBox x:Name="AssetList"
                             Background="Transparent"
                             MinHeight="52"
                             MaxHeight="580"
                             Padding="0"
                             SelectionChanged="OnAssetSelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:CompileBindings="False">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <!-- Status badge -->
                                    <Border Grid.Column="0"
                                            Background="{Binding StatusBackground}"
                                            CornerRadius="3" Padding="5,2"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StatusLabel}"
                                                   Foreground="{Binding StatusForeground}"
                                                   FontSize="9" FontWeight="SemiBold"
                                                   LetterSpacing="0.5"/>
                                    </Border>
                                    <!-- Media type + filename -->
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding MediaTypeLabel}"
                                                   FontSize="9" Foreground="#555577"
                                                   LetterSpacing="0.3"/>
                                        <TextBlock Text="{Binding FileName}"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   Foreground="#CCCCDD"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <!-- Size -->
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding SizeDisplay}"
                                               FontSize="10" Foreground="#444455"
                                               VerticalAlignment="Center"
                                               Margin="8,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="EmptyMsg"
                               IsVisible="False"
                               Text="No media files found for this release."
                               FontSize="11" Foreground="#444455"
                               HorizontalAlignment="Center"
                               Margin="16,18,16,18"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Divider -->
            <Border Grid.Column="1" Background="#1A1A28" Margin="12,0"/>

            <!-- Right: detail panel -->
            <Panel Grid.Column="2" MaxHeight="580">
              <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="DetailPanel" Spacing="10" IsVisible="False">

                    <!-- Preview -->
                    <Border x:Name="PreviewBorder"
                            Height="180"
                            Background="#0A0A12"
                            BorderBrush="#1E1E2C"
                            BorderThickness="1"
                            CornerRadius="6"
                            ClipToBounds="True">
                        <Panel>
                            <Image x:Name="PreviewImage"
                                   Stretch="Uniform"
                                   IsVisible="False"/>
                            <TextBlock x:Name="PreviewPlaceholder"
                                       FontSize="11" Foreground="#333348"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Panel>
                    </Border>

                    <!-- Asset info grid -->
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" Margin="0,0,0,4">
                        <TextBlock Grid.Row="0" Grid.Column="0" Classes="key" Text="Filename"   Margin="0,0,12,4"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Classes="val" x:Name="InfoFilename"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Classes="key" Text="Type"       Margin="0,0,12,4"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Classes="val" x:Name="InfoType"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Classes="key" Text="Size"       Margin="0,0,12,4"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Classes="val" x:Name="InfoSize"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Classes="key" Text="Status"     Margin="0,0,12,4"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Classes="val" x:Name="InfoStatus"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Classes="key" Text="SHA-256"    Margin="0,0,12,0"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Classes="val" x:Name="InfoSha256"
                                   FontSize="9" FontFamily="Consolas,monospace"/>
                    </Grid>

                    <!-- Credits editor -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Credits"
                                   FontSize="10" Foreground="#555577"/>
                        <TextBox x:Name="CreditsField"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="56" MaxHeight="100"
                                 FontSize="11"
                                 Background="#0A0A12"
                                 BorderBrush="#1E1E2C"
                                 Foreground="#CCCCDD"
                                 Watermark="Optional curated attribution or thanks for this asset."/>
                        <Button x:Name="SaveCreditsBtn"
                                Classes="secondary"
                                Content="Save Credits"
                                HorizontalAlignment="Left"
                                Click="OnSaveCredits"/>
                    </StackPanel>

                    <!-- Asset actions -->
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button x:Name="SetPreferredBtn" Classes="secondary" Content="Set Preferred"
                                IsEnabled="False" Click="OnSetPreferred"/>
                        <Button x:Name="ExcludeBtn"      Classes="secondary" Content="Exclude"
                                IsEnabled="False" Click="OnExclude"/>
                        <Button x:Name="RestoreBtn"      Classes="secondary" Content="Restore"
                                IsEnabled="False" Click="OnRestore"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button x:Name="OpenFileBtn"   Classes="secondary" Content="Open File"
                                IsEnabled="False" Click="OnOpenFile"/>
                        <Button x:Name="OpenFolderBtn" Classes="secondary" Content="Open Folder"
                                IsEnabled="False" Click="OnOpenFolder"/>
                        <Button x:Name="DeleteFileBtn" Classes="danger"    Content="Delete File"
                                IsEnabled="False" Click="OnDeleteFile"/>
                    </StackPanel>

                </StackPanel>
              </ScrollViewer>

              <!-- Empty-state placeholder when no asset is selected -->
              <TextBlock x:Name="DetailEmpty"
                         Text="Select an asset to view details."
                         FontSize="11" Foreground="#333348"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Top"
                         Margin="0,40,0,0"/>
            </Panel>

        </Grid>

        <!-- ── Add Media inline panel ───────────────────────────────────── -->
        <Border x:Name="AddMediaPanel"
                Grid.Row="2"
                IsVisible="False"
                Margin="20,10,20,0"
                Background="#0A0A12" BorderBrush="#2A2A3C"
                BorderThickness="1" CornerRadius="6"
                Padding="14,10">
            <StackPanel Spacing="8">
                <TextBlock Text="Add Media File" FontSize="11" FontWeight="SemiBold" Foreground="#CCCCDD"/>
                <TextBlock x:Name="AddMediaSourceLabel"
                           FontSize="11" Foreground="#888899"
                           TextTrimming="CharacterEllipsis"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Media type:" FontSize="11" Foreground="#888899"
                               VerticalAlignment="Center"/>
                    <ComboBox x:Name="AddMediaTypePicker"
                              FontSize="12" MinWidth="160"/>
                    <Button x:Name="AddMediaConfirmBtn"
                            Classes="action" Content="Add"
                            Click="OnAddMediaConfirm"/>
                    <Button Classes="secondary" Content="Cancel"
                            Click="OnAddMediaCancel"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ── Bottom bar ────────────────────────────────────────────────── -->
        <Border Grid.Row="3" Padding="20,10,20,14"
                BorderBrush="#181826" BorderThickness="0,1,0,0"
                Margin="0,10,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock x:Name="ValidationMsg"
                           Grid.Column="0"
                           IsVisible="False"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"
                           TextWrapping="Wrap"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Classes="action"
                            Content="Add Media…"
                            Click="OnAddMedia"/>
                    <Button Classes="secondary"
                            Content="Refresh"
                            Click="OnRefresh"/>
                    <Button Classes="secondary"
                            Content="Close"
                            Click="OnClose"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>
