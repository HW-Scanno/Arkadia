<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Arkadia.Startup.SplashWindow"
        Title=""
        SystemDecorations="None"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="WidthAndHeight">
    <!-- Root panel — opacity is animated instead of Window.Opacity to avoid DWM flicker -->
    <Grid x:Name="SplashRoot" Opacity="0">
        <Image x:Name="SplashImage" Stretch="None"/>
    </Grid>
</Window>
