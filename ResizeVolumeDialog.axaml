<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Arkadia.ResizeVolumeDialog"
        Width="420"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#0F0F14"
        FontFamily="Inter,Segoe UI,sans-serif">

    <Window.Styles>
        <Style Selector="Button.primary">
            <Setter Property="Background"   Value="#7B68EE"/>
            <Setter Property="Foreground"   Value="#FFFFFF"/>
            <Setter Property="Padding"      Value="20,8"/>
            <Setter Property="FontSize"     Value="13"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Cursor"       Value="Hand"/>
        </Style>
        <Style Selector="Button.secondary">
            <Setter Property="Background"   Value="#1E1E2C"/>
            <Setter Property="Foreground"   Value="#AAAACC"/>
            <Setter Property="Padding"      Value="20,8"/>
            <Setter Property="FontSize"     Value="13"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Cursor"       Value="Hand"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,Auto">
        <StackPanel Grid.Row="0" Margin="24,20,24,16" Spacing="12">
            <TextBlock x:Name="TitleLabel"
                       FontSize="14" FontWeight="SemiBold"
                       Foreground="#E8E8F0" TextWrapping="Wrap"/>
            <StackPanel Spacing="6">
                <TextBlock Text="New planned capacity (GB):"
                           FontSize="12" Foreground="#888899"/>
                <Grid ColumnDefinitions="*,8,Auto">
                    <TextBox Grid.Column="0"
                             x:Name="SizeInput"
                             FontSize="13"
                             Background="#1A1A24"
                             Foreground="#F0F0F0"
                             BorderBrush="#2A2A44"
                             BorderThickness="1"
                             Padding="8,6"
                             CornerRadius="4"
                             TextChanged="OnSizeChanged"/>
                    <Button Grid.Column="2"
                            Classes="secondary"
                            Content="Suggest Size"
                            Padding="12,6"
                            Click="OnSuggestSize"/>
                </Grid>
                <TextBlock x:Name="ErrorText"
                           FontSize="11" Foreground="#EF5350"
                           IsVisible="False"/>
            </StackPanel>
        </StackPanel>
        <Border Grid.Row="1" Padding="24,10,24,18"
                BorderBrush="#181826" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Classes="secondary" Content="Cancel"    Click="OnCancel"/>
                <Button x:Name="ConfirmBtn"
                        Classes="primary"   Content="Resize"
                        IsEnabled="False"
                        Click="OnConfirm"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
