<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lib="using:Arkadia.Library"
        xmlns:sys="using:Arkadia.Systems"
        xmlns:pend="using:Arkadia.Pending"
        xmlns:disks="using:Arkadia.Disks"
        xmlns:vols="using:Arkadia.Volumes"
        xmlns:data="using:Arkadia.Data"
        x:Class="Arkadia.MainWindow"
        Title="Arkadia"
        Width="1400" Height="785"
        MinWidth="800" MinHeight="565"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ArkBackground}"
        FontFamily="Inter,Segoe UI,sans-serif">

    <Window.Styles>

        <!-- ── Nav button ── -->
        <Style Selector="Button.nav">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="{DynamicResource ArkSurface}"/>
            <Setter Property="Foreground" Value="{DynamicResource ArkTextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                    <BrushTransition Property="Foreground" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.nav /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.nav:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.nav.active /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ArkAccent}"/>
        </Style>
        <Style Selector="Button.nav:pointerover">
            <Setter Property="Background" Value="#252547"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <Style Selector="Button.nav.active">
            <Setter Property="Background" Value="{DynamicResource ArkAccent}"/>
            <Setter Property="Foreground" Value="{DynamicResource ArkBackground}"/>
        </Style>
        <Style Selector="Button.nav.active:pointerover">
            <Setter Property="Background" Value="{DynamicResource ArkAccent}"/>
            <Setter Property="Foreground" Value="{DynamicResource ArkBackground}"/>
        </Style>
        <Style Selector="Button.nav.active:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ArkAccent}"/>
        </Style>

        <!-- ══════════════════════════════════════════════════════════
             Dashboard token styles
        ══════════════════════════════════════════════════════════════ -->

        <!-- Summary cards — slight 1px border separates them from the background -->
        <Style Selector="Border.card">
            <Setter Property="Background"       Value="{DynamicResource ArkSurface}"/>
            <Setter Property="CornerRadius"     Value="8"/>
            <Setter Property="Padding"          Value="20,18"/>
            <Setter Property="Margin"           Value="0,0,8,0"/>
            <Setter Property="BorderBrush"      Value="{DynamicResource ArkSurfaceAlt}"/>
            <Setter Property="BorderThickness"  Value="1"/>
        </Style>

        <!-- Widget section title — used in both summary cards and panel headers -->
        <Style Selector="TextBlock.widget-title">
            <Setter Property="FontSize"       Value="10"/>
            <Setter Property="FontWeight"     Value="SemiBold"/>
            <Setter Property="LetterSpacing"  Value="1.8"/>
            <Setter Property="Foreground"     Value="{DynamicResource ArkTextSecondary}"/>
            <Setter Property="Margin"         Value="0,0,0,14"/>
        </Style>

        <!-- Large hero value shown at the top of a summary card -->
        <Style Selector="TextBlock.card-value">
            <Setter Property="FontSize"   Value="26"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource ArkTextPrimary}"/>
            <Setter Property="Margin"     Value="0,0,0,2"/>
        </Style>

        <!-- Hairline separator between hero value and detail rows -->
        <Style Selector="Border.card-divider">
            <Setter Property="Height"     Value="1"/>
            <Setter Property="Background" Value="{DynamicResource ArkSurfaceAlt}"/>
            <Setter Property="Margin"     Value="0,8,0,10"/>
        </Style>

        <!-- Key column of a card detail row -->
        <Style Selector="TextBlock.card-key">
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource ArkTextSecondary}"/>
            <Setter Property="Margin"     Value="0,3"/>
        </Style>

        <!-- Value column of a card detail row -->
        <Style Selector="TextBlock.card-val">
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource ArkTextPrimary}"/>
            <Setter Property="Margin"     Value="0,3"/>
        </Style>

        <!-- Accented value (e.g. positive delta in recent-activity card) -->
        <Style Selector="TextBlock.card-val-accent">
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource ArkAccent}"/>
            <Setter Property="Margin"     Value="0,3"/>
        </Style>

        <!-- Column header row inside table panels -->
        <Style Selector="TextBlock.col-header">
            <Setter Property="FontSize"      Value="10"/>
            <Setter Property="FontWeight"    Value="SemiBold"/>
            <Setter Property="LetterSpacing" Value="1"/>
            <Setter Property="Foreground"    Value="{DynamicResource ArkTextSecondary}"/>
        </Style>

        <!-- ── Kept for backwards compat (not used in current markup) ── -->
        <Style Selector="TextBlock.card-title">
            <Setter Property="FontSize"      Value="10"/>
            <Setter Property="FontWeight"    Value="SemiBold"/>
            <Setter Property="LetterSpacing" Value="1.8"/>
            <Setter Property="Foreground"    Value="{DynamicResource ArkTextSecondary}"/>
            <Setter Property="Margin"        Value="0,0,0,14"/>
        </Style>

        <!-- ══════════════════════════════════════════════════════════
             Systems view styles
        ══════════════════════════════════════════════════════════════ -->

        <Style Selector="Button.view-toggle">
            <Setter Property="Padding"         Value="10,5"/>
            <Setter Property="CornerRadius"    Value="4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="#555566"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#AAAACC"/>
            <Setter Property="FontSize"        Value="12"/>
        </Style>
        <Style Selector="Button.view-toggle.active">
            <Setter Property="BorderBrush" Value="#666677"/>
            <Setter Property="Background"  Value="{DynamicResource ArkSurfaceAlt}"/>
            <Setter Property="Foreground"  Value="{DynamicResource ArkTextPrimary}"/>
        </Style>
        <Style Selector="Button.view-toggle /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.view-toggle:pointerover">
            <Setter Property="BorderBrush" Value="#7777AA"/>
        </Style>
        <Style Selector="Button.view-toggle:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1E1E2C"/>
        </Style>
        <Style Selector="Button.view-toggle:pressed">
            <Setter Property="BorderBrush" Value="#7B68EE"/>
        </Style>
        <Style Selector="Button.view-toggle:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#181826"/>
        </Style>
        <Style Selector="Button.view-toggle.danger">
            <Setter Property="BorderBrush" Value="#6B2020"/>
            <Setter Property="Foreground"  Value="#EF5350"/>
        </Style>
        <Style Selector="Button.view-toggle.danger:pointerover">
            <Setter Property="BorderBrush" Value="#EF5350"/>
        </Style>
        <Style Selector="Button.view-toggle.danger:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2A0A0A"/>
        </Style>

        <!-- ══════════════════════════════════════════════════════════
             Text action links (Update DAT, Delete, Open in Library, etc.)
        ══════════════════════════════════════════════════════════════ -->

        <Style Selector="TextBlock.text-action">
            <Setter Property="FontSize"          Value="12"/>
            <Setter Property="FontWeight"        Value="SemiBold"/>
            <Setter Property="TextDecorations"   Value="{x:Null}"/>
            <Setter Property="Cursor"            Value="Hand"/>
        </Style>
        <Style Selector="TextBlock.text-action:pointerover">
            <Setter Property="TextDecorations" Value="Underline"/>
        </Style>
        <Style Selector="TextBlock.text-action.accent">
            <Setter Property="Foreground" Value="#7B68EE"/>
        </Style>
        <Style Selector="TextBlock.text-action.accent:pointerover">
            <Setter Property="Foreground" Value="#9B8EFF"/>
        </Style>
        <Style Selector="TextBlock.text-action.danger">
            <Setter Property="Foreground" Value="#EF5350"/>
        </Style>
        <Style Selector="TextBlock.text-action.danger:pointerover">
            <Setter Property="Foreground" Value="#FF6B68"/>
        </Style>

        <!-- ══════════════════════════════════════════════════════════
             Library view styles
        ══════════════════════════════════════════════════════════════ -->

        <Style Selector="ListBox#LibraryList ListBoxItem">
            <Setter Property="Padding"         Value="0,9,0,9"/>
            <Setter Property="Margin"          Value="0"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
        </Style>
        <Style Selector="ListBox#LibraryList ListBoxItem /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding"    Value="0"/>
            <Setter Property="Margin"     Value="0"/>
        </Style>
        <Style Selector="ListBox#LibraryList ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ArkSurfaceAlt}"/>
        </Style>
        <Style Selector="ListBox#LibraryList ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="#1E1E3A"/>
        </Style>
        <Style Selector="ListBox#LibraryList ListBoxItem:selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#232347"/>
        </Style>

        <!-- VolumesList — zero horizontal theme padding so data grid aligns with header -->
        <Style Selector="ListBox#VolumesList ListBoxItem">
            <Setter Property="Padding"         Value="0,8"/>
            <Setter Property="Margin"          Value="0"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
        </Style>
        <Style Selector="ListBox#VolumesList ListBoxItem /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding"    Value="0"/>
            <Setter Property="Margin"     Value="0"/>
        </Style>
        <Style Selector="ListBox#VolumesList ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ArkSurfaceAlt}"/>
        </Style>
        <Style Selector="ListBox#VolumesList ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="#1E1E3A"/>
        </Style>
        <Style Selector="ListBox#VolumesList ListBoxItem:selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#232347"/>
        </Style>

    </Window.Styles>

    <!-- MainRoot opacity is animated on show; Window stays fully opaque to avoid DWM flicker -->
    <Grid x:Name="MainRoot" ColumnDefinitions="220,*">

        <!-- ══════════════════════════════ Sidebar ══════════════════════════════ -->
        <Border Grid.Column="0"
                Background="{DynamicResource ArkSurface}"
                BorderBrush="{DynamicResource ArkSurfaceAlt}"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Height="56" Padding="20,0">
                    <Panel VerticalAlignment="Center">
                        <Image x:Name="SidebarLogoImage"
                               MaxHeight="28"
                               HorizontalAlignment="Left"
                               IsVisible="False"
                               RenderOptions.BitmapInterpolationMode="HighQuality"/>
                        <TextBlock x:Name="SidebarLogoText"
                                   Text="ARKADIA"
                                   FontSize="14" FontWeight="Bold" LetterSpacing="3"
                                   Foreground="{DynamicResource ArkAccent}"/>
                    </Panel>
                </Border>
                <Border DockPanel.Dock="Top" Height="1" Margin="12,0,12,8"
                        Background="{DynamicResource ArkSurfaceAlt}"/>

                <StackPanel DockPanel.Dock="Bottom" Margin="8,8" Spacing="2">
                    <Border Height="1" Margin="4,0,4,6" Background="{DynamicResource ArkSurfaceAlt}"/>
                    <Button x:Name="NavLogs" Classes="nav" Tag="Logs" Click="OnNavClick">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <PathIcon Width="14" Height="14" Data="M0 0H1.5V14H0Z M3 2H14V4H3Z M3 7H14V9H3Z M3 12H11V14H3Z"/>
                            <TextBlock Text="Logs" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavSettings" Classes="nav" Tag="Settings" Click="OnNavClick">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <PathIcon Width="14" Height="14" Data="M5.5 0L6.5 2.5C5.3 3 4.2 3.8 3.4 4.9L1 4.2 0 6 1.4 7.1C1.3 7.4 1.3 7.7 1.3 8 1.3 8.3 1.4 8.6 1.4 8.9L0 10 1 11.8 3.4 11.1C4.2 12.2 5.3 13 6.5 13.5L5.5 16H8.5L7.5 13.5C8.7 13 9.8 12.2 10.6 11.1L13 11.8 14 10 12.6 8.9C12.7 8.6 12.7 8.3 12.7 8 12.7 7.7 12.6 7.4 12.6 7.1L14 6 13 4.2 10.6 4.9C9.8 3.8 8.7 3 7.5 2.5L8.5 0Z M7 5.5A2.5 2.5 0 1 0 7 10.5A2.5 2.5 0 0 0 7 5.5Z"/>
                            <TextBlock Text="Settings" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel DockPanel.Dock="Top" Margin="8,0" Spacing="2">
                    <Button x:Name="NavDashboard" Classes="nav active" Tag="Dashboard" Click="OnNavClick">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <PathIcon Width="14" Height="14" Data="M0 0H6V6H0Z M8 0H14V6H8Z M0 8H6V14H0Z M8 8H14V14H8Z"/>
                            <TextBlock Text="Dashboard" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavSystems" Classes="nav" Tag="Systems" Click="OnNavClick">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <PathIcon Width="14" Height="14" Data="M0 0H14V4H0Z M0 5H6V9H0Z M8 5H14V9H8Z M0 10H6V14H0Z M8 10H14V14H8Z"/>
                            <TextBlock Text="Systems" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavPending" Classes="nav" Tag="Pending" Click="OnNavClick">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <PathIcon Width="14" Height="14" Data="F1 M7 1A6 6 0 1 0 7 13A6 6 0 1 0 7 1Z M7 4V7.5L9.5 9"/>
                            <TextBlock Text="Pending" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavStaging" Classes="nav" Tag="Staging" Click="OnNavClick">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <PathIcon Width="14" Height="14" Data="M1 1H13V3H1Z M1 5H10V7H1Z M1 9H8V11H1Z M11 7L14 10.5L11 14V11.5H7V9H11Z"/>
                            <TextBlock Text="Staging" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavLibrary" Classes="nav" Tag="Library" Click="OnNavClick">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <PathIcon Width="14" Height="14" Data="M0 1H14V3H0Z M0 6H14V8H0Z M0 11H14V13H0Z"/>
                            <TextBlock Text="Library" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavVolumes" Classes="nav" Tag="Volumes" Click="OnNavClick">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <PathIcon Width="14" Height="14" Data="M2 3C2 1.9 4.2 1 7 1 9.8 1 12 1.9 12 3L12 11C12 12.1 9.8 13 7 13 4.2 13 2 12.1 2 11Z M2 3C2 4.1 4.2 5 7 5 9.8 5 12 4.1 12 3"/>
                            <TextBlock Text="Volumes" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavDisks" Classes="nav" Tag="Disks" Click="OnNavClick">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <PathIcon Width="14" Height="14" Data="F1 M7 0A7 7 0 1 0 7 14A7 7 0 1 0 7 0Z M7 3.5A3.5 3.5 0 1 0 7 10.5A3.5 3.5 0 1 0 7 3.5Z"/>
                            <TextBlock Text="Disks" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavOperations" Classes="nav" Tag="Operations" Click="OnNavClick">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <PathIcon Width="14" Height="14" Data="M0 0H4V4H0Z M6 1H14V3H6Z M0 5H4V9H0Z M6 6H14V8H6Z M0 10H4V14H0Z M6 11H14V13H6Z"/>
                            <TextBlock Text="Operations" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavAnalytics" Classes="nav" Tag="Analytics" Click="OnNavClick">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <PathIcon Width="14" Height="14" Data="M0 10H2V14H0Z M3 7H5V14H3Z M6 4H8V14H6Z M9 1H11V14H9Z M12 5H14V14H12Z"/>
                            <TextBlock Text="Analytics" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ══════════════════════════════ Main area ══════════════════════════════ -->
        <Grid Grid.Column="1" RowDefinitions="56,*">

            <!-- Header bar -->
            <Border Grid.Row="0"
                    Background="{DynamicResource ArkSurface}"
                    BorderBrush="{DynamicResource ArkSurfaceAlt}"
                    BorderThickness="0,0,0,1"
                    Padding="24,0">
                <TextBlock x:Name="PageTitle"
                           Text="Dashboard"
                           FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource ArkTextPrimary}"
                           VerticalAlignment="Center"/>
            </Border>

            <!-- ── Dashboard content ── -->
            <ScrollViewer x:Name="ViewDashboard"
                          Grid.Row="1"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="28,24,28,32" Spacing="20">

                    <!-- Refresh -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,4">
                        <Button Content="Refresh" Classes="view-toggle" Click="OnDashboardRefresh"/>
                    </StackPanel>

                    <!-- ════ ARCHIVE OVERVIEW ════ -->
                    <TextBlock Text="ARCHIVE OVERVIEW"
                               FontSize="10" FontWeight="SemiBold" LetterSpacing="1.5"
                               Foreground="#555566" Margin="0,0,0,0"/>

                    <UniformGrid Rows="1">

                        <!-- Platforms -->
                        <Border Classes="card">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="widget-title" Text="PLATFORMS"/>
                                <TextBlock x:Name="DashPlatformsCount" Classes="card-value" Text="—"/>
                            </StackPanel>
                        </Border>

                        <!-- DAT Lines -->
                        <Border Classes="card">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="widget-title" Text="DAT LINES"/>
                                <TextBlock x:Name="DashDatLinesCount" Classes="card-value" Text="—"/>
                            </StackPanel>
                        </Border>

                        <!-- Releases -->
                        <Border Classes="card">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="widget-title" Text="RELEASES"/>
                                <TextBlock x:Name="DashReleasesCount" Classes="card-value" Text="—"/>
                            </StackPanel>
                        </Border>

                        <!-- Artifacts Stored -->
                        <Border Classes="card">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="widget-title" Text="ARTIFACTS STORED"/>
                                <TextBlock x:Name="DashArtifactsCount" Classes="card-value" Text="—"/>
                            </StackPanel>
                        </Border>

                        <!-- Volumes -->
                        <Border Classes="card">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="widget-title" Text="VOLUMES"/>
                                <TextBlock x:Name="DashVolumesCount" Classes="card-value" Text="—"/>
                            </StackPanel>
                        </Border>

                        <!-- Disks -->
                        <Border Classes="card">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="widget-title" Text="DISKS"/>
                                <TextBlock x:Name="DashDisksCount" Classes="card-value" Text="—"/>
                            </StackPanel>
                        </Border>

                    </UniformGrid>

                    <!-- ════ INTEGRITY &amp; ATTENTION ════ -->
                    <TextBlock Text="INTEGRITY &amp; ATTENTION"
                               FontSize="10" FontWeight="SemiBold" LetterSpacing="1.5"
                               Foreground="#555566" Margin="0,8,0,0"/>

                    <UniformGrid Rows="1">

                        <!-- Volume Health -->
                        <Border Classes="card">
                            <StackPanel Spacing="0">
                                <TextBlock Classes="widget-title" Text="VOLUME HEALTH"/>
                                <Border Classes="card-divider"/>
                                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                                    <TextBlock Grid.Column="0" Classes="card-key" Text="OK"/>
                                    <TextBlock Grid.Column="1" x:Name="DashVolOk" Classes="card-val" Text="—"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                                    <TextBlock Grid.Column="0" Classes="card-key" Text="Critical"/>
                                    <TextBlock Grid.Column="1" x:Name="DashVolCrit" Classes="card-val-accent" Text="—"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Classes="card-key" Text="Lost"/>
                                    <TextBlock Grid.Column="1" x:Name="DashVolLost" Classes="card-val-accent" Text="—"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Release Status -->
                        <Border Classes="card">
                            <StackPanel Spacing="0">
                                <TextBlock Classes="widget-title" Text="RELEASE STATUS"/>
                                <Border Classes="card-divider"/>
                                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                                    <TextBlock Grid.Column="0" Classes="card-key" Text="Disks Lost"/>
                                    <TextBlock Grid.Column="1" x:Name="DashDiskLost" Classes="card-val-accent" Text="—"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                                    <TextBlock Grid.Column="0" Classes="card-key" Text="Missing"/>
                                    <TextBlock Grid.Column="1" x:Name="DashRelMissing" Classes="card-val-accent" Text="—"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                                    <TextBlock Grid.Column="0" Classes="card-key" Text="Pending"/>
                                    <TextBlock Grid.Column="1" x:Name="DashRelPending" Classes="card-val" Text="—"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Classes="card-key" Text="Outdated"/>
                                    <TextBlock Grid.Column="1" x:Name="DashRelOutdated" Classes="card-val" Text="—"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Tools -->
                        <Border Classes="card">
                            <StackPanel Spacing="0">
                                <TextBlock Classes="widget-title" Text="TOOLS"/>
                                <Border Classes="card-divider"/>
                                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                                    <TextBlock Grid.Column="0" Classes="card-key" Text="Built-In"/>
                                    <TextBlock Grid.Column="1" x:Name="DashToolsBuiltIn" Classes="card-val" Text="—"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                                    <TextBlock Grid.Column="0" Classes="card-key" Text="Present"/>
                                    <TextBlock Grid.Column="1" x:Name="DashToolsPresent" Classes="card-val" Text="—"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Classes="card-key" Text="Missing"/>
                                    <TextBlock Grid.Column="1" x:Name="DashToolsMissing" Classes="card-val-accent" Text="—"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                    </UniformGrid>

                    <!-- ════ LATEST LOG OPERATIONS ════ -->
                    <TextBlock Text="LATEST LOG OPERATIONS"
                               FontSize="10" FontWeight="SemiBold" LetterSpacing="1.5"
                               Foreground="#555566" Margin="0,8,0,0"/>

                    <Border Background="{DynamicResource ArkSurface}"
                            BorderBrush="{DynamicResource ArkSurfaceAlt}"
                            BorderThickness="1" CornerRadius="8" Padding="22,16">
                        <StackPanel x:Name="DashLatestLogsPanel" Spacing="0"/>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ── Systems view ── -->
            <!-- ── Systems view ── -->
            <Grid x:Name="ViewSystems"
                  Grid.Row="1"
                  IsVisible="False"
                  RowDefinitions="Auto,*">

                <!-- Unified action bar -->
                <Border Grid.Row="0"
                        Padding="16,9"
                        Background="{DynamicResource ArkSurface}"
                        BorderBrush="{DynamicResource ArkSurfaceAlt}"
                        BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button x:Name="SysActCreatePlatform" Classes="view-toggle"
                                Content="Create Platform" Click="OnCreatePlatform"/>
                        <Button x:Name="SysActEditPlatform"   Classes="view-toggle"
                                Content="Edit Platform"   Click="OnEditPlatform"/>
                        <Border Width="1" Background="{DynamicResource ArkSurfaceAlt}"
                                Margin="10,2" VerticalAlignment="Stretch"/>
                        <Button x:Name="SysActImportDat"    Classes="view-toggle"
                                Content="Import DAT"    Click="OnImportDat"/>
                        <Button x:Name="SysActConfigureDat" Classes="view-toggle"
                                Content="Configure DAT" Click="OnSysConfigureDat"/>
                        <Button x:Name="SysActUpdateDat"    Classes="view-toggle"
                                Content="Update DAT"    Click="OnSysUpdateDat"/>
                        <Button x:Name="SysActVerifyDat"    Classes="view-toggle"
                                Content="Verify DAT"    Click="OnSysVerifyDat"/>
                        <Button x:Name="SysActDeleteDat"    Classes="view-toggle danger"
                                Content="Delete DAT"    Click="OnSysDeleteDat"/>
                        <Border Width="1" Background="{DynamicResource ArkSurfaceAlt}"
                                Margin="10,2" VerticalAlignment="Stretch"/>
                        <Button x:Name="SysActIngestFiles" Classes="view-toggle"
                                Content="Ingest Files"  Click="OnSysIngestFiles"/>
                    </StackPanel>
                </Border>

                <!-- Center tree + detail pane -->
                <Grid Grid.Row="1" ColumnDefinitions="*,1,370">

                    <!-- Col 0: hierarchical Platform → DAT tree (built in code-behind) -->
                    <ScrollViewer Grid.Column="0"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="SystemsTreePanel"
                                    Margin="20,14,20,20" Spacing="6"/>
                    </ScrollViewer>

                    <!-- Col 1: vertical divider -->
                    <Border Grid.Column="1" Background="{DynamicResource ArkSurfaceAlt}"/>

                    <!-- Col 2: contextual read-only detail pane, 420px, built in code-behind -->
                    <Grid Grid.Column="2" Background="{DynamicResource ArkSurface}">
                        <TextBlock x:Name="SystemsDetailEmptyMsg"
                                   Text="Select a platform to view details"
                                   TextAlignment="Center" TextWrapping="Wrap"
                                   FontSize="12" Foreground="{DynamicResource ArkTextSecondary}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="SystemsDetailPanel"
                                        Margin="16,16,16,16" Spacing="0"/>
                        </ScrollViewer>
                    </Grid><!-- /detail pane -->

                </Grid><!-- /center+detail -->

            </Grid><!-- /ViewSystems -->

            <!-- ── Library view ── -->
            <Grid x:Name="ViewLibrary"
                  Grid.Row="1"
                  IsVisible="False"
                  RowDefinitions="Auto,*">

                <!-- Toolbar: context selectors | search | row filters + count -->
                <Border Grid.Row="0"
                        Padding="20,10"
                        Background="{DynamicResource ArkSurface}"
                        BorderBrush="{DynamicResource ArkSurfaceAlt}"
                        BorderThickness="0,0,0,1">
                    <DockPanel>

                        <!-- Context selectors — docked left, drive the active dataset -->
                        <ComboBox x:Name="LibraryContextPlatform"
                                  DockPanel.Dock="Left"
                                  MinWidth="150"
                                  FontSize="13"
                                  Margin="0,0,8,0"
                                  SelectionChanged="OnLibraryContextPlatformChanged"/>

                        <ComboBox x:Name="LibraryContextDatLine"
                                  DockPanel.Dock="Left"
                                  MinWidth="200"
                                  FontSize="13"
                                  Margin="0,0,16,0"
                                  SelectionChanged="OnLibraryContextDatLineChanged"/>

                        <!-- Row-level filters + count — docked right -->
                        <TextBlock x:Name="LibraryCountText"
                                   DockPanel.Dock="Right"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Foreground="{DynamicResource ArkTextSecondary}"
                                   Margin="16,0,0,0"/>

                        <ComboBox x:Name="LibraryStatusFilter"
                                  DockPanel.Dock="Right"
                                  MinWidth="120"
                                  FontSize="13"
                                  Margin="8,0,0,0"
                                  SelectionChanged="OnLibraryFilterChanged"/>

                        <!-- Search fills remaining space -->
                        <TextBox x:Name="LibrarySearchBox"
                                 Watermark="Search by name…"
                                 FontSize="13"
                                 TextChanged="OnLibrarySearchChanged"/>

                    </DockPanel>
                </Border>

                <!-- List + detail side-by-side -->
                <Grid Grid.Row="1" ColumnDefinitions="*,1,500">

                    <!-- List: column headers + rows -->
                    <Grid Grid.Column="0" RowDefinitions="Auto,*">

                        <Border Grid.Row="0"
                                Padding="24,10"
                                BorderBrush="{DynamicResource ArkSurfaceAlt}"
                                BorderThickness="0,0,0,1">
                            <Grid ColumnDefinitions="68,40,*,56,146">
                                <TextBlock Grid.Column="0" Classes="col-header" Text="STATUS"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Classes="col-header" Text="TIER"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Classes="col-header" Text="NAME"/>
                                <TextBlock Grid.Column="3" Classes="col-header" Text="REGION"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Classes="col-header" Text="LANGUAGES"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>

                        <ListBox x:Name="LibraryList"
                                 Grid.Row="1"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="OnLibrarySelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="lib:LibraryEntry">
                                    <Grid ColumnDefinitions="68,40,*,56,146" Margin="24,0,24,0">
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Status}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding StatusBrush}"
                                                   TextAlignment="Center"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding TierDisplay}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding TierBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="2"
                                                    Orientation="Horizontal"
                                                    Spacing="6"
                                                    VerticalAlignment="Center">
                                            <Border Background="#112233" CornerRadius="3"
                                                    Padding="4,1"
                                                    IsVisible="{Binding IsNew}"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="NEW" FontSize="9" FontWeight="SemiBold"
                                                           Foreground="#29B6F6" LetterSpacing="0.8"/>
                                            </Border>
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="13"
                                                       Foreground="{DynamicResource ArkTextPrimary}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding Region}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource ArkTextSecondary}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                        <ItemsControl Grid.Column="4"
                                                      ItemsSource="{Binding FlagImages}"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="2"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Image Source="{Binding}"
                                                           Width="20" Height="14"
                                                           Stretch="Uniform"
                                                           RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                    </Grid><!-- /list column -->

                    <!-- Vertical divider -->
                    <Border Grid.Column="1"
                            Background="{DynamicResource ArkSurfaceAlt}"/>

                    <!-- Detail panel -->
                    <Grid Grid.Column="2"
                          Background="{DynamicResource ArkSurface}">

                        <!-- Empty state -->
                        <TextBlock x:Name="DetailEmptyState"
                                   Text="Select an item&#x0a;to view details"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="{DynamicResource ArkTextSecondary}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                        <!-- Populated state — scrollable when file lists are long -->
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="DetailContent"
                                        IsVisible="False"
                                        Margin="24,22,24,22"
                                        Spacing="0">

                                <TextBlock Classes="widget-title" Text="DETAILS"/>

                                <!-- Name — full width, wraps -->
                                <TextBlock x:Name="DetailName"
                                           FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource ArkTextPrimary}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,18"/>

                                <Border Classes="card-divider" Margin="0,0,0,12"/>

                                <!-- Metadata field rows -->
                                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                                    <TextBlock Grid.Column="0" Classes="card-key" Text="Platform"  Margin="0"/>
                                    <TextBlock Grid.Column="1" x:Name="DetailPlatform" Classes="card-val" Margin="0"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,8">
                                    <TextBlock Grid.Column="0" Classes="card-key" Text="Status" Margin="0"/>
                                    <TextBlock Grid.Column="1" x:Name="DetailStatusText"
                                               FontSize="12" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                    <Border Grid.Column="2" x:Name="DetailNewBadge"
                                            IsVisible="False"
                                            Background="#112233" CornerRadius="3"
                                            Padding="5,2" VerticalAlignment="Center">
                                        <TextBlock Text="NEW" FontSize="9" FontWeight="SemiBold"
                                                   Foreground="#29B6F6" LetterSpacing="0.8"/>
                                    </Border>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                                    <TextBlock Grid.Column="0" Classes="card-key" Text="Tier"      Margin="0"/>
                                    <TextBlock Grid.Column="1" x:Name="DetailTier" FontSize="12" FontWeight="SemiBold" Margin="0"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                                    <TextBlock Grid.Column="0" Classes="card-key" Text="Region"    Margin="0"/>
                                    <TextBlock Grid.Column="1" x:Name="DetailRegion"    Classes="card-val" Margin="0"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                                    <TextBlock Grid.Column="0" Classes="card-key" Text="Languages" Margin="0"/>
                                    <TextBlock Grid.Column="1" x:Name="DetailLanguages" Classes="card-val" Margin="0"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                                    <TextBlock Grid.Column="0" Classes="card-key" Text="Format"    Margin="0"/>
                                    <TextBlock Grid.Column="1" x:Name="DetailFormat"   Classes="card-val" Margin="0"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Classes="card-key" Text="Size"      Margin="0"/>
                                    <TextBlock Grid.Column="1" x:Name="DetailSize"     Classes="card-val" Margin="0"/>
                                </Grid>

                                <!-- SOURCE FILES section -->
                                <Border Classes="card-divider" Margin="0,16,0,14"/>
                                <TextBlock Classes="widget-title" Text="SOURCE FILES" Margin="0,0,0,10"/>
                                <StackPanel x:Name="DetailSourceFiles" Spacing="10"/>

                                <!-- DERIVED FILES section -->
                                <Border Classes="card-divider" Margin="0,16,0,14"/>
                                <TextBlock Classes="widget-title" Text="DERIVED FILES" Margin="0,0,0,10"/>
                                <StackPanel x:Name="DetailDerivedFiles" Spacing="10"/>

                                <!-- PREVIOUSLY SEEN IN section -->
                                <Border x:Name="DetailOverlapDivider" Classes="card-divider" Margin="0,16,0,14" IsVisible="False"/>
                                <TextBlock x:Name="DetailOverlapTitle" Classes="widget-title" Text="PREVIOUSLY SEEN IN" Margin="0,0,0,10" IsVisible="False"/>
                                <StackPanel x:Name="DetailOverlapList" Spacing="6" IsVisible="False"/>

                                <!-- STORAGE section -->
                                <Border x:Name="DetailStorageDivider" Classes="card-divider" Margin="0,16,0,14" IsVisible="False"/>
                                <TextBlock x:Name="DetailStorageTitle" Classes="widget-title" Text="STORAGE" Margin="0,0,0,10" IsVisible="False"/>
                                <StackPanel x:Name="DetailStorageList" Spacing="6" IsVisible="False"/>

                                <!-- DEBUG INFO section (visibility controlled by show_debug_artifact_info setting) -->
                                <Border x:Name="DetailDebugDivider"    Classes="card-divider" Margin="0,16,0,14" IsVisible="False"/>
                                <TextBlock x:Name="DetailDebugTitle"   Classes="widget-title" Text="DEBUG INFO" Margin="0,0,0,10" IsVisible="False"/>
                                <StackPanel x:Name="DetailArtifacts"   Spacing="10" IsVisible="False"/>
                                <TextBlock x:Name="DetailArtifactsEmpty"
                                           IsVisible="False"
                                           Text="No debug artifact data"
                                           FontSize="12"
                                           Foreground="{DynamicResource ArkTextSecondary}"/>

                            </StackPanel>
                        </ScrollViewer>

                        <!-- Copy toast — floats at bottom of detail panel -->
                        <Border x:Name="CopyToastBorder"
                                IsVisible="False"
                                VerticalAlignment="Bottom"
                                HorizontalAlignment="Stretch"
                                Background="#12121C"
                                BorderBrush="#2A2A44"
                                BorderThickness="0,1,0,0"
                                Padding="16,7"
                                ZIndex="20">
                            <TextBlock x:Name="CopyToastText"
                                       FontSize="11"
                                       Foreground="#7A7A99"
                                       TextTrimming="CharacterEllipsis"/>
                        </Border>

                    </Grid><!-- /detail panel -->

                </Grid><!-- /list+detail -->

            </Grid><!-- /ViewLibrary -->

            <!-- ── Pending view ── -->
            <Grid x:Name="ViewPending"
                  Grid.Row="1"
                  IsVisible="False"
                  RowDefinitions="Auto,*">

                <!-- Toolbar -->
                <Border Grid.Row="0"
                        Padding="20,10"
                        Background="{DynamicResource ArkSurface}"
                        BorderBrush="{DynamicResource ArkSurfaceAlt}"
                        BorderThickness="0,0,0,1">
                    <DockPanel>
                        <TextBlock x:Name="PendingCountText"
                                   DockPanel.Dock="Right"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Foreground="{DynamicResource ArkTextSecondary}"/>
                        <TextBlock Text="Pending Reconciliations"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   Foreground="{DynamicResource ArkTextSecondary}"/>
                    </DockPanel>
                </Border>

                <!-- List + detail -->
                <Grid Grid.Row="1" ColumnDefinitions="*,1,500">

                    <!-- List column -->
                    <Grid Grid.Column="0" RowDefinitions="Auto,*">

                        <!-- Column headers -->
                        <Border Grid.Row="0"
                                Padding="24,10"
                                BorderBrush="{DynamicResource ArkSurfaceAlt}"
                                BorderThickness="0,0,0,1">
                            <Grid ColumnDefinitions="*,130,90,100,80">
                                <TextBlock Grid.Column="0" Classes="col-header" Text="RELEASE"/>
                                <TextBlock Grid.Column="1" Classes="col-header" Text="DAT LINE"/>
                                <TextBlock Grid.Column="2" Classes="col-header" Text="PLATFORM"/>
                                <TextBlock Grid.Column="3" Classes="col-header" Text="REASON"/>
                                <TextBlock Grid.Column="4" Classes="col-header" Text="CREATED" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>

                        <!-- Empty state -->
                        <TextBlock x:Name="PendingListEmpty"
                                   Grid.Row="1"
                                   IsVisible="False"
                                   Text="No pending reconciliations"
                                   TextAlignment="Center"
                                   FontSize="12"
                                   Foreground="{DynamicResource ArkTextSecondary}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                        <!-- Rows -->
                        <ListBox x:Name="PendingList"
                                 Grid.Row="1"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="OnPendingSelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="pend:PendingItem">
                                    <Grid ColumnDefinitions="*,130,90,100,80" Margin="24,0,24,0">
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding ReleaseName}"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource ArkTextPrimary}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding DatLineName}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource ArkTextSecondary}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding PlatformName}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource ArkTextSecondary}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding ReasonDisplay}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource ArkTextSecondary}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="4"
                                                   Text="{Binding CreatedLabel}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource ArkTextSecondary}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                    </Grid><!-- /list column -->

                    <!-- Vertical divider -->
                    <Border Grid.Column="1"
                            Background="{DynamicResource ArkSurfaceAlt}"/>

                    <!-- Detail panel -->
                    <Grid Grid.Column="2"
                          Background="{DynamicResource ArkSurface}">

                        <TextBlock x:Name="PendingDetailEmptyState"
                                   Text="Select an item&#x0a;to view details"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="{DynamicResource ArkTextSecondary}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="PendingDetailContent"
                                        IsVisible="False"
                                        Margin="24,22,24,22"
                                        Spacing="0">

                                <TextBlock Classes="widget-title" Text="PENDING RECONCILIATION"/>

                                <TextBlock x:Name="PendingDetailReleaseName"
                                           FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource ArkTextPrimary}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,18"/>

                                <Border Classes="card-divider" Margin="0,0,0,12"/>

                                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                                    <TextBlock Grid.Column="0" Classes="card-key" Text="DAT Line" Margin="0"/>
                                    <TextBlock Grid.Column="1" x:Name="PendingDetailDatLine" Classes="card-val" Margin="0"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                                    <TextBlock Grid.Column="0" Classes="card-key" Text="Platform" Margin="0"/>
                                    <TextBlock Grid.Column="1" x:Name="PendingDetailPlatform" Classes="card-val" Margin="0"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                                    <TextBlock Grid.Column="0" Classes="card-key" Text="Reason" Margin="0"/>
                                    <TextBlock Grid.Column="1" x:Name="PendingDetailReason" Classes="card-val" Margin="0"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                                    <TextBlock Grid.Column="0" Classes="card-key" Text="Status" Margin="0"/>
                                    <TextBlock Grid.Column="1" x:Name="PendingDetailStatus" Classes="card-val" Margin="0"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Classes="card-key" Text="Created" Margin="0"/>
                                    <TextBlock Grid.Column="1" x:Name="PendingDetailCreated" Classes="card-val" Margin="0"/>
                                </Grid>

                                <!-- NEW RELEASE -->
                                <Border Classes="card-divider" Margin="0,16,0,14"/>
                                <TextBlock Classes="widget-title" Text="NEW RELEASE" Margin="0,0,0,10"/>
                                <StackPanel x:Name="PendingDetailNewRelease" Spacing="8"/>

                                <!-- MATCHED OUTDATED RELEASE (shown when OutdatedRelease is set) -->
                                <Border x:Name="PendingDetailOutdatedDivider"
                                        Classes="card-divider" Margin="0,16,0,14" IsVisible="False"/>
                                <TextBlock x:Name="PendingDetailOutdatedTitle"
                                           Classes="widget-title" Text="MATCHED OUTDATED RELEASE"
                                           Margin="0,0,0,10" IsVisible="False"/>
                                <StackPanel x:Name="PendingDetailOutdated" Spacing="8" IsVisible="False"/>

                                <!-- TARGET -->
                                <Border Classes="card-divider" Margin="0,16,0,14"/>
                                <TextBlock Classes="widget-title" Text="TARGET" Margin="0,0,0,10"/>
                                <StackPanel x:Name="PendingDetailTarget" Spacing="8"/>

                                <!-- PHYSICAL LOCATOR (shown when any locator field is set) -->
                                <Border x:Name="PendingDetailLocatorDivider"
                                        Classes="card-divider" Margin="0,16,0,14" IsVisible="False"/>
                                <TextBlock x:Name="PendingDetailLocatorTitle"
                                           Classes="widget-title" Text="PHYSICAL LOCATOR"
                                           Margin="0,0,0,10" IsVisible="False"/>
                                <StackPanel x:Name="PendingDetailLocator" Spacing="8" IsVisible="False"/>

                            </StackPanel>
                        </ScrollViewer>

                    </Grid><!-- /detail panel -->

                </Grid><!-- /list+detail -->

            </Grid><!-- /ViewPending -->

            <!-- ══════════════════════════ Staging view ══════════════════════════ -->
            <Grid x:Name="ViewStaging"
                  Grid.Row="1"
                  IsVisible="False"
                  RowDefinitions="Auto,Auto,*">

                <!-- Toolbar -->
                <Border Grid.Row="0"
                        Padding="20,10"
                        Background="{DynamicResource ArkSurface}"
                        BorderBrush="{DynamicResource ArkSurfaceAlt}"
                        BorderThickness="0,0,0,1">
                    <DockPanel>
                        <TextBlock x:Name="StagingCountText"
                                   DockPanel.Dock="Right"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Foreground="{DynamicResource ArkTextSecondary}"/>
                        <TextBlock Text="Pending Assembly"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   Foreground="{DynamicResource ArkTextSecondary}"/>
                    </DockPanel>
                </Border>

                <!-- Summary card -->
                <Border Grid.Row="1"
                        Margin="20,12,20,0"
                        Background="{DynamicResource ArkSurface}"
                        BorderBrush="{DynamicResource ArkSurfaceAlt}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="16,12">
                    <Grid ColumnDefinitions="*,*,*">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="FILES PRESENT" FontSize="9" LetterSpacing="1.2"
                                       Foreground="#555566"/>
                            <TextBlock x:Name="StagingSumFiles"
                                       Text="0" FontSize="20" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ArkTextPrimary}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="SIZE IN GB" FontSize="9" LetterSpacing="1.2"
                                       Foreground="#555566"/>
                            <TextBlock x:Name="StagingSumSize"
                                       Text="0.00 GB" FontSize="20" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ArkTextPrimary}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="2">
                            <TextBlock Text="INCOMPLETE RELEASES" FontSize="9" LetterSpacing="1.2"
                                       Foreground="#555566"/>
                            <TextBlock x:Name="StagingSumReleases"
                                       Text="0" FontSize="20" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ArkTextPrimary}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Tree + detail -->
                <Grid Grid.Row="2" Margin="0,12,0,0" ColumnDefinitions="*,1,500">

                    <!-- Left: tree -->
                    <Grid Grid.Column="0" RowDefinitions="Auto,*">

                        <!-- Column header -->
                        <Border Grid.Row="0"
                                Padding="20,8"
                                BorderBrush="{DynamicResource ArkSurfaceAlt}"
                                BorderThickness="0,0,0,1">
                            <Grid ColumnDefinitions="*,80">
                                <TextBlock Grid.Column="0" Classes="col-header" Text="RELEASE"/>
                                <TextBlock Grid.Column="1" Classes="col-header" Text="PROGRESS"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>

                        <!-- Empty state -->
                        <TextBlock x:Name="StagingTreeEmpty"
                                   Grid.Row="1"
                                   IsVisible="True"
                                   Text="No incomplete releases in staging"
                                   TextAlignment="Center"
                                   FontSize="12"
                                   Foreground="{DynamicResource ArkTextSecondary}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                        <!-- Tree scroll area -->
                        <ScrollViewer x:Name="StagingTreeScroll"
                                      Grid.Row="1"
                                      IsVisible="False"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="StagingTree"
                                        Margin="0,8,0,16"
                                        Spacing="0"/>
                        </ScrollViewer>

                    </Grid>

                    <!-- Splitter -->
                    <Border Grid.Column="1"
                            Background="{DynamicResource ArkSurfaceAlt}"/>

                    <!-- Right: detail panel -->
                    <Grid Grid.Column="2">
                        <!-- Empty state -->
                        <TextBlock x:Name="StagingDetailEmpty"
                                   Text="Select a release&#x0a;to view details"
                                   TextAlignment="Center" TextWrapping="Wrap"
                                   FontSize="12" Foreground="{DynamicResource ArkTextSecondary}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="StagingDetailContent"
                                        IsVisible="False"
                                        Margin="20,18,20,18"
                                        Spacing="0">

                                <!-- Header -->
                                <TextBlock Classes="widget-title" Text="RELEASE"/>
                                <TextBlock x:Name="StagingDetailName"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource ArkTextPrimary}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,14"/>
                                <Border Classes="card-divider" Margin="0,0,0,10"/>

                                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                                    <TextBlock Grid.Column="0" Classes="card-key" Text="Platform" Margin="0"/>
                                    <TextBlock Grid.Column="1" x:Name="StagingDetailPlatform" Classes="card-val" Margin="0"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                                    <TextBlock Grid.Column="0" Classes="card-key" Text="DAT Line" Margin="0"/>
                                    <TextBlock Grid.Column="1" x:Name="StagingDetailDatLine"
                                               FontSize="11" FontFamily="Consolas,Courier New,monospace"
                                               Foreground="#E07040" Margin="0"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                                    <TextBlock Grid.Column="0" Classes="card-key" Text="Progress" Margin="0"/>
                                    <TextBlock Grid.Column="1" x:Name="StagingDetailProgress" Classes="card-val" Margin="0"/>
                                </Grid>

                                <!-- Files section -->
                                <Border Classes="card-divider" Margin="0,0,0,10"/>
                                <TextBlock Classes="widget-title" Text="FILES" Margin="0,0,0,8"/>

                                <StackPanel x:Name="StagingDetailFiles" Spacing="4"/>

                                <!-- Actions -->
                                <Border Classes="card-divider" Margin="0,14,0,12"/>
                                <Button x:Name="StagingOpenFolderBtn"
                                        Content="Open Folder"
                                        Background="{DynamicResource ArkSurface}"
                                        Foreground="{DynamicResource ArkTextPrimary}"
                                        BorderBrush="{DynamicResource ArkSurfaceAlt}"
                                        BorderThickness="1"
                                        Padding="14,7" CornerRadius="5"
                                        HorizontalAlignment="Left"
                                        Click="OnStagingOpenFolder"/>

                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                </Grid>

            </Grid><!-- /ViewStaging -->

            <!-- ══════════════════════════ Disks view ══════════════════════════ -->
            <Grid x:Name="ViewDisks"
                  Grid.Row="1"
                  IsVisible="False"
                  RowDefinitions="Auto,*">

                <!-- Toolbar -->
                <Border Grid.Row="0"
                        Padding="20,10"
                        Background="{DynamicResource ArkSurface}"
                        BorderBrush="{DynamicResource ArkSurfaceAlt}"
                        BorderThickness="0,0,0,1">
                    <DockPanel>
                        <Button DockPanel.Dock="Left"
                                Content="Add Disk"
                                Classes="view-toggle"
                                Margin="0,0,8,0"
                                Click="OnAddDisk"/>
                        <Button DockPanel.Dock="Left"
                                Content="Initialize Disk"
                                Classes="view-toggle"
                                Margin="0,0,8,0"
                                Click="OnInitializeDisk"/>
                        <Button DockPanel.Dock="Left"
                                Content="Reinitialize Disk"
                                Classes="view-toggle"
                                Margin="0,0,8,0"
                                Click="OnReinitializeDisk"/>
                        <Button DockPanel.Dock="Left"
                                Content="Mark Lost"
                                Classes="view-toggle"
                                Margin="0,0,8,0"
                                Click="OnMarkDiskLost"/>
                        <TextBlock x:Name="DisksCountText"
                                   DockPanel.Dock="Right"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Foreground="{DynamicResource ArkTextSecondary}"
                                   Margin="16,0,0,0"/>
                        <TextBox x:Name="DisksSearchBox"
                                 Watermark="Search disks…"
                                 FontSize="13"
                                 TextChanged="OnDisksSearchChanged"/>
                    </DockPanel>
                </Border>

                <!-- List + detail -->
                <Grid Grid.Row="1" ColumnDefinitions="*,1,370">

                    <!-- Table -->
                    <Grid Grid.Column="0" RowDefinitions="Auto,*">

                        <Border Grid.Row="0"
                                Padding="20,8"
                                BorderBrush="{DynamicResource ArkSurfaceAlt}"
                                BorderThickness="0,0,0,1">
                            <Grid ColumnDefinitions="52,*,90,90,90,100,140,90">
                                <TextBlock Grid.Column="0" Classes="col-header" Text="STATUS" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Classes="col-header" Text="LABEL"/>
                                <TextBlock Grid.Column="2" Classes="col-header" Text="CAPACITY" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="3" Classes="col-header" Text="USED" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="4" Classes="col-header" Text="FREE" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="5" Classes="col-header" Text="FILESYSTEM" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="6" Classes="col-header" Text="MODEL"/>
                                <TextBlock Grid.Column="7" Classes="col-header" Text="USAGE" HorizontalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <ListBox x:Name="DisksList"
                                 Grid.Row="1"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="OnDiskSelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="disks:DiskEntry">
                                    <Grid ColumnDefinitions="52,*,90,90,90,100,140,90" Margin="20,0">
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding StatusLabel}"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{Binding StatusBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Label}"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource ArkTextPrimary}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding CapacityLabel}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource ArkTextSecondary}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding UsedLabel}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource ArkTextSecondary}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="4"
                                                   Text="{Binding FreeLabel}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource ArkTextSecondary}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="5"
                                                   Text="{Binding FilesystemLabel}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource ArkTextSecondary}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="6"
                                                   Text="{Binding ModelLabel}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource ArkTextSecondary}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>
                                        <!-- Usage bar -->
                                        <Border Grid.Column="7"
                                                Height="8"
                                                CornerRadius="1"
                                                Background="{DynamicResource ArkSurfaceAlt}"
                                                VerticalAlignment="Center"
                                                Margin="8,0">
                                            <Border HorizontalAlignment="Left"
                                                    Height="8"
                                                    CornerRadius="1"
                                                    Background="#4CAF50"
                                                    Width="{Binding UsageRatio, Converter={x:Static disks:DiskUsageBarConverter.Instance}}"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                    </Grid><!-- /table column -->

                    <Border Grid.Column="1" Background="{DynamicResource ArkSurfaceAlt}"/>

                    <!-- Disk detail panel -->
                    <Grid Grid.Column="2" Background="{DynamicResource ArkSurface}">

                        <TextBlock x:Name="DiskDetailEmpty"
                                   Text="Select a disk&#x0a;to view details"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="{DynamicResource ArkTextSecondary}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="DiskDetailContent"
                                        IsVisible="False"
                                        Margin="20,18,20,18"
                                        Spacing="0">

                                <TextBlock Classes="widget-title" Text="DISK DETAILS"/>

                                <TextBlock x:Name="DiskDetailLabel"
                                           FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource ArkTextPrimary}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,14"/>

                                <Border Classes="card-divider" Margin="0,0,0,10"/>

                                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                                    <TextBlock Grid.Column="0" Classes="card-key" Text="Status" Margin="0"/>
                                    <TextBlock Grid.Column="1" x:Name="DiskDetailStatus" Classes="card-val" Margin="0"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                                    <TextBlock Grid.Column="0" Classes="card-key" Text="Capacity" Margin="0"/>
                                    <TextBlock Grid.Column="1" x:Name="DiskDetailCapacity" Classes="card-val" Margin="0"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                                    <TextBlock Grid.Column="0" Classes="card-key" Text="Used" Margin="0"/>
                                    <TextBlock Grid.Column="1" x:Name="DiskDetailUsed" Classes="card-val" Margin="0"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                                    <TextBlock Grid.Column="0" Classes="card-key" Text="Free" Margin="0"/>
                                    <TextBlock Grid.Column="1" x:Name="DiskDetailFree" Classes="card-val" Margin="0"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                                    <TextBlock Grid.Column="0" Classes="card-key" Text="Filesystem" Margin="0"/>
                                    <TextBlock Grid.Column="1" x:Name="DiskDetailFilesystem" Classes="card-val" Margin="0"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                                    <TextBlock Grid.Column="0" Classes="card-key" Text="Brand" Margin="0"/>
                                    <TextBlock Grid.Column="1" x:Name="DiskDetailBrand" Classes="card-val" Margin="0"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                                    <TextBlock Grid.Column="0" Classes="card-key" Text="Model" Margin="0"/>
                                    <TextBlock Grid.Column="1" x:Name="DiskDetailModel" Classes="card-val" Margin="0"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                                    <TextBlock Grid.Column="0" Classes="card-key" Text="Serial" Margin="0"/>
                                    <TextBlock Grid.Column="1" x:Name="DiskDetailSerial" Classes="card-val" Margin="0"/>
                                </Grid>

                                <!-- Segmented usage bar -->
                                <Border Classes="card-divider" Margin="0,14,0,10"/>
                                <TextBlock Classes="widget-title" Text="VOLUME USAGE" Margin="0,0,0,8"/>
                                <Border x:Name="DiskSegmentBar"
                                        Height="17"
                                        CornerRadius="3"
                                        Background="{DynamicResource ArkSurfaceAlt}"
                                        Margin="0,0,0,10"/>

                                <!-- Volumes on disk -->
                                <Border Classes="card-divider" Margin="0,4,0,10"/>
                                <TextBlock Classes="widget-title" Text="VOLUMES" Margin="0,0,0,8"/>
                                <StackPanel x:Name="DiskVolumeList" Spacing="4"/>

                            </StackPanel>
                        </ScrollViewer>

                    </Grid><!-- /disk detail -->

                </Grid><!-- /list+detail -->

            </Grid><!-- /ViewDisks -->

            <!-- ══════════════════════════ Volumes view ══════════════════════════ -->
            <Grid x:Name="ViewVolumes"
                  Grid.Row="1"
                  IsVisible="False"
                  RowDefinitions="Auto,*">

                <!-- Toolbar -->
                <Border Grid.Row="0"
                        Padding="16,9"
                        Background="{DynamicResource ArkSurface}"
                        BorderBrush="{DynamicResource ArkSurfaceAlt}"
                        BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button x:Name="VolActCreateVolume"  Classes="view-toggle"
                                Content="Create Volume"  Click="OnCreateVolume"/>
                        <Button x:Name="VolActVerifyVolume"  Classes="view-toggle" IsEnabled="False"
                                Content="Verify Volume"  Click="OnVerifyVolume"/>
                        <Button x:Name="VolActRepair"        Classes="view-toggle" IsEnabled="False"
                                Content="Repair Volume"  Click="OnRepairVolume"/>
                        <Border Width="1" Background="{DynamicResource ArkSurfaceAlt}"
                                Margin="10,2" VerticalAlignment="Stretch"/>
                        <Button x:Name="VolActMake"      Classes="view-toggle" IsEnabled="False"
                                Content="Make"      Click="OnMakeVolume"/>
                        <Button x:Name="VolActMove"      Classes="view-toggle" IsEnabled="False"
                                Content="Move"      Click="OnMoveVolume"/>
                        <Button x:Name="VolActResize"    Classes="view-toggle" IsEnabled="False"
                                Content="Resize"    Click="OnResizeVolume"/>
                        <Button x:Name="VolActAppend"    Classes="view-toggle" IsEnabled="False"
                                Content="Append"    Click="OnAppendVolume"/>
                        <Button x:Name="VolActReabsorb"  Classes="view-toggle" IsEnabled="False"
                                Content="Reabsorb"  Click="OnReabsorbVolume"/>
                        <Button x:Name="VolActMarkLost"  Classes="view-toggle" IsEnabled="False"
                                Content="Mark Lost" Click="OnMarkVolumeLost"/>
                        <Border Width="1" Background="{DynamicResource ArkSurfaceAlt}"
                                Margin="10,2" VerticalAlignment="Stretch"/>
                        <Button x:Name="VolActArtifacts" Classes="view-toggle" IsEnabled="False"
                                Content="Artifacts…" Click="OnVolumeArtifactsDetails"/>
                    </StackPanel>
                </Border>

                <!-- Full-width table -->
                <Grid Grid.Row="1" RowDefinitions="Auto,*">

                    <Border Grid.Row="0"
                            Padding="20,8"
                            BorderBrush="{DynamicResource ArkSurfaceAlt}"
                            BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="52,0.75*,80,140,90,90,0.5*,3*">
                            <TextBlock Grid.Column="0" Classes="col-header" Text="STATUS"    HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Classes="col-header" Text="LABEL"/>
                            <TextBlock Grid.Column="2" Classes="col-header" Text="ARTIFACTS" HorizontalAlignment="Center" Margin="8,0,0,0"/>
                            <TextBlock Grid.Column="3" Classes="col-header" Text="DAT LINE" Margin="12,0,0,0"/>
                            <TextBlock Grid.Column="4" Classes="col-header" Text="PLANNED"   HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="5" Classes="col-header" Text="ACTUAL"    HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="6" Classes="col-header" Text="LOCATION" Margin="12,0,0,0"/>
                            <TextBlock Grid.Column="7" Classes="col-header" Text="FILL"      Margin="8,0,0,0"/>
                        </Grid>
                    </Border>

                    <ListBox x:Name="VolumesList"
                             Grid.Row="1"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="OnVolumeSelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vols:VolumeEntry">
                                <Grid ColumnDefinitions="52,0.75*,80,140,90,90,0.5*,3*" Margin="20,0">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding StatusLabel}"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{Binding StatusBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Label}"
                                               FontSize="13"
                                               Foreground="{DynamicResource ArkTextPrimary}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding ArtifactCount}"
                                               FontSize="12"
                                               Foreground="{DynamicResource ArkTextSecondary}"
                                               HorizontalAlignment="Center"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3"
                                               Text="{Binding DatLineId}"
                                               FontSize="11"
                                               Foreground="{DynamicResource ArkTextSecondary}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="12,0,0,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="4"
                                               Text="{Binding PlannedLabel}"
                                               FontSize="12"
                                               Foreground="{DynamicResource ArkTextSecondary}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="5"
                                               Text="{Binding ActualLabel}"
                                               FontSize="12"
                                               Foreground="{DynamicResource ArkTextSecondary}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="6"
                                               Text="{Binding CurrentLocation}"
                                               FontSize="12"
                                               Foreground="{DynamicResource ArkTextSecondary}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="12,0,0,0"
                                               VerticalAlignment="Center"/>
                                    <!-- Single-color fill bar: color interpolated per fill ratio -->
                                    <ProgressBar Grid.Column="7"
                                                 Minimum="0" Maximum="1"
                                                 Value="{Binding FillRatio}"
                                                 Foreground="{Binding FillRatio, Converter={x:Static vols:VolumeFillBarConverter.Instance}}"
                                                 Height="6"
                                                 VerticalAlignment="Center"
                                                 Margin="8,0"
                                                 CornerRadius="2"
                                                 Background="#383850"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                </Grid><!-- /full-width table -->

            </Grid><!-- /ViewVolumes -->

            <!-- ═══════════════════════════════════════════════ LOGS ═══ -->
            <Grid x:Name="ViewLogs" Grid.Row="1" IsVisible="False" RowDefinitions="Auto,*">

                <!-- header -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="28,24,28,0" Spacing="12">
                    <TextBlock Text="LOGS"
                               FontSize="11" FontWeight="SemiBold" LetterSpacing="1.5"
                               Foreground="#555566" VerticalAlignment="Center"/>
                    <Button x:Name="LogsRefreshBtn"
                            Content="Refresh"
                            Classes="view-toggle"
                            Click="OnLogsRefresh"/>
                    <Button x:Name="LogsOpenLatestBtn"
                            Content="Open Latest"
                            Classes="view-toggle"
                            Click="OnLogsOpenLatest"/>
                </StackPanel>

                <!-- split: tree | viewer -->
                <Grid Grid.Row="1" ColumnDefinitions="240,*" Margin="28,18,28,24">

                    <!-- left: folder/file tree -->
                    <Border Grid.Column="0"
                            Background="#0A0A12" BorderBrush="#1E1E2C"
                            BorderThickness="1" CornerRadius="6"
                            Margin="0,0,12,0">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="LogsTreePanel" Spacing="0" Margin="8,8"/>
                        </ScrollViewer>
                    </Border>

                    <!-- right: file content viewer -->
                    <Border Grid.Column="1"
                            Background="#0A0A12" BorderBrush="#1E1E2C"
                            BorderThickness="1" CornerRadius="6">
                        <Grid RowDefinitions="Auto,*">
                            <TextBlock x:Name="LogsFileLabel"
                                       Grid.Row="0"
                                       Text="No file selected"
                                       FontSize="11" Foreground="#555566"
                                       Margin="12,10,12,8"/>
                            <ScrollViewer Grid.Row="1"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto">
                                <TextBox x:Name="LogsContentBox"
                                         IsReadOnly="True"
                                         AcceptsReturn="True"
                                         TextWrapping="NoWrap"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="#AAAACC"
                                         FontFamily="Cascadia Code,Consolas,Courier New,monospace"
                                         FontSize="12"
                                         Padding="12,0,12,12"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                </Grid>

            </Grid><!-- /ViewLogs -->

            <!-- ═══════════════════════════════════════════ SETTINGS ═══ -->
            <Grid x:Name="ViewSettings" Grid.Row="1" IsVisible="False" RowDefinitions="Auto,*">

                <!-- header -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="28,24,28,0" Spacing="12">
                    <TextBlock Text="SETTINGS"
                               FontSize="11" FontWeight="SemiBold" LetterSpacing="1.5"
                               Foreground="#555566" VerticalAlignment="Center"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" Margin="28,18,28,24">
                    <StackPanel Spacing="20" MaxWidth="680" HorizontalAlignment="Left">

                        <!-- ── VERIFY BEHAVIOR card ──────────────────────────── -->
                        <Border Background="#0A0A12" BorderBrush="#1E1E2C"
                                BorderThickness="1" CornerRadius="6" Padding="20,16">
                            <StackPanel Spacing="0">

                                <TextBlock Text="VERIFY BEHAVIOR"
                                           FontSize="10" FontWeight="SemiBold" LetterSpacing="1.2"
                                           Foreground="#555566" Margin="0,0,0,16"/>

                                <!-- quarantine_mismatch_on_verify -->
                                <StackPanel Spacing="4" Margin="0,0,0,14">
                                    <CheckBox x:Name="SettingQuarantineMismatch"
                                              Content="Quarantine mismatches during verify"
                                              FontSize="12" Foreground="#CCCCDD"/>
                                    <TextBlock Text="When enabled, files that fail checksum verification can be moved to incoming-skip during Verify apply."
                                               FontSize="11" Foreground="#555577"
                                               Margin="22,0,0,0" TextWrapping="Wrap"/>
                                </StackPanel>

                                <!-- quarantine_unexpected_on_verify -->
                                <StackPanel Spacing="4">
                                    <CheckBox x:Name="SettingQuarantineUnexpected"
                                              Content="Quarantine unexpected files during verify"
                                              FontSize="12" Foreground="#CCCCDD"/>
                                    <TextBlock Text="When enabled, files present on volume but not expected by the DAT can be moved to incoming-skip during Verify apply."
                                               FontSize="11" Foreground="#555577"
                                               Margin="22,0,0,0" TextWrapping="Wrap"/>
                                </StackPanel>

                            </StackPanel>
                        </Border><!-- /Verify Behavior card -->

                        <!-- ── LOGGING card ──────────────────────────────────── -->
                        <Border Background="#0A0A12" BorderBrush="#1E1E2C"
                                BorderThickness="1" CornerRadius="6" Padding="20,16">
                            <StackPanel Spacing="0">

                                <TextBlock Text="LOGGING"
                                           FontSize="10" FontWeight="SemiBold" LetterSpacing="1.2"
                                           Foreground="#555566" Margin="0,0,0,16"/>

                                <!-- auto_export_ingestion_logs -->
                                <StackPanel Spacing="4" Margin="0,0,0,14">
                                    <CheckBox x:Name="SettingAutoExportLogs"
                                              Content="Auto-export ingestion logs"
                                              FontSize="12" Foreground="#CCCCDD"/>
                                    <TextBlock Text="Automatically write a log file to the logs/ folder each time an ingestion run completes."
                                               FontSize="11" Foreground="#555577"
                                               Margin="22,0,0,0" TextWrapping="Wrap"/>
                                </StackPanel>

                                <!-- log_on_copy -->
                                <StackPanel Spacing="4" Margin="0,0,0,14">
                                    <CheckBox x:Name="SettingLogOnCopy"
                                              Content="Auto-export copy logs"
                                              FontSize="12" Foreground="#CCCCDD"/>
                                    <TextBlock Text="Automatically include individual file copy operations in the volume build log."
                                               FontSize="11" Foreground="#555577"
                                               Margin="22,0,0,0" TextWrapping="Wrap"/>
                                </StackPanel>

                                <!-- auto_export_verify_logs -->
                                <StackPanel Spacing="4" Margin="0,0,0,14">
                                    <CheckBox x:Name="SettingAutoExportVerifyLogs"
                                              Content="Auto-export verify logs"
                                              FontSize="12" Foreground="#CCCCDD"/>
                                    <TextBlock Text="Automatically write a log file to the logs/verify/ folder each time a verify run completes."
                                               FontSize="11" Foreground="#555577"
                                               Margin="22,0,0,0" TextWrapping="Wrap"/>
                                </StackPanel>

                                <!-- auto_export_repair_logs -->
                                <StackPanel Spacing="4">
                                    <CheckBox x:Name="SettingAutoExportRepairLogs"
                                              Content="Auto-export repair logs"
                                              FontSize="12" Foreground="#CCCCDD"/>
                                    <TextBlock Text="Automatically write a log file to the logs/repair/ folder each time a repair run completes."
                                               FontSize="11" Foreground="#555577"
                                               Margin="22,0,0,0" TextWrapping="Wrap"/>
                                </StackPanel>

                            </StackPanel>
                        </Border><!-- /Ingest Behavior card -->

                        <!-- ── DEBUG card ─────────────────────────────────────── -->
                        <Border Background="#0A0A12" BorderBrush="#1E1E2C"
                                BorderThickness="1" CornerRadius="6" Padding="20,16">
                            <StackPanel Spacing="0">

                                <TextBlock Text="DEBUG"
                                           FontSize="10" FontWeight="SemiBold" LetterSpacing="1.2"
                                           Foreground="#555566" Margin="0,0,0,16"/>

                                <!-- show_debug_artifact_info -->
                                <StackPanel Spacing="4">
                                    <CheckBox x:Name="SettingShowDebugArtifactInfo"
                                              Content="Show debug artifact info in Library"
                                              FontSize="12" Foreground="#CCCCDD"/>
                                    <TextBlock Text="When enabled, detailed artifact and content identity data is shown in the Library release detail panel. Takes effect immediately."
                                               FontSize="11" Foreground="#555577"
                                               Margin="22,0,0,0" TextWrapping="Wrap"/>
                                </StackPanel>

                            </StackPanel>
                        </Border><!-- /Debug card -->

                        <!-- ── Save / Reload ──────────────────────────────────── -->
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Save Settings"
                                    Classes="view-toggle"
                                    Click="OnSaveSettings"/>
                            <Button Content="Reload"
                                    Classes="view-toggle"
                                    Click="OnReloadSettings"/>
                        </StackPanel>

                        <!-- ── DIAGNOSTICS card ───────────────────────────────── -->
                        <Border Background="#0A0A12" BorderBrush="#1E1E2C"
                                BorderThickness="1" CornerRadius="6" Padding="20,16">
                            <StackPanel Spacing="0">

                                <TextBlock Text="DIAGNOSTICS"
                                           FontSize="10" FontWeight="SemiBold" LetterSpacing="1.2"
                                           Foreground="#555566" Margin="0,0,0,16"/>

                                <StackPanel Spacing="4">
                                    <Button Content="Validate Integrity"
                                            Classes="view-toggle"
                                            Click="OnValidateIntegrity"/>
                                    <TextBlock Text="Checks invariants across volumes, artifacts, and releases. Read-only. Writes a report to logs/integrity/."
                                               FontSize="11" Foreground="#555577"
                                               TextWrapping="Wrap"/>
                                </StackPanel>

                            </StackPanel>
                        </Border><!-- /Diagnostics card -->

                    </StackPanel>
                </ScrollViewer>

            </Grid><!-- /ViewSettings -->

            <!-- ═══════════════════════════════════════════ OPERATIONS ═══ -->
            <Grid x:Name="ViewOperations" Grid.Row="1" IsVisible="False" RowDefinitions="Auto,*">

                <!-- header -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="28,24,28,0" Spacing="12">
                    <TextBlock Text="OPERATIONS"
                               FontSize="11" FontWeight="SemiBold" LetterSpacing="1.5"
                               Foreground="#555566" VerticalAlignment="Center"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" Margin="28,18,28,24">
                    <StackPanel Spacing="20">

                        <!-- ── TOOLS card ─────────────────────────────────────── -->
                        <Border Background="#0A0A12" BorderBrush="#1E1E2C"
                                BorderThickness="1" CornerRadius="6" Padding="20,16">
                            <StackPanel Spacing="0">

                                <TextBlock Text="TOOLS"
                                           FontSize="10" FontWeight="SemiBold" LetterSpacing="1.2"
                                           Foreground="#555566" Margin="0,0,0,12"/>

                                <!-- tool rows injected here by code -->
                                <StackPanel x:Name="OperationsToolsPanel" Spacing="4"/>

                            </StackPanel>
                        </Border><!-- /Tools card -->

                        <!-- ── TRANSFORMS card ───────────────────────────────── -->
                        <Border Background="#0A0A12" BorderBrush="#1E1E2C"
                                BorderThickness="1" CornerRadius="6" Padding="20,16">
                            <StackPanel Spacing="0">

                                <TextBlock Text="TRANSFORMS"
                                           FontSize="10" FontWeight="SemiBold" LetterSpacing="1.2"
                                           Foreground="#555566" Margin="0,0,0,8"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button Content="+ New Transform"
                                            Classes="view-toggle"
                                            Click="OnNewTransform"/>
                                </StackPanel>

                                <Border Background="#08080F" BorderBrush="#1A1A28"
                                        BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,0,0,12">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="Transform Types"
                                                   FontSize="10" FontWeight="SemiBold" Foreground="#7B68EE"
                                                   Margin="0,0,0,4"/>
                                        <TextBlock FontSize="11" Foreground="#555577">
                                            <Run FontWeight="SemiBold" Foreground="#C060C0">File</Run>
                                            <Run Foreground="#555577"> — applied independently to each source file.</Run>
                                        </TextBlock>
                                        <TextBlock FontSize="11" Foreground="#555577">
                                            <Run FontWeight="SemiBold" Foreground="#C8A000">Folder</Run>
                                            <Run Foreground="#555577"> — applied to the entire release folder as a unit.</Run>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                        <Grid ColumnDefinitions="220,*" MinHeight="340">

                            <!-- transform list (built dynamically in code-behind with group headers) -->
                            <Border Grid.Column="0"
                                    Margin="0,0,16,0"
                                    Background="#0A0A12"
                                    BorderBrush="#1E1E2C"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <ScrollViewer>
                                    <StackPanel x:Name="TransformsListPanel" Spacing="0"/>
                                </ScrollViewer>
                            </Border>

                            <!-- transform editor -->
                            <StackPanel x:Name="TransformEditorPanel"
                                        Grid.Column="1"
                                        Spacing="0"
                                        IsVisible="False">

                                <!-- name (editable) -->
                                <TextBlock Text="Name"
                                           FontSize="10" FontWeight="SemiBold" Foreground="#555566"
                                           Margin="0,0,0,6"/>
                                <TextBox x:Name="TransformNameBox"
                                         Background="#0D0D1A" Foreground="#CCCCDD"
                                         BorderBrush="#2A2A3C" BorderThickness="1"
                                         CornerRadius="4" Padding="8,6"
                                         FontSize="12"
                                         Margin="0,0,0,12"/>

                                <!-- read-only info row -->
                                <Grid ColumnDefinitions="90,*" Margin="0,0,0,8">
                                    <TextBlock Grid.Column="0" Text="ID"
                                               FontSize="10" FontWeight="SemiBold" Foreground="#555566"
                                               VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TransformIdText" Grid.Column="1"
                                               FontSize="12" Foreground="#AAAACC"
                                               VerticalAlignment="Center"/>
                                </Grid>
                                <Grid ColumnDefinitions="90,*" Margin="0,0,0,12">
                                    <TextBlock Grid.Column="0" Text="Tool"
                                               FontSize="10" FontWeight="SemiBold" Foreground="#555566"
                                               VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TransformToolText" Grid.Column="1"
                                               FontSize="12" Foreground="#AAAACC"
                                               VerticalAlignment="Center"/>
                                </Grid>

                                <!-- transform type -->
                                <Grid ColumnDefinitions="90,*" Margin="0,0,0,16">
                                    <TextBlock Grid.Column="0" Text="Type"
                                               FontSize="10" FontWeight="SemiBold" Foreground="#555566"
                                               VerticalAlignment="Center"/>
                                    <ComboBox x:Name="TransformTypeBox"
                                              Grid.Column="1"
                                              Background="#0D0D1A" Foreground="#CCCCDD"
                                              BorderBrush="#2A2A3C" BorderThickness="1"
                                              FontSize="12">
                                        <ComboBoxItem Content="File"   Tag="file"/>
                                        <ComboBoxItem Content="Folder" Tag="folder"/>
                                    </ComboBox>
                                </Grid>

                                <!-- command template -->
                                <TextBlock Text="Command Template"
                                           FontSize="10" FontWeight="SemiBold" Foreground="#555566"
                                           Margin="0,0,0,6"/>
                                <TextBox x:Name="TransformCmdBox"
                                         Background="#0D0D1A" Foreground="#CCCCDD"
                                         BorderBrush="#2A2A3C" BorderThickness="1"
                                         CornerRadius="4" Padding="8,6"
                                         FontSize="12"
                                         Margin="0,0,0,10"
                                         TextChanged="OnTransformFieldChanged"/>

                                <!-- output extension -->
                                <TextBlock Text="Output Extension"
                                           FontSize="10" FontWeight="SemiBold" Foreground="#555566"
                                           Margin="0,0,0,6"/>
                                <TextBox x:Name="TransformOutputExtBox"
                                         Background="#0D0D1A" Foreground="#CCCCDD"
                                         BorderBrush="#2A2A3C" BorderThickness="1"
                                         CornerRadius="4" Padding="8,6"
                                         FontSize="12" MaxWidth="120" HorizontalAlignment="Left"
                                         Margin="0,0,0,4"
                                         TextChanged="OnTransformFieldChanged"/>

                                <!-- output extension warning -->
                                <TextBlock x:Name="TransformExtWarning"
                                           Text="No output extension set — derived filename will match the source."
                                           FontSize="10" Foreground="#E8A000"
                                           IsVisible="False"
                                           Margin="0,0,0,12"/>

                                <!-- resolved command preview -->
                                <TextBlock Text="Resolved Command:"
                                           FontSize="10" FontWeight="SemiBold" Foreground="#555566"
                                           Margin="0,0,0,6"/>
                                <Border Background="#08080F" BorderBrush="#1A1A28"
                                        BorderThickness="1" CornerRadius="4" Padding="8,6"
                                        Margin="0,0,0,16">
                                    <TextBlock x:Name="TransformPreviewText"
                                               FontSize="11" Foreground="#9A9AB8"
                                               TextWrapping="Wrap"
                                               FontFamily="Cascadia Code,Consolas,Courier New,monospace"/>
                                </Border>

                                <!-- save + test -->
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,20">
                                    <Button x:Name="TransformSaveBtn"
                                            Content="Save"
                                            Classes="view-toggle"
                                            Click="OnSaveTransform"/>
                                    <Button x:Name="TransformTestBtn"
                                            Content="Test Transform"
                                            Classes="view-toggle"
                                            Click="OnTestTransform"/>
                                </StackPanel>

                                <Border Height="1" Background="#1E1E2C" Margin="0,0,0,16"/>

                                <!-- ── always-visible placeholder reference ──── -->
                                <TextBlock Text="Available placeholders:"
                                           FontSize="10" FontWeight="SemiBold" Foreground="#555566"
                                           Margin="0,0,0,8"/>

                                <Border Background="#08080F" BorderBrush="#1A1A28"
                                        BorderThickness="1" CornerRadius="4" Padding="12,10"
                                        TextElement.FontFamily="Cascadia Code,Consolas,Courier New,monospace"
                                        TextElement.FontSize="11">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="Required placeholders: {input} and {output}"
                                                   FontSize="10" FontWeight="SemiBold" Foreground="#CC6666"
                                                   Margin="0,0,0,2"/>
                                        <Border Height="1" Background="#2A1A1A" Margin="0,0,0,4"/>
                                        <Grid ColumnDefinitions="130,*">
                                            <TextBlock Grid.Column="0" Text="{}{input}"        Foreground="#7B68EE"/>
                                            <TextBlock Grid.Column="1" Text="→ full input path   (C:\roms\game.iso)" Foreground="#666677"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="130,*">
                                            <TextBlock Grid.Column="0" Text="{}{output}"       Foreground="#7B68EE"/>
                                            <TextBlock Grid.Column="1" Text="→ full output path  (C:\archive\game.chd)" Foreground="#666677"/>
                                        </Grid>
                                        <Border Height="1" Background="#1A1A28" Margin="0,4,0,4"/>
                                        <Grid ColumnDefinitions="130,*">
                                            <TextBlock Grid.Column="0" Text="{}{input_stem}"   Foreground="#7B68EE"/>
                                            <TextBlock Grid.Column="1" Text="→ name without ext  (game)" Foreground="#666677"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="130,*">
                                            <TextBlock Grid.Column="0" Text="{}{output_stem}"  Foreground="#7B68EE"/>
                                            <TextBlock Grid.Column="1" Text="→ name without ext  (game)" Foreground="#666677"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="130,*">
                                            <TextBlock Grid.Column="0" Text="{}{input_name}"   Foreground="#7B68EE"/>
                                            <TextBlock Grid.Column="1" Text="→ name with ext     (game.iso)" Foreground="#666677"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="130,*">
                                            <TextBlock Grid.Column="0" Text="{}{output_name}"  Foreground="#7B68EE"/>
                                            <TextBlock Grid.Column="1" Text="→ name with ext     (game.chd)" Foreground="#666677"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="130,*">
                                            <TextBlock Grid.Column="0" Text="{}{input_dir}"    Foreground="#7B68EE"/>
                                            <TextBlock Grid.Column="1" Text="→ input directory   (C:\roms\)" Foreground="#666677"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="130,*">
                                            <TextBlock Grid.Column="0" Text="{}{output_dir}"   Foreground="#7B68EE"/>
                                            <TextBlock Grid.Column="1" Text="→ output directory  (C:\archive\)" Foreground="#666677"/>
                                        </Grid>
                                        <Border Height="1" Background="#1A1A28" Margin="0,6,0,6"/>
                                        <TextBlock Text="Examples:" Foreground="#444455" Margin="0,0,0,4"/>
                                        <TextBlock Text="CHD:   createcd -i &quot;{input}&quot; -o &quot;{output}&quot;"
                                                   Foreground="#555566"/>
                                        <TextBlock Text="ZIP:   a -tzip &quot;{output}&quot; &quot;{input}&quot;"
                                                   Foreground="#555566"/>
                                        <TextBlock Text="Custom: tool.exe &quot;{input_stem}&quot; &quot;{output_stem}&quot;"
                                                   Foreground="#555566"/>
                                    </StackPanel>
                                </Border>

                            </StackPanel><!-- /TransformEditorPanel -->

                        </Grid><!-- /transforms Grid -->

                            </StackPanel>
                        </Border><!-- /Transforms card -->

                    </StackPanel>
                </ScrollViewer>

            </Grid><!-- /ViewOperations -->

            <!-- ── Analytics view ── -->
            <ScrollViewer x:Name="ViewAnalytics"
                          Grid.Row="1"
                          IsVisible="False"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="28,24,28,32" Spacing="24">

                    <!-- Action row -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
                        <Button Content="Refresh"
                                Classes="view-toggle"
                                Click="OnAnalyticsRefresh"/>
                        <Button Content="Generate All Reports"
                                Classes="view-toggle"
                                Click="OnAnalyticsGenerateReports"/>
                        <Button Content="Open Analytics Folder"
                                Classes="view-toggle"
                                Click="OnAnalyticsOpenFolder"/>
                    </StackPanel>

                    <!-- KPI strip header -->
                    <TextBlock Text="ARCHIVE METRICS"
                               FontSize="10" FontWeight="SemiBold" LetterSpacing="1.5"
                               Foreground="#555566" Margin="0,0,0,-8"/>

                    <!-- KPI cards (8)
                         Typography scale:
                           label:  10px SemiBold LetterSpacing=1.0  #ArkTextSecondary
                           value:  20px Bold  #777788  (standard) | 28px #4CAF50 (hero) | 22px #7B68EE (secondary)
                           helper: 10px Normal  #7A7A8F  TextWrapping=Wrap
                         Accent cards use Grid RowDefinitions="4,*" so the inner content Border
                         stretches to fill the remaining cell height, enabling VerticalAlignment=Center.
                    -->
                    <UniformGrid Rows="1">

                        <!-- SOURCE SIZE — dark cyan accent -->
                        <Border Classes="card" Padding="0">
                            <Grid RowDefinitions="4,*">
                                <Border Grid.Row="0" Height="4" Background="#1A4A5A"
                                        CornerRadius="7,7,0,0"/>
                                <Border Grid.Row="1" Padding="12,8,12,12">
                                    <StackPanel Spacing="5" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                                        <TextBlock Text="SOURCE SIZE"
                                                   FontSize="10" FontWeight="SemiBold" LetterSpacing="1.0"
                                                   Foreground="#2A8AAA"
                                                   TextAlignment="Center" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="AnalyticsKpiSourceSize"
                                                   FontSize="20" FontWeight="Bold" Foreground="#26C6DA" Text="—"
                                                   TextAlignment="Center" HorizontalAlignment="Center"/>
                                        <TextBlock Text="raw ingested data"
                                                   FontSize="10" Foreground="#1A6880"
                                                   TextAlignment="Center" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- DERIVED SIZE — light cyan accent -->
                        <Border Classes="card" Padding="0">
                            <Grid RowDefinitions="4,*">
                                <Border Grid.Row="0" Height="4" Background="#0D3040"
                                        CornerRadius="7,7,0,0"/>
                                <Border Grid.Row="1" Padding="12,8,12,12">
                                    <StackPanel Spacing="5" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                                        <TextBlock Text="DERIVED SIZE"
                                                   FontSize="10" FontWeight="SemiBold" LetterSpacing="1.0"
                                                   Foreground="#2090B0"
                                                   TextAlignment="Center" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="AnalyticsKpiDerivedSize"
                                                   FontSize="20" FontWeight="Bold" Foreground="#29B6F6" Text="—"
                                                   TextAlignment="Center" HorizontalAlignment="Center"/>
                                        <TextBlock Text="stored archive size"
                                                   FontSize="10" Foreground="#1A7090"
                                                   TextAlignment="Center" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- SPACE SAVED — primary accent (color emphasis only) -->
                        <Border Classes="card" Padding="0"
                                BorderBrush="#1A3D22" BorderThickness="1">
                            <Grid RowDefinitions="4,*">
                                <Border Grid.Row="0" Height="4" Background="#2A6030"
                                        CornerRadius="7,7,0,0"/>
                                <Border Grid.Row="1" Padding="12,8,12,12">
                                    <StackPanel Spacing="5" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                                        <TextBlock Text="SPACE SAVED"
                                                   FontSize="10" FontWeight="SemiBold" LetterSpacing="1.0"
                                                   Foreground="#4A9A55"
                                                   TextAlignment="Center" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="AnalyticsKpiSavedPct"
                                                   FontSize="20" FontWeight="Bold"
                                                   Foreground="#4CAF50" Text="—"
                                                   TextAlignment="Center" HorizontalAlignment="Center"/>
                                        <TextBlock Text="compression ratio"
                                                   FontSize="10" Foreground="#4A9A55"
                                                   TextAlignment="Center" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- SAVED ABSOLUTE — purple accent (full) -->
                        <Border Classes="card" Padding="0">
                            <Grid RowDefinitions="4,*">
                                <Border Grid.Row="0" Height="4" Background="#2A2560"
                                        CornerRadius="7,7,0,0"/>
                                <Border Grid.Row="1" Padding="12,8,12,12">
                                    <StackPanel Spacing="5" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                                        <TextBlock Text="SAVED ABSOLUTE"
                                                   FontSize="10" FontWeight="SemiBold" LetterSpacing="1.0"
                                                   Foreground="#6050BB"
                                                   TextAlignment="Center" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="AnalyticsKpiSavedAbs"
                                                   FontSize="20" FontWeight="Bold"
                                                   Foreground="#7B68EE" Text="—"
                                                   TextAlignment="Center" HorizontalAlignment="Center"/>
                                        <TextBlock Text="bytes recovered"
                                                   FontSize="10" Foreground="#4A3A90"
                                                   TextAlignment="Center" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- VOLUMES -->
                        <Border Classes="card" Padding="12,12,12,14">
                            <StackPanel Spacing="5" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                                <TextBlock Text="VOLUMES"
                                           FontSize="10" FontWeight="SemiBold" LetterSpacing="1.0"
                                           Foreground="{DynamicResource ArkTextSecondary}"
                                           TextAlignment="Center" TextWrapping="Wrap"/>
                                <TextBlock x:Name="AnalyticsKpiVolumes"
                                           FontSize="20" FontWeight="Bold" Foreground="#777788" Text="—"
                                           TextAlignment="Center" HorizontalAlignment="Center"/>
                                <TextBlock Text="archive volumes"
                                           FontSize="10" Foreground="#7A7A8F"
                                           TextAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- AT RISK — fully dynamic accent (green=ok, red=crit) -->
                        <Border Classes="card" Padding="0" x:Name="AnalyticsCritCard">
                            <Grid RowDefinitions="4,*">
                                <Border Grid.Row="0" x:Name="AnalyticsCritAccent" Height="4"
                                        Background="#1A1A2E" CornerRadius="7,7,0,0"/>
                                <Border Grid.Row="1" Padding="12,8,12,12">
                                    <StackPanel Spacing="5" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                                        <TextBlock x:Name="AnalyticsCritLabel" Text="AT RISK"
                                                   FontSize="10" FontWeight="SemiBold" LetterSpacing="1.0"
                                                   Foreground="{DynamicResource ArkTextSecondary}"
                                                   TextAlignment="Center" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="AnalyticsKpiCritVolumes"
                                                   FontSize="20" FontWeight="Bold" Text="—"
                                                   TextAlignment="Center" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="AnalyticsCritHelper" Text="critical volumes"
                                                   FontSize="10" Foreground="#7A7A8F"
                                                   TextAlignment="Center" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- STORED ARTIFACTS -->
                        <Border Classes="card" Padding="12,12,12,14">
                            <StackPanel Spacing="5" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                                <TextBlock Text="ARTIFACTS"
                                           FontSize="10" FontWeight="SemiBold" LetterSpacing="1.0"
                                           Foreground="{DynamicResource ArkTextSecondary}"
                                           TextAlignment="Center" TextWrapping="Wrap"/>
                                <TextBlock x:Name="AnalyticsKpiStoredArtifacts"
                                           FontSize="20" FontWeight="Bold" Foreground="#777788" Text="—"
                                           TextAlignment="Center" HorizontalAlignment="Center"/>
                                <TextBlock Text="stored in volumes"
                                           FontSize="10" Foreground="#7A7A8F"
                                           TextAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- FILE TYPES -->
                        <Border Classes="card" Padding="12,12,12,14" Margin="0">
                            <StackPanel Spacing="5" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                                <TextBlock Text="FILE TYPES"
                                           FontSize="10" FontWeight="SemiBold" LetterSpacing="1.0"
                                           Foreground="{DynamicResource ArkTextSecondary}"
                                           TextAlignment="Center" TextWrapping="Wrap"/>
                                <TextBlock x:Name="AnalyticsKpiArtifactTypes"
                                           FontSize="20" FontWeight="Bold" Foreground="#777788" Text="—"
                                           TextAlignment="Center" HorizontalAlignment="Center"/>
                                <TextBlock Text="distinct extensions"
                                           FontSize="10" Foreground="#7A7A8F"
                                           TextAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                    </UniformGrid>

                    <!-- Section A: Storage &amp; Compression -->
                    <Border HorizontalAlignment="Stretch"
                            Background="{DynamicResource ArkSurface}"
                            CornerRadius="8" Padding="20,18"
                            BorderBrush="{DynamicResource ArkSurfaceAlt}" BorderThickness="1">
                        <StackPanel Spacing="0" HorizontalAlignment="Stretch">
                            <TextBlock Classes="widget-title" Text="STORAGE &amp; COMPRESSION"/>
                            <Grid x:Name="AnalyticsSectionAPanel" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Border>

                    <!-- Sections B + C: side by side -->
                    <Grid ColumnDefinitions="*,16,*" HorizontalAlignment="Stretch">

                        <Border Grid.Column="0"
                                HorizontalAlignment="Stretch"
                                Background="{DynamicResource ArkSurface}"
                                CornerRadius="8" Padding="20,18"
                                BorderBrush="{DynamicResource ArkSurfaceAlt}" BorderThickness="1">
                            <StackPanel Spacing="0" HorizontalAlignment="Stretch">
                                <TextBlock Classes="widget-title" Text="COMPRESSION BY STRATEGY"/>
                                <StackPanel x:Name="AnalyticsByStrategyPanel" Spacing="6" HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2"
                                HorizontalAlignment="Stretch"
                                Background="{DynamicResource ArkSurface}"
                                CornerRadius="8" Padding="20,18"
                                BorderBrush="{DynamicResource ArkSurfaceAlt}" BorderThickness="1">
                            <StackPanel Spacing="0" HorizontalAlignment="Stretch">
                                <TextBlock Classes="widget-title" Text="ARTIFACT TYPE DISTRIBUTION"/>
                                <StackPanel x:Name="AnalyticsArtifactTypePanel" Spacing="6" HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </Border>

                    </Grid>

                    <!-- Section D: Volume Heatmap -->
                    <Border HorizontalAlignment="Stretch"
                            Background="{DynamicResource ArkSurface}"
                            CornerRadius="8" Padding="20,18"
                            BorderBrush="{DynamicResource ArkSurfaceAlt}" BorderThickness="1">
                        <StackPanel Spacing="0" HorizontalAlignment="Stretch">
                            <TextBlock Classes="widget-title" Text="VOLUME HEATMAP"/>
                            <StackPanel x:Name="AnalyticsVolumeHeatmapPanel" Spacing="0" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Border>

                    <!-- Section D2: Disk Heatmap -->
                    <Border HorizontalAlignment="Stretch"
                            Background="{DynamicResource ArkSurface}"
                            CornerRadius="8" Padding="20,18"
                            BorderBrush="{DynamicResource ArkSurfaceAlt}" BorderThickness="1">
                        <StackPanel Spacing="0" HorizontalAlignment="Stretch">
                            <TextBlock Classes="widget-title" Text="DISK HEATMAP"/>
                            <StackPanel x:Name="AnalyticsDiskHeatmapPanel" Spacing="0" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Border>

                    <!-- Section E: Archive State Overview — two columns -->
                    <Grid ColumnDefinitions="*,16,*" HorizontalAlignment="Stretch">

                        <Border Grid.Column="0"
                                HorizontalAlignment="Stretch"
                                Background="{DynamicResource ArkSurface}"
                                CornerRadius="8" Padding="20,18"
                                BorderBrush="{DynamicResource ArkSurfaceAlt}" BorderThickness="1">
                            <StackPanel Spacing="0" HorizontalAlignment="Stretch">
                                <TextBlock Classes="widget-title" Text="RELEASE STATUS"/>
                                <StackPanel x:Name="AnalyticsReleaseStatusPanel" Spacing="6" HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2"
                                HorizontalAlignment="Stretch"
                                Background="{DynamicResource ArkSurface}"
                                CornerRadius="8" Padding="20,18"
                                BorderBrush="{DynamicResource ArkSurfaceAlt}" BorderThickness="1">
                            <StackPanel Spacing="0" HorizontalAlignment="Stretch">
                                <TextBlock Classes="widget-title" Text="VOLUME HEALTH"/>
                                <StackPanel x:Name="AnalyticsVolumeHealthPanel" Spacing="6" HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </Border>

                    </Grid>

                </StackPanel>
            </ScrollViewer><!-- /ViewAnalytics -->

        </Grid>
    </Grid>
</Window>
