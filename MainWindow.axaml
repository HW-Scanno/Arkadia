<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Arkadia.MainWindow"
        Title="Arkadia"
        Width="1200" Height="720"
        MinWidth="800" MinHeight="500"
        Background="{DynamicResource ArkBackground}"
        FontFamily="Inter,Segoe UI,sans-serif">

    <Window.Styles>

        <!-- ── Base nav button ── -->
        <Style Selector="Button.nav">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="{DynamicResource ArkSurface}"/>
            <Setter Property="Foreground" Value="{DynamicResource ArkTextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                    <BrushTransition Property="Foreground" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>

        <!-- Neutralise Semi.Avalonia template hover tinting in all states -->
        <Style Selector="Button.nav /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.nav:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.nav.active /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- Hover -->
        <Style Selector="Button.nav:pointerover">
            <Setter Property="Background" Value="#252547"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>

        <!-- Active -->
        <Style Selector="Button.nav.active">
            <Setter Property="Background" Value="{DynamicResource ArkAccent}"/>
            <Setter Property="Foreground" Value="{DynamicResource ArkBackground}"/>
        </Style>

    </Window.Styles>

    <Grid ColumnDefinitions="220,*">

        <!-- ══════════════════════════════ Sidebar ══════════════════════════════ -->
        <Border Grid.Column="0"
                Background="{DynamicResource ArkSurface}"
                BorderBrush="{DynamicResource ArkSurfaceAlt}"
                BorderThickness="0,0,1,0">
            <DockPanel>

                <!-- App identity -->
                <Border DockPanel.Dock="Top" Height="56" Padding="20,0">
                    <TextBlock Text="ARKADIA"
                               FontSize="14" FontWeight="Bold" LetterSpacing="3"
                               Foreground="{DynamicResource ArkAccent}"
                               VerticalAlignment="Center"/>
                </Border>

                <!-- Top separator -->
                <Border DockPanel.Dock="Top" Height="1" Margin="12,0,12,8"
                        Background="{DynamicResource ArkSurfaceAlt}"/>

                <!-- ── Bottom nav (Logs + Settings) — docked before main so it stays at bottom ── -->
                <StackPanel DockPanel.Dock="Bottom" Margin="8,8" Spacing="2">

                    <Border Height="1" Margin="4,0,4,6"
                            Background="{DynamicResource ArkSurfaceAlt}"/>

                    <!-- Logs -->
                    <Button x:Name="NavLogs" Classes="nav" Tag="Logs" Click="OnNavClick">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <PathIcon Width="14" Height="14"
                                      Data="M0 0H1.5V14H0Z M3 2H14V4H3Z M3 7H14V9H3Z M3 12H11V14H3Z"/>
                            <TextBlock Text="Logs" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Settings -->
                    <Button x:Name="NavSettings" Classes="nav" Tag="Settings" Click="OnNavClick">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <PathIcon Width="14" Height="14"
                                      Data="M5.5 0L6.5 2.5C5.3 3 4.2 3.8 3.4 4.9L1 4.2 0 6 1.4 7.1C1.3 7.4 1.3 7.7 1.3 8 1.3 8.3 1.4 8.6 1.4 8.9L0 10 1 11.8 3.4 11.1C4.2 12.2 5.3 13 6.5 13.5L5.5 16H8.5L7.5 13.5C8.7 13 9.8 12.2 10.6 11.1L13 11.8 14 10 12.6 8.9C12.7 8.6 12.7 8.3 12.7 8 12.7 7.7 12.6 7.4 12.6 7.1L14 6 13 4.2 10.6 4.9C9.8 3.8 8.7 3 7.5 2.5L8.5 0Z M7 5.5A2.5 2.5 0 1 0 7 10.5A2.5 2.5 0 0 0 7 5.5Z"/>
                            <TextBlock Text="Settings" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                </StackPanel>

                <!-- ── Main nav ── -->
                <StackPanel DockPanel.Dock="Top" Margin="8,0" Spacing="2">

                    <!-- Dashboard -->
                    <Button x:Name="NavDashboard" Classes="nav active" Tag="Dashboard" Click="OnNavClick">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <PathIcon Width="14" Height="14"
                                      Data="M0 0H6V6H0Z M8 0H14V6H8Z M0 8H6V14H0Z M8 8H14V14H8Z"/>
                            <TextBlock Text="Dashboard" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Library -->
                    <Button x:Name="NavLibrary" Classes="nav" Tag="Library" Click="OnNavClick">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <PathIcon Width="14" Height="14"
                                      Data="M0 1H14V3H0Z M0 6H14V8H0Z M0 11H14V13H0Z"/>
                            <TextBlock Text="Library" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Volumes -->
                    <Button x:Name="NavVolumes" Classes="nav" Tag="Volumes" Click="OnNavClick">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <PathIcon Width="14" Height="14"
                                      Data="M2 3C2 1.9 4.2 1 7 1 9.8 1 12 1.9 12 3L12 11C12 12.1 9.8 13 7 13 4.2 13 2 12.1 2 11Z M2 3C2 4.1 4.2 5 7 5 9.8 5 12 4.1 12 3"/>
                            <TextBlock Text="Volumes" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Disks (ring — even-odd fill) -->
                    <Button x:Name="NavDisks" Classes="nav" Tag="Disks" Click="OnNavClick">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <PathIcon Width="14" Height="14"
                                      Data="F1 M7 0A7 7 0 1 0 7 14A7 7 0 1 0 7 0Z M7 3.5A3.5 3.5 0 1 0 7 10.5A3.5 3.5 0 1 0 7 3.5Z"/>
                            <TextBlock Text="Disks" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Operations -->
                    <Button x:Name="NavOperations" Classes="nav" Tag="Operations" Click="OnNavClick">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <PathIcon Width="14" Height="14"
                                      Data="M0 0H4V4H0Z M6 1H14V3H6Z M0 5H4V9H0Z M6 6H14V8H6Z M0 10H4V14H0Z M6 11H14V13H6Z"/>
                            <TextBlock Text="Operations" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                </StackPanel>

            </DockPanel>
        </Border>

        <!-- ══════════════════════════════ Main area ══════════════════════════════ -->
        <Grid Grid.Column="1" RowDefinitions="56,*">

            <!-- Header bar -->
            <Border Grid.Row="0"
                    Background="{DynamicResource ArkSurface}"
                    BorderBrush="{DynamicResource ArkSurfaceAlt}"
                    BorderThickness="0,0,0,1"
                    Padding="24,0">
                <TextBlock x:Name="PageTitle"
                           Text="Dashboard"
                           FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource ArkTextPrimary}"
                           VerticalAlignment="Center"/>
            </Border>

            <!-- Content area -->
            <Border Grid.Row="1" Padding="32">
                <TextBlock Text="Select a section from the sidebar."
                           FontSize="13"
                           Foreground="{DynamicResource ArkTextSecondary}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

        </Grid>
    </Grid>
</Window>
