<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Arkadia.GroupVerifyDialog"
        Title="Arkadia - Verify Group"
        Width="560" Height="360"
        MinWidth="460" MinHeight="300"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#0F0F14"
        FontFamily="Inter,Segoe UI,sans-serif">

    <Grid RowDefinitions="Auto,*,Auto" Margin="22,20,22,18">

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="3">
            <TextBlock x:Name="HeaderName" FontSize="15" FontWeight="SemiBold" Foreground="#E8E8F0"/>
            <TextBlock x:Name="HeaderSub"  FontSize="12" Foreground="#888899" Text="Verifying each leaf DAT in turn…"/>
        </StackPanel>

        <!-- Body: progress + (on failure) decision panel -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="14">

            <StackPanel x:Name="ProgressPanel" Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <ProgressBar x:Name="Spinner" IsIndeterminate="True" Width="120" Height="6"
                                 Foreground="#7B68EE" Background="#242433" VerticalAlignment="Center"/>
                    <TextBlock x:Name="CurrentLabel" FontSize="13" Foreground="#C8C8E0" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="LeafLabel"      FontSize="12" Foreground="#AAAACC"/>
                <TextBlock x:Name="CompletedLabel" FontSize="12" Foreground="#888899"/>
            </StackPanel>

            <Border x:Name="FailurePanel" IsVisible="False"
                    Background="#241A1A" BorderBrush="#5A2A2A" BorderThickness="1"
                    CornerRadius="6" Padding="14">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="FailureTitle" FontSize="13" FontWeight="SemiBold" Foreground="#EF9A9A"/>
                    <TextBlock x:Name="FailureReason" FontSize="12" Foreground="#D8B0B0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="FailureContext" FontSize="11" Foreground="#997777"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="SummaryLabel" IsVisible="False" FontSize="13" Foreground="#C8C8E0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Footer buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,14,0,0">
            <Button x:Name="RetryButton" Content="Retry" IsVisible="False"
                    Background="#7B68EE" Foreground="#FFFFFF" Padding="22,8" CornerRadius="6" BorderThickness="0"
                    Click="OnRetry"/>
            <Button x:Name="StopButton" Content="Stop" IsVisible="False"
                    Background="#1E1E2C" Foreground="#EF9A9A" BorderBrush="#5A2A2A" BorderThickness="1"
                    Padding="22,8" CornerRadius="6"
                    Click="OnStop"/>
            <Button x:Name="CloseButton" Content="Close" IsVisible="False"
                    Background="#1E1E2C" Foreground="#AAAACC" BorderBrush="#2A2A3C" BorderThickness="1"
                    Padding="22,8" CornerRadius="6"
                    Click="OnClose"/>
        </StackPanel>
    </Grid>
</Window>
