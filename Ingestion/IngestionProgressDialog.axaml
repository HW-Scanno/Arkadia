<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Arkadia"
        xmlns:ing="using:Arkadia.Ingestion"
        x:Class="Arkadia.IngestionProgressDialog"
        Title="Ingest Files"
        Width="1060" Height="740"
        MinWidth="900" MinHeight="540"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        Background="#0F0F14"
        FontFamily="Inter,Segoe UI,sans-serif">

    <Window.Resources>
        <local:ActionColorConverter x:Key="ActionColor"/>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="CheckBox.filter">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Foreground" Value="#AAAACC"/>
            <Setter Property="Padding"    Value="4,0,0,0"/>
        </Style>
        <Style Selector="TextBlock.col-header">
            <Setter Property="FontSize"      Value="10"/>
            <Setter Property="FontWeight"    Value="SemiBold"/>
            <Setter Property="Foreground"    Value="#555566"/>
            <Setter Property="LetterSpacing" Value="1"/>
        </Style>
    </Window.Styles>

    <!--
        Root Grid rows — all fixed sections are explicit rows, none collapse:
          0 Auto  — title
          1 Auto  — progress area (stays visible after completion)
          2 Auto  — filter bar
          3 *     — operations table (header + scrollable rows, shared horizontal scroll)
          4 Auto  — summary / failed
          5 Auto  — OK button
    -->
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" Margin="28,24,28,20">

        <!-- Row 0: Title -->
        <TextBlock Grid.Row="0"
                   x:Name="OpTitle"
                   FontSize="13" FontWeight="SemiBold"
                   Foreground="#F0F0F0"
                   TextWrapping="Wrap"
                   Margin="0,0,0,14"/>

        <!-- Row 1: Progress area — always visible, never hidden -->
        <Border Grid.Row="1"
                x:Name="RunningPanel"
                Background="#1A1A24" CornerRadius="6" Padding="16,14"
                Margin="0,0,0,2">
            <StackPanel Spacing="10">
                <TextBlock x:Name="PhaseText"
                           FontSize="12" Foreground="#888899"/>

                <ProgressBar x:Name="OpProgress"
                             IsIndeterminate="True"
                             Height="4"
                             Foreground="#7B68EE"
                             Background="#242433"
                             CornerRadius="2"
                             Minimum="0" Maximum="100" Value="0"/>

                <Grid ColumnDefinitions="*,*,*" Margin="0,4,0,0">
                    <StackPanel Grid.Column="0" Spacing="2" HorizontalAlignment="Center">
                        <TextBlock Text="PROCESSED" FontSize="9" LetterSpacing="1.2"
                                   Foreground="#555566" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="CountProcessed" Text="0"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="#888899" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="2" HorizontalAlignment="Center">
                        <TextBlock Text="MATCHED" FontSize="9" LetterSpacing="1.2"
                                   Foreground="#555566" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="CountAccepted" Text="0"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="#4CAF50" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="2" HorizontalAlignment="Center">
                        <TextBlock Text="SKIPPED" FontSize="9" LetterSpacing="1.2"
                                   Foreground="#555566" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="CountRejected" Text="0"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="#FFA726" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Row 2: Filter bar — always visible -->
        <Border Grid.Row="2"
                Background="#1A1A24"
                Padding="12,8,12,8"
                Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <TextBlock Text="FILTER:" FontSize="10" FontWeight="SemiBold"
                           LetterSpacing="1" Foreground="#555566"
                           VerticalAlignment="Center"/>
                <CheckBox x:Name="FilterHash"      Classes="filter" Content="Hash"
                          IsChecked="True" IsCheckedChanged="OnFilterChanged"/>
                <CheckBox x:Name="FilterCopy"      Classes="filter" Content="Copy"
                          IsChecked="True" IsCheckedChanged="OnFilterChanged"/>
                <CheckBox x:Name="FilterTransform" Classes="filter" Content="Transform"
                          IsChecked="True" IsCheckedChanged="OnFilterChanged"/>
                <CheckBox x:Name="FilterSource"    Classes="filter" Content="Source"
                          IsChecked="True" IsCheckedChanged="OnFilterChanged"/>
                <CheckBox x:Name="FilterDelete"    Classes="filter" Content="Delete"
                          IsChecked="True" IsCheckedChanged="OnFilterChanged"/>
                <CheckBox x:Name="FilterSkip"      Classes="filter" Content="Skip"
                          IsChecked="True" IsCheckedChanged="OnFilterChanged"/>
                <CheckBox x:Name="FilterFailed"    Classes="filter" Content="Failed"
                          IsChecked="True" IsCheckedChanged="OnFilterChanged"/>
                <TextBlock x:Name="OpsCountLabel"
                           FontSize="10" Foreground="#555566"
                           VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Row 3: Operations table — header + rows share one horizontal scroll.
             Outer ScrollViewer scrolls horizontally (both header and rows move together);
             the inner ScrollViewer handles vertical row overflow. Columns are star-sized
             with per-column minimums, and the table grid width is synced in code-behind to
             max(viewport width, minimum table width): it fills a wide dialog with no empty
             side margins, and falls back to the minimum (revealing the horizontal bar) when
             the dialog is narrower than readable. Minimum table width = 420 + 220 + 440
             (column minimums) + 24 (12+12 border padding) = 1104. -->
        <ScrollViewer Grid.Row="3"
                      x:Name="OpsHScrollViewer"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled"
                      Margin="0,0,0,10">
            <Grid x:Name="OpsTableGrid" RowDefinitions="Auto,*" MinWidth="1104">

                <!-- Column headers — scroll horizontally with the rows, fixed vertically.
                     Columns must match the row template exactly to stay aligned. -->
                <Border Grid.Row="0"
                        Padding="12,6,12,6"
                        Background="#141420"
                        BorderBrush="#242433" BorderThickness="0,1,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"  MinWidth="420"/>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="2*" MinWidth="440"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Classes="col-header" Text="FILE"/>
                        <TextBlock Grid.Column="1" Classes="col-header" Text="ACTION"/>
                        <TextBlock Grid.Column="2" Classes="col-header" Text="DESTINATION"/>
                    </Grid>
                </Border>

                <!-- Scrollable operations rows — fills remaining height -->
                <Border Grid.Row="1"
                        Background="#1A1A24">
                    <ScrollViewer x:Name="OpsScrollViewer"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="OpsList" Padding="0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="ing:IngestionOperation">
                                    <Border Padding="12,3,12,3"
                                            BorderBrush="#0D0D13" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"  MinWidth="420"/>
                                                <ColumnDefinition Width="220"/>
                                                <ColumnDefinition Width="2*" MinWidth="440"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Object}"
                                                       FontSize="11"
                                                       Foreground="#CCCCDD"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Label}"
                                                       FontSize="11" FontWeight="Bold"
                                                       Foreground="{Binding Action, Converter={StaticResource ActionColor}}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Destination}"
                                                       FontSize="10"
                                                       FontFamily="Consolas,Courier New,monospace"
                                                       Foreground="#888899"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

            </Grid>
        </ScrollViewer>

        <!-- Row 4: Summary / Failed panels -->
        <StackPanel Grid.Row="4" Spacing="0">

            <StackPanel x:Name="SummaryPanel" IsVisible="False" Spacing="0">
                <TextBlock x:Name="SumStatusTitle"
                           Text="INGESTION COMPLETED"
                           FontSize="10" FontWeight="SemiBold" LetterSpacing="1.8"
                           Foreground="#888899" Margin="0,0,0,10"/>

                <Border Background="#1A1A24" CornerRadius="6" Padding="16,12" Margin="0,0,0,10">
                    <!-- Rows are populated in code-behind from IngestionSummary.CoreCounters
                         so the dialog and the final log always show the same counter set. -->
                    <StackPanel x:Name="SummaryCountersPanel" Spacing="6"/>
                </Border>

                <TextBlock x:Name="SumNote"
                           IsVisible="False"
                           FontSize="12" Foreground="#9E9E9E"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10"/>
            </StackPanel>

            <StackPanel x:Name="FailedPanel" IsVisible="False" Spacing="0">
                <TextBlock x:Name="FailedTitle"
                           Text="OPERATION FAILED"
                           FontSize="10" FontWeight="SemiBold" LetterSpacing="1.8"
                           Foreground="#EF5350" Margin="0,0,0,10"/>

                <Border Background="#1A1A24" CornerRadius="6" Padding="16,12" Margin="0,0,0,10">
                    <TextBlock x:Name="FailedMessage"
                               FontSize="12" Foreground="#EF5350"
                               TextWrapping="Wrap"/>
                </Border>
            </StackPanel>

        </StackPanel>

        <!-- Row 5: OK button -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,4,0,0">
            <Button x:Name="OkButton"
                    Content="OK"
                    IsEnabled="False"
                    Background="#7B68EE" Foreground="#FFFFFF"
                    Padding="24,8" CornerRadius="6" BorderThickness="0"
                    Click="OnOk"/>
        </StackPanel>

    </Grid>
</Window>
