<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Arkadia"
        x:Class="Arkadia.GroupPlanVolumeDialog"
        Title="Group Volume Plan (Preview)"
        Width="820" Height="620"
        MinWidth="640" MinHeight="400"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        Background="#0F0F14"
        FontFamily="Inter,Segoe UI,sans-serif">

    <Window.Styles>
        <Style Selector="TextBlock.col-header">
            <Setter Property="FontSize"      Value="10"/>
            <Setter Property="FontWeight"    Value="SemiBold"/>
            <Setter Property="Foreground"    Value="#555566"/>
            <Setter Property="LetterSpacing" Value="1"/>
        </Style>
        <Style Selector="TextBlock.stat-label">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Foreground" Value="#555566"/>
        </Style>
        <Style Selector="TextBlock.stat-val">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#CCCCDD"/>
        </Style>
        <Style Selector="Button.secondary">
            <Setter Property="Background"   Value="#1E1E2C"/>
            <Setter Property="Foreground"   Value="#AAAACC"/>
            <Setter Property="Padding"      Value="20,8"/>
            <Setter Property="FontSize"     Value="13"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Cursor"       Value="Hand"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" Margin="0">

        <!-- Header -->
        <Border Grid.Row="0" Padding="24,16,24,14" BorderBrush="#181826" BorderThickness="0,0,0,1">
            <StackPanel Spacing="3">
                <TextBlock x:Name="DialogTitle" FontSize="15" FontWeight="SemiBold" Foreground="#E8E8F0"/>
                <TextBlock Text="READ-ONLY PREVIEW — no changes will be committed"
                           FontSize="10" LetterSpacing="1" Foreground="#555566"/>
            </StackPanel>
        </Border>

        <!-- Loading -->
        <StackPanel Grid.Row="1" x:Name="LoadingRow" Orientation="Horizontal" Spacing="10" Margin="24,12,24,12">
            <ProgressBar x:Name="LoadSpinner" IsIndeterminate="True" Width="140" Height="6"
                         Foreground="#7B68EE" Background="#242433" VerticalAlignment="Center"/>
            <TextBlock x:Name="LoadStatus" FontSize="12" Foreground="#888899"
                       VerticalAlignment="Center" Text="Planning…"/>
        </StackPanel>

        <!-- Readiness banner -->
        <Border Grid.Row="2" x:Name="ReadinessBanner" IsVisible="False" Padding="24,10" Margin="24,4,24,0" CornerRadius="6">
            <TextBlock x:Name="ReadinessText" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
        </Border>

        <!-- Summary stats -->
        <Border Grid.Row="3" x:Name="StatsPanel" IsVisible="False" Background="#1A1A24" Padding="24,12,24,12"
                BorderBrush="#181826" BorderThickness="0,1,0,1" Margin="0,10,0,0">
            <Grid ColumnDefinitions="*,*,*,*" RowDefinitions="Auto,Auto">
                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2" Margin="0,0,16,8">
                    <TextBlock Classes="stat-label" Text="CAPACITY"/><TextBlock x:Name="StatCapacity" Classes="stat-val"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1" Spacing="2" Margin="0,0,16,8">
                    <TextBlock Classes="stat-label" Text="USED"/><TextBlock x:Name="StatUsed" Classes="stat-val"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2" Spacing="2" Margin="0,0,16,8">
                    <TextBlock Classes="stat-label" Text="REMAINING BEFORE"/><TextBlock x:Name="StatRemainingBefore" Classes="stat-val"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="3" Spacing="2">
                    <TextBlock Classes="stat-label" Text="LEAVES"/><TextBlock x:Name="StatLeaves" Classes="stat-val"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="2" Margin="0,0,16,0">
                    <TextBlock Classes="stat-label" Text="PLANNED"/><TextBlock x:Name="StatPlanned" Classes="stat-val" Foreground="#81C784"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2" Margin="0,0,16,0">
                    <TextBlock Classes="stat-label" Text="REMAINING AFTER"/><TextBlock x:Name="StatRemainingAfter" Classes="stat-val"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Spacing="2" Margin="0,0,16,0">
                    <TextBlock Classes="stat-label" Text="INCLUDED"/><TextBlock x:Name="StatIncluded" Classes="stat-val" Foreground="#81C784"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="3" Spacing="2">
                    <TextBlock Classes="stat-label" Text="SKIP / DEFER"/><TextBlock x:Name="StatSkipDefer" Classes="stat-val" Foreground="#FFB74D"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Per-leaf collapsed rows -->
        <Border Grid.Row="4" Background="#1A1A24">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="LeafList" Padding="0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:GroupLeafDisplayRow">
                            <Border Padding="16,6,16,6" BorderBrush="#0D0D13" BorderThickness="0,0,0,1">
                                <Grid ColumnDefinitions="*,Auto,90">
                                    <StackPanel Grid.Column="0" Spacing="1">
                                        <TextBlock Text="{Binding DatLineId}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="#C8C8E0" FontFamily="Consolas,Courier New,monospace"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding DisplayName}" FontSize="10" Foreground="#666677"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding CountsLabel}" FontSize="11"
                                               Foreground="#9999AA" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding SizeLabel}" FontSize="11"
                                               FontFamily="Consolas,Courier New,monospace" Foreground="#81C784"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Footer: read-only, Close only -->
        <Border Grid.Row="5" Padding="24,12,24,16" BorderBrush="#181826" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Classes="secondary" Content="Close" Click="OnClose"/>
            </StackPanel>
        </Border>

    </Grid>
</Window>
