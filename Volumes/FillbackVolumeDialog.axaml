<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Arkadia"
        x:Class="Arkadia.FillbackVolumeDialog"
        Title="Arkadia - Fillback Volume"
        Width="960" Height="680"
        MinWidth="720" MinHeight="520"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        Background="#0F0F14"
        FontFamily="Inter,Segoe UI,sans-serif">

    <Window.Resources>
        <local:VerifyResultColorConverter x:Key="ActionColor"/>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="TextBlock.section-label">
            <Setter Property="FontSize"     Value="10"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="Foreground"   Value="#555566"/>
            <Setter Property="LetterSpacing" Value="1"/>
            <Setter Property="Margin"       Value="0,0,0,3"/>
        </Style>
        <Style Selector="TextBlock.volume-name">
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#E8E8F0"/>
        </Style>
        <Style Selector="TextBlock.stat-label">
            <Setter Property="FontSize"    Value="10"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Foreground"  Value="#555566"/>
            <Setter Property="LetterSpacing" Value="0.8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width"       Value="180"/>
        </Style>
        <Style Selector="TextBlock.stat-value">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Foreground" Value="#AAAACC"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.col-header">
            <Setter Property="FontSize"    Value="10"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Foreground"  Value="#555566"/>
            <Setter Property="LetterSpacing" Value="1"/>
        </Style>
        <Style Selector="TextBlock.cell">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Foreground" Value="#CCCCDD"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.bar-label">
            <Setter Property="FontSize"    Value="10"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Foreground"  Value="#666677"/>
            <Setter Property="LetterSpacing" Value="0.8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width"       Value="76"/>
        </Style>
        <Style Selector="TextBlock.bar-bytes">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Foreground" Value="#AAAACC"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Width"      Value="88"/>
        </Style>
        <Style Selector="Button.action-btn">
            <Setter Property="Background"      Value="#7B68EE"/>
            <Setter Property="Foreground"      Value="#FFFFFF"/>
            <Setter Property="Padding"         Value="24,8"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="CornerRadius"    Value="6"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.close-btn">
            <Setter Property="Background"      Value="#444455"/>
            <Setter Property="Foreground"      Value="#CCCCDD"/>
            <Setter Property="Padding"         Value="24,8"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="CornerRadius"    Value="6"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Styles>

    <!--
        Two overlapping views switched via IsVisible:
          PlanView   — shown initially (target selection + plan summary + Execute btn)
          ProgressView — shown during/after execution (bars + progress rows + Close btn)
    -->
    <Grid RowDefinitions="*" Margin="24,20,24,18">

        <!-- ═══ PLAN VIEW ════════════════════════════════════════════════════ -->
        <Grid x:Name="PlanView"
              RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto,Auto"
              IsVisible="True">

            <!-- Row 0: Source / Target header -->
            <Border Grid.Row="0"
                    Background="#1A1A24" CornerRadius="6" Padding="16,14"
                    Margin="0,0,0,12">
                <Grid ColumnDefinitions="*,40,*">

                    <!-- Source column -->
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Classes="section-label" Text="MOVE ARTIFACTS FROM"/>
                        <TextBlock x:Name="PlanSourceLabel"  Classes="volume-name"/>
                        <TextBlock x:Name="PlanSourceDisk"
                                   FontSize="11" Foreground="#666677"/>
                    </StackPanel>

                    <!-- Arrow -->
                    <TextBlock Grid.Column="1"
                               Text="→"
                               FontSize="18" Foreground="#444455"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>

                    <!-- Target column -->
                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock Classes="section-label" Text="FILL FREE SPACE INTO"/>
                        <ComboBox x:Name="TargetComboBox"
                                  PlaceholderText="Select target volume…"
                                  Background="#242433"
                                  Foreground="#E8E8F0"
                                  BorderBrush="#444455"
                                  FontSize="12"
                                  SelectionChanged="OnTargetChanged"/>
                    </StackPanel>

                </Grid>
            </Border>

            <!-- Row 1: Plan stats (shown after plan built) -->
            <Border x:Name="PlanStatsPanel"
                    Grid.Row="1"
                    Background="#141420" CornerRadius="4" Padding="14,10"
                    Margin="0,0,0,8"
                    IsVisible="False">
                <Grid ColumnDefinitions="*,*,*">
                    <!-- Left column -->
                    <StackPanel Grid.Column="0" Spacing="5">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="stat-label" Text="OPERATION MODE"/>
                            <TextBlock x:Name="StatMode"   Classes="stat-value"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="stat-label" Text="TARGET FREE SPACE"/>
                            <TextBlock x:Name="StatTargetFree" Classes="stat-value"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="stat-label" Text="PLANNED TO MOVE"/>
                            <TextBlock x:Name="StatPlanned"  Classes="stat-value"/>
                        </StackPanel>
                    </StackPanel>
                    <!-- Centre column -->
                    <StackPanel Grid.Column="1" Spacing="5">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="stat-label" Text="REMAINING FREE AFTER"/>
                            <TextBlock x:Name="StatRemaining" Classes="stat-value"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="stat-label" Text="SOURCE AFTER"/>
                            <TextBlock x:Name="StatSourceAfter" Classes="stat-value"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="stat-label" Text="TARGET AFTER"/>
                            <TextBlock x:Name="StatTargetAfter" Classes="stat-value"/>
                        </StackPanel>
                    </StackPanel>
                    <!-- Right column -->
                    <StackPanel Grid.Column="2" Spacing="5">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="stat-label" Text="PLANNED FILES"/>
                            <TextBlock x:Name="StatCount"    Classes="stat-value"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="stat-label" Text="SKIPPED FILES"/>
                            <TextBlock x:Name="StatSkipped"  Classes="stat-value"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Row 2: Issues / warnings (shown when present) -->
            <Border x:Name="IssuesPanel"
                    Grid.Row="2"
                    Background="#2A1A1A" CornerRadius="4" Padding="12,8"
                    Margin="0,0,0,8"
                    IsVisible="False">
                <TextBlock x:Name="IssuesText"
                           FontSize="11"
                           Foreground="#EF9A9A"
                           TextWrapping="Wrap"/>
            </Border>

            <!-- Row 3: Table column headers -->
            <Border Grid.Row="3"
                    Padding="12,6,12,6"
                    Margin="0,0,0,0"
                    Background="#141420"
                    BorderBrush="#242433" BorderThickness="0,1,0,1">
                <Grid ColumnDefinitions="80,90,*,80,2*">
                    <TextBlock Grid.Column="0" Classes="col-header" Text="ACTION"/>
                    <TextBlock Grid.Column="1" Classes="col-header" Text="RELEASE" Margin="8,0,0,0"/>
                    <TextBlock Grid.Column="2" Classes="col-header" Text="FILE"    Margin="8,0,0,0"/>
                    <TextBlock Grid.Column="3" Classes="col-header" Text="SIZE"    HorizontalAlignment="Right"/>
                    <TextBlock Grid.Column="4" Classes="col-header" Text="REASON"  Margin="8,0,0,0"/>
                </Grid>
            </Border>

            <!-- Row 4: Plan rows -->
            <Border Grid.Row="4"
                    Background="#1A1A24"
                    Margin="0,0,0,8">
                <ScrollViewer x:Name="PlanRowsScroll"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="PlanRowsList" Padding="0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:FillbackPlanRow">
                                <Border Padding="12,3,12,3"
                                        BorderBrush="#0D0D13" BorderThickness="0,0,0,1">
                                    <Grid ColumnDefinitions="80,90,*,80,2*">
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Action}"
                                                   Classes="cell"
                                                   FontWeight="Bold"
                                                   Foreground="{Binding Action, Converter={StaticResource ActionColor}}"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Release}"
                                                   Classes="cell"
                                                   FontSize="10"
                                                   Foreground="#666677"
                                                   Margin="8,0,0,0"/>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding FileName}"
                                                   Classes="cell"
                                                   FontFamily="Consolas,Courier New,monospace"
                                                   FontSize="10"
                                                   Foreground="#888899"
                                                   Margin="8,0,0,0"/>
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding SizeLabel}"
                                                   Classes="cell"
                                                   HorizontalAlignment="Right"
                                                   Foreground="#666677"/>
                                        <TextBlock Grid.Column="4"
                                                   Text="{Binding Reason}"
                                                   Classes="cell"
                                                   FontSize="10"
                                                   Foreground="#777788"
                                                   Margin="8,0,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Row 5: Skip summary (shown when skips present) -->
            <Border x:Name="SkipSummaryPanel"
                    Grid.Row="5"
                    Background="#1A1420" CornerRadius="4" Padding="12,8"
                    Margin="0,0,0,8"
                    IsVisible="False">
                <TextBlock x:Name="SkipSummaryText"
                           FontSize="11"
                           Foreground="#AA8899"
                           TextWrapping="Wrap"/>
            </Border>

            <!-- Row 6: Plan hint -->
            <TextBlock Grid.Row="6"
                       x:Name="PlanHint"
                       FontSize="11"
                       Foreground="#555566"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8"
                       Text="Select a target volume to build the plan."/>

            <!-- Row 7: Buttons -->
            <StackPanel Grid.Row="7"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8">
                <Button x:Name="ExecuteButton"
                        Classes="action-btn"
                        Content="Execute Fillback"
                        IsEnabled="False"
                        Click="OnExecute"/>
                <Button x:Name="PlanCancelButton"
                        Classes="close-btn"
                        Content="Cancel"
                        Click="OnCancel"/>
            </StackPanel>

        </Grid>

        <!-- ═══ PROGRESS VIEW ════════════════════════════════════════════════ -->
        <Grid x:Name="ProgressView"
              RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto"
              IsVisible="False">

            <!-- Row 0: Header -->
            <TextBlock Grid.Row="0"
                       x:Name="ProgressHeader"
                       FontSize="15" FontWeight="SemiBold"
                       Foreground="#E8E8F0"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12"/>

            <!-- Row 1: Progress bars -->
            <Border Grid.Row="1"
                    Background="#1A1A24" CornerRadius="6" Padding="16,14"
                    Margin="0,0,0,0">
                <StackPanel Spacing="10">

                    <!-- MOVED / COPIED bar -->
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Grid.Column="0" Classes="bar-label" x:Name="BarMovedLabel" Text="MOVED"/>
                        <Border Grid.Column="1" x:Name="MovedBarTrack"
                                Height="12" CornerRadius="2"
                                Background="#242433"
                                VerticalAlignment="Center" Margin="8,0">
                            <Border x:Name="MovedBarFill"
                                    HorizontalAlignment="Left"
                                    Height="12" CornerRadius="2"
                                    Background="#81C784" Width="0"/>
                        </Border>
                        <TextBlock Grid.Column="2" Classes="bar-bytes" x:Name="MovedBytesLabel" Text="—"/>
                    </Grid>

                    <!-- VERIFIED bar -->
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Grid.Column="0" Classes="bar-label" Text="VERIFIED"/>
                        <Border Grid.Column="1" x:Name="VerifiedBarTrack"
                                Height="12" CornerRadius="2"
                                Background="#242433"
                                VerticalAlignment="Center" Margin="8,0">
                            <Border x:Name="VerifiedBarFill"
                                    HorizontalAlignment="Left"
                                    Height="12" CornerRadius="2"
                                    Background="#CE93D8" Width="0"/>
                        </Border>
                        <TextBlock Grid.Column="2" Classes="bar-bytes" x:Name="VerifiedBytesLabel" Text="—"/>
                    </Grid>

                </StackPanel>
            </Border>

            <!-- Row 2: Status line -->
            <TextBlock Grid.Row="2"
                       x:Name="ProgressStatusLine"
                       FontSize="11"
                       FontFamily="Consolas,Courier New,monospace"
                       Foreground="#666677"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,8,0,0"/>

            <!-- Row 3: Table column headers -->
            <Border Grid.Row="3"
                    Padding="12,6,12,6"
                    Margin="0,8,0,0"
                    Background="#141420"
                    BorderBrush="#242433" BorderThickness="0,1,0,1">
                <Grid ColumnDefinitions="120,*,80">
                    <TextBlock Grid.Column="0" Classes="col-header" Text="ACTION"/>
                    <TextBlock Grid.Column="1" Classes="col-header" Text="FILE"  Margin="8,0,0,0"/>
                    <TextBlock Grid.Column="2" Classes="col-header" Text="DETAIL" HorizontalAlignment="Right"/>
                </Grid>
            </Border>

            <!-- Row 4: Progress rows -->
            <Border Grid.Row="4"
                    Background="#1A1A24"
                    Margin="0,0,0,8">
                <ScrollViewer x:Name="ProgressRowsScroll"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ProgressRowsList" Padding="0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:FillbackProgressRow">
                                <Border Padding="12,3,12,3"
                                        BorderBrush="#0D0D13" BorderThickness="0,0,0,1">
                                    <Grid ColumnDefinitions="120,*,80">
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Action}"
                                                   Classes="cell"
                                                   FontWeight="Bold"
                                                   Foreground="{Binding Action, Converter={StaticResource ActionColor}}"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding FileName}"
                                                   Classes="cell"
                                                   FontFamily="Consolas,Courier New,monospace"
                                                   FontSize="10"
                                                   Foreground="#888899"
                                                   Margin="8,0,0,0"/>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Detail}"
                                                   Classes="cell"
                                                   HorizontalAlignment="Right"
                                                   FontSize="10"
                                                   Foreground="#555566"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Row 5: Phase label -->
            <TextBlock Grid.Row="5"
                       x:Name="PhaseLabel"
                       FontSize="12"
                       Foreground="#666677"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8"/>

            <!-- Row 6: Close button -->
            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CloseButton"
                        Classes="action-btn"
                        Content="Close"
                        IsEnabled="False"
                        Click="OnClose"/>
            </StackPanel>

        </Grid>

    </Grid>
</Window>
