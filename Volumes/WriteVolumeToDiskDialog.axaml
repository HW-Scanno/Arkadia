<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Arkadia"
        x:Class="Arkadia.WriteVolumeToDiskDialog"
        Title="Arkadia - Volume Operations"
        Width="960" Height="660"
        MinWidth="720" MinHeight="480"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        Background="#0F0F14"
        FontFamily="Inter,Segoe UI,sans-serif">

    <Window.Resources>
        <local:ActionColorConverter x:Key="ActionColor"/>
    </Window.Resources>

    <Window.Styles>

        <!-- Shimmer overlay — sine-like pulse, does NOT affect bar values -->
        <Style Selector="Border.shimmer">
            <Style.Animations>
                <Animation Duration="0:0:2.2" IterationCount="Infinite" FillMode="None">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0"/>
                    </KeyFrame>
                    <KeyFrame Cue="45%">
                        <Setter Property="Opacity" Value="0.13"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="TextBlock.bar-label">
            <Setter Property="FontSize"     Value="10"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="Foreground"   Value="#666677"/>
            <Setter Property="LetterSpacing" Value="0.8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width" Value="76"/>
        </Style>
        <Style Selector="TextBlock.bar-bytes">
            <Setter Property="FontSize"  Value="11"/>
            <Setter Property="Foreground" Value="#AAAACC"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Width" Value="88"/>
        </Style>
        <Style Selector="TextBlock.col-header">
            <Setter Property="FontSize"     Value="10"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="Foreground"   Value="#555566"/>
            <Setter Property="LetterSpacing" Value="1"/>
        </Style>
        <Style Selector="TextBlock.cell">
            <Setter Property="FontSize"  Value="11"/>
            <Setter Property="Foreground" Value="#CCCCDD"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.close-btn">
            <Setter Property="Background"   Value="#7B68EE"/>
            <Setter Property="Foreground"   Value="#FFFFFF"/>
            <Setter Property="Padding"      Value="24,8"/>
            <Setter Property="FontSize"     Value="13"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Styles>

    <!--
        Row layout:
          0 Auto  — header
          1 Auto  — bars + shimmer
          2 Auto  — status line
          3 Auto  — table column headers
          4 *     — scrollable row table
          5 Auto  — phase/completion label
          6 Auto  — close button
    -->
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto" Margin="24,20,24,18">

        <!-- Row 0: Operation header -->
        <TextBlock Grid.Row="0"
                   x:Name="HeaderText"
                   FontSize="15" FontWeight="SemiBold"
                   Foreground="#E8E8F0"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"/>

        <!-- Row 1: Bars section with shimmer overlay -->
        <Border Grid.Row="1"
                Background="#1A1A24" CornerRadius="6" Padding="16,14"
                Margin="0,0,0,0">
            <Grid>

                <!-- Actual bars (under shimmer) -->
                <StackPanel Spacing="10">

                    <!-- TO COPY bar (decreasing) -->
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Grid.Column="0" Classes="bar-label" Text="TO COPY"/>
                        <Border Grid.Column="1" x:Name="ToCopyBarTrack"
                                Height="12" CornerRadius="2"
                                Background="#242433"
                                VerticalAlignment="Center" Margin="8,0">
                            <Border x:Name="ToCopyBarFill"
                                    HorizontalAlignment="Left"
                                    Height="12" CornerRadius="2"
                                    Background="#81C784" Width="0"/>
                        </Border>
                        <TextBlock Grid.Column="2" Classes="bar-bytes" x:Name="ToCopyLabel" Text="—"/>
                    </Grid>

                    <!-- COPIED bar (increasing) -->
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Grid.Column="0" Classes="bar-label" Text="COPIED"/>
                        <Border Grid.Column="1" x:Name="CopiedBarTrack"
                                Height="12" CornerRadius="2"
                                Background="#242433"
                                VerticalAlignment="Center" Margin="8,0">
                            <Border x:Name="CopiedBarFill"
                                    HorizontalAlignment="Left"
                                    Height="12" CornerRadius="2"
                                    Background="#4DD0E1" Width="0"/>
                        </Border>
                        <TextBlock Grid.Column="2" Classes="bar-bytes" x:Name="CopiedLabel" Text="—"/>
                    </Grid>

                    <!-- VERIFIED bar (increasing) -->
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Grid.Column="0" Classes="bar-label" Text="VERIFIED"/>
                        <Border Grid.Column="1" x:Name="VerifiedBarTrack"
                                Height="12" CornerRadius="2"
                                Background="#242433"
                                VerticalAlignment="Center" Margin="8,0">
                            <Border x:Name="VerifiedBarFill"
                                    HorizontalAlignment="Left"
                                    Height="12" CornerRadius="2"
                                    Background="#CE93D8" Width="0"/>
                        </Border>
                        <TextBlock Grid.Column="2" Classes="bar-bytes" x:Name="VerifiedLabel" Text="—"/>
                    </Grid>

                </StackPanel>

                <!-- Shimmer overlay — purely decorative, no hit test -->
                <Border Classes="shimmer"
                        IsHitTestVisible="False"
                        CornerRadius="4">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                            <GradientStop Color="Transparent" Offset="0"/>
                            <GradientStop Color="White"       Offset="0.5"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

            </Grid>
        </Border>

        <!-- Row 2: Status line -->
        <TextBlock Grid.Row="2"
                   x:Name="StatusLine"
                   FontSize="11"
                   FontFamily="Consolas,Courier New,monospace"
                   Foreground="#666677"
                   TextTrimming="CharacterEllipsis"
                   Margin="0,8,0,0"/>

        <!-- Row 3: Table column headers -->
        <Border Grid.Row="3"
                Padding="12,6,12,6"
                Margin="0,8,0,0"
                Background="#141420"
                BorderBrush="#242433" BorderThickness="0,1,0,1">
            <Grid ColumnDefinitions="60,*,80">
                <TextBlock Grid.Column="0" Classes="col-header" Text="ACTION"/>
                <TextBlock Grid.Column="1" Classes="col-header" Text="PATH" Margin="8,0,0,0"/>
                <TextBlock Grid.Column="2" Classes="col-header" Text="SIZE" HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <!-- Row 4: Scrollable rows -->
        <Border Grid.Row="4"
                Background="#1A1A24"
                Margin="0,0,0,8">
            <ScrollViewer x:Name="RowsScroll"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="RowsList" Padding="0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:WriteVolumeRow">
                            <Border Padding="12,3,12,3"
                                    BorderBrush="#0D0D13" BorderThickness="0,0,0,1">
                                <Grid ColumnDefinitions="60,*,80">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Action}"
                                               Classes="cell"
                                               FontWeight="Bold"
                                               Foreground="{Binding Action, Converter={StaticResource ActionColor}}"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Path}"
                                               Classes="cell"
                                               FontFamily="Consolas,Courier New,monospace"
                                               FontSize="10"
                                               Foreground="#888899"
                                               Margin="8,0,0,0"/>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding SizeLabel}"
                                               Classes="cell"
                                               HorizontalAlignment="Right"
                                               Foreground="#666677"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Row 5: Phase / completion label -->
        <TextBlock Grid.Row="5"
                   x:Name="PhaseLabel"
                   FontSize="12"
                   Foreground="#666677"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8"/>

        <!-- Row 6: Close button -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CloseButton"
                    Classes="close-btn"
                    Content="Close"
                    IsEnabled="False"
                    Click="OnClose"/>
        </StackPanel>

    </Grid>
</Window>
