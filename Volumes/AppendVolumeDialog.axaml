<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Arkadia"
        x:Class="Arkadia.AppendVolumeDialog"
        Title="Arkadia - Append Volume"
        Width="960" Height="660"
        MinWidth="720" MinHeight="480"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        Background="#0F0F14"
        FontFamily="Inter,Segoe UI,sans-serif">

    <Window.Resources>
        <local:VerifyResultColorConverter x:Key="ActionColor"/>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="TextBlock.section-label">
            <Setter Property="FontSize"      Value="10"/>
            <Setter Property="FontWeight"    Value="SemiBold"/>
            <Setter Property="Foreground"    Value="#555566"/>
            <Setter Property="LetterSpacing" Value="1"/>
            <Setter Property="Margin"        Value="0,0,0,3"/>
        </Style>
        <Style Selector="TextBlock.volume-name">
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#E8E8F0"/>
        </Style>
        <Style Selector="TextBlock.stat-label">
            <Setter Property="FontSize"     Value="10"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="Foreground"   Value="#555566"/>
            <Setter Property="LetterSpacing" Value="0.8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width"        Value="200"/>
        </Style>
        <Style Selector="TextBlock.stat-value">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Foreground" Value="#AAAACC"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.col-header">
            <Setter Property="FontSize"    Value="10"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Foreground"  Value="#555566"/>
            <Setter Property="LetterSpacing" Value="1"/>
        </Style>
        <Style Selector="TextBlock.cell">
            <Setter Property="FontSize"    Value="11"/>
            <Setter Property="Foreground"  Value="#CCCCDD"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.bar-label">
            <Setter Property="FontSize"    Value="10"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Foreground"  Value="#666677"/>
            <Setter Property="LetterSpacing" Value="0.8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width"       Value="76"/>
        </Style>
        <Style Selector="TextBlock.bar-bytes">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Foreground" Value="#AAAACC"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Width"      Value="88"/>
        </Style>
        <Style Selector="Button.action-btn">
            <Setter Property="Background"      Value="#7B68EE"/>
            <Setter Property="Foreground"      Value="#FFFFFF"/>
            <Setter Property="Padding"         Value="24,8"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="CornerRadius"    Value="6"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.close-btn">
            <Setter Property="Background"      Value="#444455"/>
            <Setter Property="Foreground"      Value="#CCCCDD"/>
            <Setter Property="Padding"         Value="24,8"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="CornerRadius"    Value="6"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="*" Margin="24,20,24,18">

        <!-- ═══ PLAN VIEW ════════════════════════════════════════════════════ -->
        <Grid x:Name="PlanView"
              RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto,Auto"
              IsVisible="True">

            <!-- Row 0: Volume header -->
            <Border Grid.Row="0"
                    Background="#1A1A24" CornerRadius="6" Padding="16,14"
                    Margin="0,0,0,12">
                <StackPanel Spacing="4">
                    <TextBlock Classes="section-label" Text="APPEND TO VOLUME"/>
                    <TextBlock x:Name="PlanVolumeLabel" Classes="volume-name"/>
                    <TextBlock x:Name="PlanVolumeStats"
                               FontSize="11" Foreground="#666677"/>
                </StackPanel>
            </Border>

            <!-- Row 1: Plan stats -->
            <Border x:Name="PlanStatsPanel"
                    Grid.Row="1"
                    Background="#141420" CornerRadius="4" Padding="14,10"
                    Margin="0,0,0,8"
                    IsVisible="False">
                <Grid ColumnDefinitions="*,*,*">
                    <StackPanel Grid.Column="0" Spacing="5">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="stat-label" Text="TOTAL ARCHIVE CANDIDATES"/>
                            <TextBlock x:Name="StatTotal"    Classes="stat-value"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="stat-label" Text="PLANNED TO COPY"/>
                            <TextBlock x:Name="StatPlanned"  Classes="stat-value"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="stat-label" Text="SKIPPED"/>
                            <TextBlock x:Name="StatSkipped"  Classes="stat-value"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="5">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="stat-label" Text="TARGET FREE SPACE"/>
                            <TextBlock x:Name="StatFree"     Classes="stat-value"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="stat-label" Text="BYTES TO COPY"/>
                            <TextBlock x:Name="StatBytes"    Classes="stat-value"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="stat-label" Text="REMAINING AFTER"/>
                            <TextBlock x:Name="StatRemaining" Classes="stat-value"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="5">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="stat-label" Text="ALREADY ASSIGNED"/>
                            <TextBlock x:Name="StatAssigned"  Classes="stat-value"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="stat-label" Text="ARCHIVE MISSING"/>
                            <TextBlock x:Name="StatMissing"   Classes="stat-value"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="stat-label" Text="TARGET COLLISION"/>
                            <TextBlock x:Name="StatCollision" Classes="stat-value"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Row 2: Table column headers -->
            <Border Grid.Row="2"
                    Padding="12,6,12,6"
                    Background="#141420"
                    BorderBrush="#242433" BorderThickness="0,1,0,1">
                <Grid ColumnDefinitions="100,90,*,80,2*">
                    <TextBlock Grid.Column="0" Classes="col-header" Text="ACTION"/>
                    <TextBlock Grid.Column="1" Classes="col-header" Text="RELEASE" Margin="8,0,0,0"/>
                    <TextBlock Grid.Column="2" Classes="col-header" Text="FILE"    Margin="8,0,0,0"/>
                    <TextBlock Grid.Column="3" Classes="col-header" Text="SIZE"    HorizontalAlignment="Right"/>
                    <TextBlock Grid.Column="4" Classes="col-header" Text="REASON"  Margin="8,0,0,0"/>
                </Grid>
            </Border>

            <!-- Row 3: Plan rows -->
            <Border Grid.Row="3"
                    Background="#1A1A24"
                    Margin="0,0,0,0"
                    MaxHeight="200">
                <ScrollViewer x:Name="PlanRowsScroll"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="PlanRowsList" Padding="0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:AppendPlanRow">
                                <Border Padding="12,3,12,3"
                                        BorderBrush="#0D0D13" BorderThickness="0,0,0,1">
                                    <Grid ColumnDefinitions="100,90,*,80,2*">
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Action}"
                                                   Classes="cell"
                                                   FontWeight="Bold"
                                                   Foreground="{Binding Action, Converter={StaticResource ActionColor}}"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Release}"
                                                   Classes="cell"
                                                   FontSize="10"
                                                   Foreground="#666677"
                                                   Margin="8,0,0,0"/>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding FileName}"
                                                   Classes="cell"
                                                   FontFamily="Consolas,Courier New,monospace"
                                                   FontSize="10"
                                                   Foreground="#888899"
                                                   Margin="8,0,0,0"/>
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding SizeLabel}"
                                                   Classes="cell"
                                                   HorizontalAlignment="Right"
                                                   Foreground="#666677"/>
                                        <TextBlock Grid.Column="4"
                                                   Text="{Binding Reason}"
                                                   Classes="cell"
                                                   FontSize="10"
                                                   Foreground="#777788"
                                                   Margin="8,0,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Row 4: Skip summary (shown when skips present) -->
            <Border x:Name="SkipSummaryPanel"
                    Grid.Row="4"
                    Background="#1A1420" CornerRadius="4" Padding="12,8"
                    Margin="0,4,0,0"
                    IsVisible="False">
                <TextBlock x:Name="SkipSummaryText"
                           FontSize="11"
                           Foreground="#AA8899"
                           TextWrapping="Wrap"/>
            </Border>

            <!-- Row 5: Plan hint -->
            <TextBlock Grid.Row="5"
                       x:Name="PlanHint"
                       FontSize="11"
                       Foreground="#555566"
                       TextWrapping="Wrap"
                       Margin="0,8,0,8"
                       Text="Building plan…"/>

            <!-- Row 6: Buttons -->
            <StackPanel Grid.Row="6"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8">
                <Button x:Name="ExecuteButton"
                        Classes="action-btn"
                        Content="Execute Append"
                        IsEnabled="False"
                        Click="OnExecute"/>
                <Button x:Name="PlanCancelButton"
                        Classes="close-btn"
                        Content="Cancel"
                        Click="OnCancel"/>
            </StackPanel>

        </Grid>

        <!-- ═══ PROGRESS VIEW ════════════════════════════════════════════════ -->
        <Grid x:Name="ProgressView"
              RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto"
              IsVisible="False">

            <!-- Row 0: Header -->
            <TextBlock Grid.Row="0"
                       x:Name="ProgressHeader"
                       FontSize="15" FontWeight="SemiBold"
                       Foreground="#E8E8F0"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12"/>

            <!-- Row 1: Progress bars -->
            <Border Grid.Row="1"
                    Background="#1A1A24" CornerRadius="6" Padding="16,14">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Grid.Column="0" Classes="bar-label" Text="COPIED"/>
                        <Border Grid.Column="1" x:Name="CopiedBarTrack"
                                Height="12" CornerRadius="2"
                                Background="#242433"
                                VerticalAlignment="Center" Margin="8,0">
                            <Border x:Name="CopiedBarFill"
                                    HorizontalAlignment="Left"
                                    Height="12" CornerRadius="2"
                                    Background="#81C784" Width="0"/>
                        </Border>
                        <TextBlock Grid.Column="2" Classes="bar-bytes" x:Name="CopiedBytesLabel" Text="—"/>
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Grid.Column="0" Classes="bar-label" Text="VERIFIED"/>
                        <Border Grid.Column="1" x:Name="VerifiedBarTrack"
                                Height="12" CornerRadius="2"
                                Background="#242433"
                                VerticalAlignment="Center" Margin="8,0">
                            <Border x:Name="VerifiedBarFill"
                                    HorizontalAlignment="Left"
                                    Height="12" CornerRadius="2"
                                    Background="#CE93D8" Width="0"/>
                        </Border>
                        <TextBlock Grid.Column="2" Classes="bar-bytes" x:Name="VerifiedBytesLabel" Text="—"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Row 2: Status line -->
            <TextBlock Grid.Row="2"
                       x:Name="ProgressStatusLine"
                       FontSize="11"
                       FontFamily="Consolas,Courier New,monospace"
                       Foreground="#666677"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,8,0,0"/>

            <!-- Row 3: Table column headers -->
            <Border Grid.Row="3"
                    Padding="12,6,12,6"
                    Margin="0,8,0,0"
                    Background="#141420"
                    BorderBrush="#242433" BorderThickness="0,1,0,1">
                <Grid ColumnDefinitions="130,*,80">
                    <TextBlock Grid.Column="0" Classes="col-header" Text="ACTION"/>
                    <TextBlock Grid.Column="1" Classes="col-header" Text="FILE"   Margin="8,0,0,0"/>
                    <TextBlock Grid.Column="2" Classes="col-header" Text="SIZE"   HorizontalAlignment="Right"/>
                </Grid>
            </Border>

            <!-- Row 4: Progress rows -->
            <Border Grid.Row="4"
                    Background="#1A1A24"
                    Margin="0,0,0,8">
                <ScrollViewer x:Name="ProgressRowsScroll"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ProgressRowsList" Padding="0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:AppendProgressRow">
                                <Border Padding="12,3,12,3"
                                        BorderBrush="#0D0D13" BorderThickness="0,0,0,1">
                                    <Grid ColumnDefinitions="130,*,80">
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Action}"
                                                   Classes="cell"
                                                   FontWeight="Bold"
                                                   Foreground="{Binding Action, Converter={StaticResource ActionColor}}"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding FileName}"
                                                   Classes="cell"
                                                   FontFamily="Consolas,Courier New,monospace"
                                                   FontSize="10"
                                                   Foreground="#888899"
                                                   Margin="8,0,0,0"/>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Detail}"
                                                   Classes="cell"
                                                   HorizontalAlignment="Right"
                                                   FontSize="10"
                                                   Foreground="#555566"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Row 5: Phase label -->
            <TextBlock Grid.Row="5"
                       x:Name="PhaseLabel"
                       FontSize="12"
                       Foreground="#666677"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8"/>

            <!-- Row 6: Close button -->
            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CloseButton"
                        Classes="action-btn"
                        Content="Close"
                        IsEnabled="False"
                        Click="OnClose"/>
            </StackPanel>

        </Grid>

    </Grid>
</Window>
