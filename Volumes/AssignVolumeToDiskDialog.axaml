<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Arkadia.AssignVolumeToDiskDialog"
        Title="Assign Volume to Disk"
        Width="380"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#0F0F14"
        FontFamily="Inter,Segoe UI,sans-serif">

    <Window.Styles>
        <Style Selector="ComboBox">
            <Setter Property="Background"   Value="#0D0D13"/>
            <Setter Property="Foreground"   Value="#E8E8F0"/>
            <Setter Property="BorderBrush"  Value="#2A2A3C"/>
            <Setter Property="FontSize"     Value="12"/>
            <Setter Property="Padding"      Value="8,7"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="TextBlock.field-label">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Foreground" Value="#888899"/>
            <Setter Property="Margin"     Value="0,0,0,4"/>
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background"   Value="#C05020"/>
            <Setter Property="Foreground"   Value="#FFFFFF"/>
            <Setter Property="Padding"      Value="16,8"/>
            <Setter Property="FontSize"     Value="13"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Cursor"       Value="Hand"/>
        </Style>
        <Style Selector="Button.secondary">
            <Setter Property="Background"   Value="#1E1E2C"/>
            <Setter Property="Foreground"   Value="#AAAACC"/>
            <Setter Property="Padding"      Value="16,8"/>
            <Setter Property="FontSize"     Value="13"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Cursor"       Value="Hand"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <Border Grid.Row="0" Padding="24,18,24,14"
                BorderBrush="#181826" BorderThickness="0,0,0,1">
            <StackPanel Spacing="4">
                <TextBlock Text="Assign Volume to Disk"
                           FontSize="16" FontWeight="SemiBold"
                           Foreground="#E8E8F0"/>
                <TextBlock x:Name="VolumeNameLabel"
                           FontSize="12"
                           Foreground="#888899"/>
            </StackPanel>
        </Border>

        <!-- Field -->
        <StackPanel Grid.Row="1" Margin="24,18,24,4" Spacing="12">

            <StackPanel Spacing="4">
                <TextBlock Classes="field-label" Text="SELECT DISK *"/>
                <ComboBox x:Name="DiskCombo"
                          HorizontalAlignment="Stretch"
                          SelectionChanged="OnDiskChanged"/>
            </StackPanel>

            <TextBlock x:Name="DiskInfoText"
                       FontSize="11"
                       Foreground="#888899"
                       IsVisible="False"/>

        </StackPanel>

        <!-- Footer -->
        <Border Grid.Row="2" Padding="24,14,24,18"
                BorderBrush="#181826" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Classes="secondary" Content="Cancel" Click="OnCancel"/>
                <Button x:Name="ConfirmButton" Classes="primary" Content="Assign"
                        IsEnabled="False" Click="OnConfirm"/>
            </StackPanel>
        </Border>

    </Grid>
</Window>
